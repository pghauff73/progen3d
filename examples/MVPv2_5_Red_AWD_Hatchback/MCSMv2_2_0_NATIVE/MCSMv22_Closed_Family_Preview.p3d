# MCSMv2.2 executable closed family preview.

Start ->
    MCSMv22ClosedFamilyPreview

MCSMv22ClosedFamilyPreview ->
[
    Object(id(MCSMV22_CLOSED_FAMILY) name(McsMv22ClosedFamily)
           class(ModernCarKinematicFamilyV22)
           taxonomy(Vehicle MCSMv2_2 RegisteredSurface SampledKinematics V3 Family)
           layer(Equipment) mask(Equipment Terrain Temporary))
    [
        [ T(-7.2 0 0) MCSMv22ReferenceFamilyClosed ]
        [ T(-2.4 0 0) MCSMv22TrackFamilyClosed ]
        [ T(2.4 0 0) MCSMv22AeroFamilyClosed ]
        [ T(7.2 0 0) MCSMv22CrossoverFamilyClosed ]
    ]
]

MCSMv22ReferenceFamilyClosed ->
[
    Object(id(MCSMV22_FAMILY_REFERENCE) name(ResearchMedianAWDHotHatch)
           class(ModernCarKinematicVariantV22)
           taxonomy(Vehicle MCSMv2_2 RegisteredSurface SampledKinematics V3)
           layer(Equipment) mask(Equipment Terrain Temporary))
    [
        Interface(id(packageCentre) type(InspectionInterface)
                  origin(0 0 0) normal(0 1 0) tangent(0 0 1)
                  region(Point) tolerance(0.001))
        MCSMv22ReferenceFamilyClosedComponentFixedBody
        MCSMv22ReferenceFamilyClosedComponentClosures
        MCSMv22ReferenceFamilyClosedComponentGlass
        MCSMv22ReferenceFamilyClosedComponentSuspension
        MCSMv22ReferenceFamilyClosedComponentTyres
    ]
]

MCSMv22ReferenceFamilyClosedComponentFixedBody ->
[
    !I(GeneratedMeshReference(
          meshKey(MCSMv22ReferenceFixedBodyMesh)
          detail(LOD2)
          topology(surface))
       material(redmetallicpaint) alpha(1) texscale(0.1))
]

MCSMv22ReferenceFamilyClosedComponentClosures ->
[
    !I(GeneratedMeshReference(
          meshKey(MCSMv22ReferenceClosuresClosedMesh)
          detail(LOD2)
          topology(surface))
       material(redmetallicpaint) alpha(1) texscale(0.1))
]

