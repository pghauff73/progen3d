# MCSMv2.2 executable closed-state preview.
# +X right, +Y up, +Z forward; origin is ground package centre.

Start ->
    MCSMv22CrossoverClosedPreview

MCSMv22CrossoverClosedPreview ->
[
    Object(id(MCSMV22_CROSSOVER_CLOSED) name(UrbanCrossoverEVAWD)
           class(ModernCarKinematicVariantV22)
           taxonomy(Vehicle MCSMv2_2 RegisteredSurface SampledKinematics V3)
           layer(Equipment) mask(Equipment Terrain Temporary))
    [
        Interface(id(packageCentre) type(InspectionInterface)
                  origin(0 0 0) normal(0 1 0) tangent(0 0 1)
                  region(Point) tolerance(0.001))
        MCSMv22CrossoverClosedPreviewComponentFixedBody
        MCSMv22CrossoverClosedPreviewComponentClosures
        MCSMv22CrossoverClosedPreviewComponentGlass
        MCSMv22CrossoverClosedPreviewComponentSuspension
        MCSMv22CrossoverClosedPreviewComponentTyres
    ]
]

MCSMv22CrossoverClosedPreviewComponentFixedBody ->
[
    !I(GeneratedMeshReference(
          meshKey(MCSMv22CrossoverFixedBodyMesh)
          detail(LOD2)
          topology(surface))
       material(redmetallicpaint) alpha(1) texscale(0.1))
]

MCSMv22CrossoverClosedPreviewComponentClosures ->
[
    !I(GeneratedMeshReference(
          meshKey(MCSMv22CrossoverClosuresClosedMesh)
          detail(LOD2)
          topology(surface))
       material(redmetallicpaint) alpha(1) texscale(0.1))
]

MCSMv22CrossoverClosedPreviewComponentGlass ->
[
    !I(GeneratedMeshReference(
          meshKey(MCSMv22CrossoverGlassClosedMesh)
          detail(LOD2)
          topology(surface))
       material(smokytransparentglass) alpha(0.56) texscale(0.1))
]

MCSMv22CrossoverClosedPreviewComponentSuspension ->
[
    !I(GeneratedMeshReference(
          meshKey(MCSMv22CrossoverSuspensionMesh)
          detail(LOD1)
          topology(surface))
       material(charcoalroughmetal) alpha(1) texscale(0.1))
]

MCSMv22CrossoverClosedPreviewComponentTyres ->
[
    !I(GeneratedMeshReference(
          meshKey(MCSMv22CrossoverNominalTyreMesh)
          detail(LOD1)
          topology(surface))
       material(charcoalroughrubber) alpha(1) texscale(0.1))
]
