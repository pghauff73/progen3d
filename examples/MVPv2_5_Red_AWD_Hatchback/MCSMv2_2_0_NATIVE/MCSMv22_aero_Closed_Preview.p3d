# MCSMv2.2 executable closed-state preview.
# +X right, +Y up, +Z forward; origin is ground package centre.

Start ->
    MCSMv22AeroClosedPreview

MCSMv22AeroClosedPreview ->
[
    Object(id(MCSMV22_AERO_CLOSED) name(AeroFastbackAWD)
           class(ModernCarKinematicVariantV22)
           taxonomy(Vehicle MCSMv2_2 RegisteredSurface SampledKinematics V3)
           layer(Equipment) mask(Equipment Terrain Temporary))
    [
        Interface(id(packageCentre) type(InspectionInterface)
                  origin(0 0 0) normal(0 1 0) tangent(0 0 1)
                  region(Point) tolerance(0.001))
        MCSMv22AeroClosedPreviewComponentFixedBody
        MCSMv22AeroClosedPreviewComponentClosures
        MCSMv22AeroClosedPreviewComponentGlass
        MCSMv22AeroClosedPreviewComponentSuspension
        MCSMv22AeroClosedPreviewComponentTyres
    ]
]

MCSMv22AeroClosedPreviewComponentFixedBody ->
[
    !I(GeneratedMeshReference(
          meshKey(MCSMv22AeroFixedBodyMesh)
          detail(LOD2)
          topology(surface))
       material(redmetallicpaint) alpha(1) texscale(0.1))
]

MCSMv22AeroClosedPreviewComponentClosures ->
[
    !I(GeneratedMeshReference(
          meshKey(MCSMv22AeroClosuresClosedMesh)
          detail(LOD2)
          topology(surface))
       material(redmetallicpaint) alpha(1) texscale(0.1))
]

MCSMv22AeroClosedPreviewComponentGlass ->
[
    !I(GeneratedMeshReference(
          meshKey(MCSMv22AeroGlassClosedMesh)
          detail(LOD2)
          topology(surface))
       material(smokytransparentglass) alpha(0.56) texscale(0.1))
]

MCSMv22AeroClosedPreviewComponentSuspension ->
[
    !I(GeneratedMeshReference(
          meshKey(MCSMv22AeroSuspensionMesh)
          detail(LOD1)
          topology(surface))
       material(charcoalroughmetal) alpha(1) texscale(0.1))
]

MCSMv22AeroClosedPreviewComponentTyres ->
[
    !I(GeneratedMeshReference(
          meshKey(MCSMv22AeroNominalTyreMesh)
          detail(LOD1)
          topology(surface))
       material(charcoalroughrubber) alpha(1) texscale(0.1))
]
