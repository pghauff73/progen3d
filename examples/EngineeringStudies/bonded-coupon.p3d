// Two 20 mm cubes share the plane x=0. The analytical cohesive interface is zero thickness.
Start ->
    Object(id(BondedCoupon) class(EngineeringAssembly) taxonomy(Engineering Coupon)) [
        Object(id(CouponLeft) class(EngineeringPart) taxonomy(Engineering Coupon Layer)) [
            T(-10 0 0) S(20 20 20) I(Cube material(plaster))
        ]
        Object(id(CouponRight) class(EngineeringPart) taxonomy(Engineering Coupon Layer)) [
            T(10 0 0) S(20 20 20) I(Cube material(plaster))
        ]
    ]
