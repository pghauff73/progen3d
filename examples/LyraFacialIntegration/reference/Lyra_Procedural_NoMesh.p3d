LyraSkinPhalanx(length radius) ->
    [ T(0 -length 0) S(2*radius length 2*radius) I(Cylinder(segments(14 1)) material(bluecyanfabric) 1 1) ]
    [ S(2*radius 2*radius 2*radius) I(Sphere(segments(14 8)) material(bluecyanfabric) 1 1) ]
    [ T(0 -length 0) S(2*radius 2*radius 2*radius) I(Sphere(segments(14 8)) material(bluecyanfabric) 1 1) ]

LyraFinger(a b c radius curl) ->
    A(-52*curl 0) LyraSkinPhalanx(a radius)
    [ T(0 -a 0) A(-65*curl 0) LyraSkinPhalanx(b radius*.86)
      [ T(0 -b 0) A(-36*curl 0) LyraSkinPhalanx(c radius*.72) ] ]

