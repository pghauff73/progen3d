# Select FloorMember or BookShelf in the Spatial Object Inspector.
# Dimensions are metres. Materials and service loads are example assumptions.
Start -> Object(id(Study) class(Assembly) taxonomy(Engineering Assembly)) [
    Floor(3.6 0.10 0.15 0.005)
    [ T(0 0.52 0) Shelf(0.8 0.30 0.018 20) ]
]

Floor(span breadth depth wall) ->
    Object(id(FloorMember) class(StructuralMember) taxonomy(Building StructuralMember)) [
        PinRollerMember(supports(LeftSeat RightSeat) metresPerUnit(1)
            material(StructuralSteel 200000000000 7850) section(breadth depth wall)
            load(2000*0.6 0 0))
        Seats(span breadth 0.075)
        [ S(span wall breadth) Steel ]
        [ T(0 depth-wall 0) S(span wall breadth) Steel ]
        [ T(0 wall breadth/2-wall/2) S(span depth-2*wall wall) Steel ]
        [ T(0 wall wall/2-breadth/2) S(span depth-2*wall wall) Steel ]
    ]

Shelf(span breadth depth booksKg) ->
    Object(id(BookShelf) class(FurniturePanel) taxonomy(Furniture Shelf)) [
        PinRollerMember(supports(LeftSeat RightSeat) metresPerUnit(1)
            material(AssumedPanel 6000000000 650) section(breadth depth 0)
            load(0 booksKg 0))
        Seats(span breadth 0.02)
        [ S(span depth breadth) I(Cube material(amberwarmwood) 1 0.5) ]
    ]

Seats(span breadth seatLength) ->
    Interface(id(LeftSeat) type(Seat) origin(-span/2 0 0) normal(0 1 0)
              tangent(1 0 0) region(PlaneRectangle seatLength breadth))
    Interface(id(RightSeat) type(Seat) origin(span/2 0 0) normal(0 1 0)
              tangent(1 0 0) region(PlaneRectangle seatLength breadth))
    [ T(-span/2 -0.035 0) S(seatLength 0.035 breadth) Steel ]
    [ T(span/2 -0.035 0) S(seatLength 0.035 breadth) Steel ]

Steel -> I(Cube material(steelshinyroughmetal) 1 0.5)
