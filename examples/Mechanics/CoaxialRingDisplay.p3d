# Nested LED ring display reconstructed from one photograph.
# One scene unit is 100 mm. The hidden drives, masses and inertial radii are assumptions.
# Set animation time t in seconds and select OuterRing, MiddleRing or InnerRing.
# Each 74 s loop has 2 s of acceleration, 70 s of cruise and 2 s of braking.
Start -> RingCycle(74*cycle(t,74) 15 -35 50)

RingCycle(p outerRate middleRate innerRate) ->
    RingRamp(p clamp(p,0,2) clamp(p-72,0,2) outerRate middleRate innerRate)

RingRamp(p up down outerRate middleRate innerRate) ->
    Display((72*floor(t/74)+up*up/4+clamp(p-2,0,70)+down-down*down/4) (up-down)/2 (1-min(1,floor(p/2))-min(1,floor(p/72)))/2 outerRate middleRate innerRate)

Display(travel speed accel outerRate middleRate innerRate) ->
    T(0 15.40 0)
    Object(id(Pedestal) class(FixedFrame) taxonomy(Device Display)) [
        BaseBody
        [ A(9+outerRate*travel 1)
          Object(id(OuterRing) class(Rotor) taxonomy(Device Display Ring)) [
              RingDrive(16 0.82 outerRate*speed outerRate*accel 0.15)
              OuterBody
              [ A(-79+middleRate*travel 1)
                Object(id(MiddleRing) class(Rotor) taxonomy(Device Display Ring)) [
                    RingDrive(10 0.62 middleRate*speed middleRate*accel 0.10)
                    MiddleBody
                    [ A(112+innerRate*travel 1)
                      Object(id(InnerRing) class(Rotor) taxonomy(Device Display Ring)) [
                          RingDrive(5 0.42 innerRate*speed innerRate*accel 0.05)
                          InnerBody
                      ] ]
                ] ]
          ] ]
    ]

RingDrive(mass radius rate acceleration drag) ->
    CoaxialDrive(hoop(mass radius) motion(rate acceleration)
        transmission(20 0.85 0.80) motor(0.0005 drag))

BaseBody -> Pedestal JOneHousing JOneStator JOneTransferBody JOneBrushes

OuterBody -> OuterFrame JOneRotor JOneContacts JTwoHousing JTwoStator JTwoTransferBody JTwoBrushes

MiddleBody -> MiddleFrame JTwoRotor JTwoContacts JThreeHousing JThreeStator JThreeTransferBody JThreeBrushes

InnerBody -> InnerFrame JThreeRotor JThreeContacts

DeckFeet(n) n ->
    [ A(DeckFeet_count*360/n 1) T(0 -15.40 4.58) S(0.82 0.23 0.82) DarkCylinder ]

