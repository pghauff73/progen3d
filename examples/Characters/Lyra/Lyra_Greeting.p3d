# Change Speed to adjust playback. Compare t=0 with t=1 and t=3.
Start -> Speed(1)

Speed(rate) -> Clock(t*rate*1.5707963268)
Clock(p) -> Animate(cos(1*p) sin(1*p) cos(2*p) sin(2*p) cos(3*p) sin(3*p))

