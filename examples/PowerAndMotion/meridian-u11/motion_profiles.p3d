# Generated by motion_model.py. Length m, time s, angles radians before geometry.
# Parent-relative +Z is the common shaft axis. External spur reverses; open belt preserves.
# Continuous 60 degree command by 2 s, hold to 3 s, return by 5 s.
# Two opposed screw leads close the 60 mm total jaw gap, with compliant guides.
# Reduced-order inertia, losses, and elastic winding are evaluated at native grammar t.

U11DriveMotion ->
    U11MotionWindows(
        (clamp((t-0)/2,0,1))
        (clamp((t-3)/2,0,1))
        (clamp((t-0.5)/1.75,0,1))
        (clamp((t-3.25)/1.75,0,1))
    )

U11MotionWindows(u v a b) ->
    U11MotionStates(
        ((1.047197551196598)*(u^5*(126+u*(-420+u*(540+u*(-315+70*u))))-(v^5*(126+v*(-420+v*(540+v*(-315+70*v)))))))
        ((0.523598775598299)*(630*(u*(1-u))^4-(630*(v*(1-v))^4)))
        ((0.261799387799149)*(2520*(u*(1-u))^3*(1-2*u)-(2520*(v*(1-v))^3*(1-2*v))))
        ((0.130899693899575)*(2520*(3*(u*(1-u))^2*(1-2*u)^2-2*(u*(1-u))^3)-(2520*(3*(v*(1-v))^2*(1-2*v)^2-2*(v*(1-v))^3))))
        ((0.065449846949787)*(2520*(6*(u*(1-u))*(1-2*u)^3-18*(u*(1-u))^2*(1-2*u))-(2520*(6*(v*(1-v))*(1-2*v)^3-18*(v*(1-v))^2*(1-2*v)))))
        ((0.03)*(a^5*(126+a*(-420+a*(540+a*(-315+70*a))))-(b^5*(126+b*(-420+b*(540+b*(-315+70*b)))))))
        ((0.017142857142857)*(630*(a*(1-a))^4-(630*(b*(1-b))^4)))
        ((0.009795918367347)*(2520*(a*(1-a))^3*(1-2*a)-(2520*(b*(1-b))^3*(1-2*b))))
    )

U11MotionStates(q omega alpha jerk snap x xd xdd) ->
    U11MotionEfforts(
        (q)
        (omega)
        (x)
        (xd)
        (xdd)
        (0.84849*alpha+0.22*omega+0.8*q)
        (0.84849*jerk+0.22*alpha+0.8*omega)
        (0.84849*snap+0.22*jerk+0.8*alpha)
        (alpha)
        (0.003819718634205*(1.2*xdd+14*xd+450*x))
    )

U11MotionEfforts(q omega x xd xdd torqueOut torqueRate torqueAccel alpha jawLoadTorque) ->
    U11MotionShafts(
        (q)
        (x)
        (torqueOut)
        (0.031830988618379*q+0.0001308996939*torqueOut)
        ((0.031830988618379*omega+0.0001308996939*torqueRate)/0.01591549430919)
        ((0.031830988618379*alpha+0.0001308996939*torqueAccel)/0.01591549430919)
        (xd/0.001909859317103)
        (xdd/0.001909859317103)
        (jawLoadTorque)
        ((torqueOut+(0.051315789473684)*abs(torqueOut)*(omega/sqrt(omega^2+(0.0004)))+(0.001315789473684)*torqueOut*(omega/sqrt(omega^2+(0.0004)))^2)/(2))
    )

U11MotionShafts(q x torqueOut travel laySpeed layAcceleration screwSpeed screwAcceleration jawLoadTorque beltLoad) ->
    U11MotionCurrent(
        (q)
        (x)
        (torqueOut)
        (travel)
        (laySpeed)
        (layAcceleration)
        (screwSpeed)
        (screwAcceleration)
        (jawLoadTorque)
        (0.0014*layAcceleration+beltLoad)
    )

U11MotionCurrent(q x torqueOut travel laySpeed layAcceleration screwSpeed screwAcceleration jawLoadTorque gearLoad) ->
    U11DriveGeometry(
        (degrees(0-3*travel/0.01591549430919))
        (degrees(travel/0.01591549430919))
        (degrees(q))
        (degrees(x/0.001909859317103))
        (x)
        (travel)
        (abs(0.0001308996939*torqueOut))
        ((0-0.0006*layAcceleration-0.0015*laySpeed-(gearLoad+(0.040833333333333)*abs(gearLoad)*(laySpeed/sqrt(laySpeed^2+(0.0004)))+(0.000833333333333)*gearLoad*(laySpeed/sqrt(laySpeed^2+(0.0004)))^2)/(3))/0.27)
        ((0.00026*screwAcceleration+0.0005*screwSpeed+(jawLoadTorque+(0.105555555555556)*abs(jawLoadTorque)*(screwSpeed/sqrt(screwSpeed^2+(0.0004)))+(0.005555555555556)*jawLoadTorque*(screwSpeed/sqrt(screwSpeed^2+(0.0004)))^2)/(1))/0.156)
    )
