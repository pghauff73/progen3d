# ================================================================
# COMPLEX MODERN COURTYARD BUILDING — OM20 / SMB-OMv2
# Executable spatial objects with a 20-level taxonomy.
#
# Taxonomy:
#   L0  Building instance
#   L1  System
#   L2  Assembly
#   L3  Component
#   L4  Feature / interface
#   L5  Functional leaf object
#   L6  Part family
#   L7  Part assembly
#   L8  Subassembly
#   L9  Element
#   L10 Subelement
#   L11 Detailed feature
#   L12 Interface
#   L13 Layer / region
#   L14 Material or information system
#   L15 Constituent or data field
#   L16 Geometry or logic primitive
#   L17 Connection or boundary detail
#   L18 State or control point
#   L19 Evidence or inspection point
#   L20 Atomic rendered region or semantic assertion
#
# Every L0-L5 taxonomy node is an executable Object scope. L5 geometry is
# localized under its object frame and remains implemented at L20. Kitchen
# cabinetry and the outdoor heat pump are resolved by deterministic P0 Drop
# constraints. The left front window is a procedural OMv2 assembly of double
# glazing, seals, chamfered frame members, flashings, and anchors. Existing
# structural and envelope helpers retain their proven CubeY placement model.
# ================================================================

Start ->
    OM20_Building_001()

# L0 building object
OM20_Building_001() ->
[
    Object(
        id(OM20_Building_001)
        class(ComplexModernCourtyardBuilding)
        taxonomy(ComplexModernCourtyardBuilding)
        layer(Temporary)
        mask(Structure Envelope Interior Furniture Plumbing Hvac Electrical Equipment Terrain Temporary)
    )
    [
        OM20_L1_SiteSystem()
            OM20_L1_StructuralSystem()
            OM20_L1_EnvelopeSystem()
            OM20_L1_OpeningSystem()
            OM20_L1_InteriorSystem()
            OM20_L1_RoofSystem()
            OM20_L1_ServicesSystem()
            OM20_L1_ExternalAmenitySystem()
            OM20_L1_RelationshipSystem()

        # ================================================================
        # L1 SYSTEM: SiteSystem
        # ================================================================
    ]
]

OM20_L1_SiteSystem() ->
[
    Object(
        id(OM20_L1_SiteSystem)
        class(SiteSystem)
        taxonomy(ComplexModernCourtyardBuilding SiteSystem)
        container(OM20_Building_001)
        layer(Terrain)
        mask(Structure Envelope Interior Furniture Plumbing Hvac Electrical Equipment Terrain Temporary)
    )
    [
        OM20_L2_SiteSystem_GroundAssembly()
            OM20_L2_SiteSystem_LandscapeAssembly()
            OM20_L2_SiteSystem_BoundaryAssembly()

        # L2 Assembly: SiteSystem / GroundAssembly
    ]
]

OM20_L2_SiteSystem_GroundAssembly() ->
[
    Object(
        id(OM20_L2_SiteSystem_GroundAssembly)
        class(GroundAssembly)
        taxonomy(ComplexModernCourtyardBuilding SiteSystem GroundAssembly)
        container(OM20_L1_SiteSystem)
        layer(Terrain)
        mask(Structure Envelope Interior Furniture Plumbing Hvac Electrical Equipment Terrain Temporary)
    )
    [
        OM20_L3_SiteSystem_GroundAssembly_SiteGroundComponent()
            OM20_L3_SiteSystem_GroundAssembly_EntryWalkComponent()
            OM20_L3_SiteSystem_GroundAssembly_DrivewayComponent()
            OM20_L3_SiteSystem_GroundAssembly_ServicePadComponent()
            OM20_L3_SiteSystem_GroundAssembly_RearTerraceComponent()

        # L3 Component: SiteGroundComponent
    ]
]

OM20_L3_SiteSystem_GroundAssembly_SiteGroundComponent() ->
[
    Object(
        id(OM20_L3_SiteSystem_GroundAssembly_SiteGroundComponent)
        class(SiteGroundComponent)
        taxonomy(ComplexModernCourtyardBuilding SiteSystem GroundAssembly SiteGroundComponent)
        container(OM20_L2_SiteSystem_GroundAssembly)
        layer(Terrain)
        mask(Structure Envelope Interior Furniture Plumbing Hvac Electrical Equipment Terrain Temporary)
    )
    [
        OM20_L4_SiteSystem_GroundAssembly_SiteGroundComponent_GroundSurfaceFeature()

        # L4 Feature / interface: GroundSurfaceFeature
    ]
]

OM20_L4_SiteSystem_GroundAssembly_SiteGroundComponent_GroundSurfaceFeature() ->
[
    Object(
        id(OM20_L4_SiteSystem_GroundAssembly_SiteGroundComponent_GroundSurfaceFeature)
        class(GroundSurfaceFeature)
        taxonomy(ComplexModernCourtyardBuilding SiteSystem GroundAssembly SiteGroundComponent GroundSurfaceFeature)
        container(OM20_L3_SiteSystem_GroundAssembly_SiteGroundComponent)
        layer(Terrain)
        mask(Structure Envelope Interior Furniture Plumbing Hvac Electrical Equipment Terrain Temporary)
    )
    [
        OM20_L5_SiteSystem_GroundAssembly_SiteGroundComponent_GroundSurfaceFeature_GroundPlaneLeaf()

        # L5 Leaf: GroundPlaneLeaf
    ]
]

OM20_L5_SiteSystem_GroundAssembly_SiteGroundComponent_GroundSurfaceFeature_GroundPlaneLeaf() ->
[
    T(0 -0.28 0)
    Object(
        id(OM20_L5_SiteSystem_GroundAssembly_SiteGroundComponent_GroundSurfaceFeature_GroundPlaneLeaf)
        class(GroundPlaneLeaf)
        taxonomy(ComplexModernCourtyardBuilding SiteSystem GroundAssembly SiteGroundComponent GroundSurfaceFeature GroundPlaneLeaf)
        container(OM20_L4_SiteSystem_GroundAssembly_SiteGroundComponent_GroundSurfaceFeature)
        layer(Terrain)
        mask(Structure Envelope Interior Furniture Plumbing Hvac Electrical Equipment Terrain Temporary)
    )
    [
        Interface(
            id(inspection_point)
            type(InspectionInterface)
            origin(0 0 0)
            normal(0 1 0)
            tangent(1 0 0)
            region(Point)
            tolerance(0.001)
        )
            OM20_T0001_L06_SiteWorkPartFamily()

        # OM20 extension for T0001: GroundPlaneLeaf
        # Template: SITE_SURFACE
        # L06 PartFamily: SiteWorkPartFamily
    ]
]

OM20_T0001_L06_SiteWorkPartFamily() ->
    OM20_T0001_L07_SurfaceConstructionAssembly()

# L07 PartAssembly: SurfaceConstructionAssembly
OM20_T0001_L07_SurfaceConstructionAssembly() ->
    OM20_T0001_L08_PavementSubassembly()

# L08 Subassembly: PavementSubassembly
OM20_T0001_L08_PavementSubassembly() ->
