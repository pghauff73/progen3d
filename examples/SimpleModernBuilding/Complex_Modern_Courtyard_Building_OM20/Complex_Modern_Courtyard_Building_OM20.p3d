# ================================================================
# OMV2 PROCEDURAL HOSTED WINDOW — LEFT FRONT FACADE VERTICAL SLICE
# ================================================================

GEO_WindowGlassPane(x y z sx sy sz) ->
[
    T(x y z)
    T(0 sy/2 -sz/2)
    !I(Extrude(Rect(sx sy) sz cap(all)) material(bluewhiteglossysmoothglass) 0.68 0.24)
]

GEO_WindowSeal(x y z sx sy sz) ->
[
    T(x y z)
    T(0 sy/2 -sz/2)
    !I(Extrude(Rect(sx sy) sz cap(all)) material(charcoalroughmetal) 1 0.12)
]

GEO_WindowMetalDetail(x y z sx sy sz) ->
[
    T(x y z)
    T(0 sy/2 -sz/2)
    !I(Extrude(Rect(sx sy) sz cap(all)) material(lightgreyroughmetal) 1 0.16)
]

GEO_WindowFrameMember(x y z sx sy sz) ->
[
    T(x y z)
    T(0 sy/2 -sz/2)
    !I(Extrude(ChamferRect(sx sy 0.01) sz cap(all)) material(silverbluepolishedmetal) 1 0.20)
]

GEO_DoubleGlazingUnit(x y z sx sy sz) ->
[
    T(x y z)
    GEO_WindowGlassPane(0 0 0.026 sx sy 0.012)
    GEO_WindowGlassPane(0 0 -0.026 sx sy 0.012)
    GEO_WindowSeal(-sx/2+0.012 0.015 0 0.024 sy-0.03 0.04)
    GEO_WindowSeal(sx/2-0.012 0.015 0 0.024 sy-0.03 0.04)
    GEO_WindowSeal(0 0 0 sx 0.03 0.04)
    GEO_WindowSeal(0 sy-0.03 0 sx 0.03 0.04)
]

GEO_WindowAnchoredJamb(x y z sx sy sz) ->
[
    T(x y z)
    GEO_WindowFrameMember(0 0 0 sx sy sz)
    GEO_WindowMetalDetail(0 0.28 0.055 0.16 0.035 0.03)
    GEO_WindowMetalDetail(0 0.76 0.055 0.16 0.035 0.03)
    GEO_WindowMetalDetail(0 1.24 0.055 0.16 0.035 0.03)
]

GEO_WindowSillAssembly(x y z sx sy sz) ->
[
    T(x y z)
    GEO_WindowFrameMember(0 0 0 sx sy sz)
    GEO_WindowMetalDetail(0 -0.025 0.055 sx+0.16 0.025 0.20)
]

GEO_WindowHeadAssembly(x y z sx sy sz) ->
[
    T(x y z)
    GEO_WindowFrameMember(0 0 0 sx sy sz)
    GEO_WindowMetalDetail(0 sy 0.055 sx+0.16 0.025 0.20)
]

GEO_WindowMullionAssembly(x y z sx sy sz) ->
[
    T(x y z)
    GEO_WindowFrameMember(0 0 0 sx sy sz)
    GEO_WindowSeal(-0.036 0 0.015 0.012 sy 0.03)
    GEO_WindowSeal(0.036 0 0.015 0.012 sy 0.03)
]
