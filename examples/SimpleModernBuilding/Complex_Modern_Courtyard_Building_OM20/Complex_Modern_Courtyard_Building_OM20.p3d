# L17 ConnectionOrBoundaryDetail: DrainageBoundaryDetail
OM20_T0001_L17_DrainageBoundaryDetail() ->
    OM20_T0001_L18_SurfaceConditionPoint()

# L18 StateOrControlPoint: SurfaceConditionPoint
OM20_T0001_L18_SurfaceConditionPoint() ->
    OM20_T0001_L19_SiteInspectionPoint()

# L19 EvidenceOrInspectionPoint: SiteInspectionPoint
OM20_T0001_L19_SiteInspectionPoint() ->
    OM20_T0001_L20_AtomicSiteSurfaceRegion()

# L20 AtomicRegionOrAssertion: AtomicSiteSurfaceRegion
OM20_T0001_L20_AtomicSiteSurfaceRegion() ->

    GEO_Concrete(0 0 0 34 0.28 28)

