# ================================================================
# GEOMETRY BACK END — implementation helpers, not taxonomy nodes
# ================================================================

OM5_SemanticLeaf() ->
    T(0 0 0)

GEO_Concrete(x y z sx sy sz) ->
[
    T(x y z)
    S(sx sy sz)
    !I(CubeY material(lightgreyroughconcrete) 1 0.40)
]

GEO_Wall(x y z sx sy sz) ->
[
    T(x y z)
    S(sx sy sz)
    !I(CubeY material(warmwhitematteplaster) 1 0.34)
]

