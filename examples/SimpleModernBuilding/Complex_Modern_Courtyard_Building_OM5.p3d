# ================================================================
# COMPLEX MODERN COURTYARD BUILDING — OM5 OBJECT MODEL EXAMPLE
# Current Progen3D grammar syntax
#
# Taxonomy depth:
#   L0 Building object
#   L1 System
#   L2 Assembly
#   L3 Component
#   L4 Feature / interface
#   L5 Atomic geometry or semantic evidence leaf
#
# Plan:
#   U-shaped single-floor building around a landscaped courtyard.
#   Three structural wings, multiple wall-opening systems, furnished
#   interior zones, roof daylighting/PV, services, and relationship
#   records for containment, connections, collision positioning,
#   clearance checks, and validation.
#
# Current-language limitation:
#   Progen3D does not yet expose native object/interface/CP statements.
#   Relationship and collision-positioning objects therefore terminate
#   in OM5_SemanticLeaf(); geometric coordinates represent resolved poses.
# ================================================================

Start ->
    OM5_Building_001()

# L0 building object
OM5_Building_001() ->
    OM5_L1_SiteSystem()
    OM5_L1_StructuralSystem()
    OM5_L1_EnvelopeSystem()
    OM5_L1_OpeningSystem()
    OM5_L1_InteriorSystem()
    OM5_L1_RoofSystem()
    OM5_L1_ServicesSystem()
    OM5_L1_ExternalAmenitySystem()
    OM5_L1_RelationshipSystem()

# ================================================================
# L1 SYSTEM: SiteSystem
