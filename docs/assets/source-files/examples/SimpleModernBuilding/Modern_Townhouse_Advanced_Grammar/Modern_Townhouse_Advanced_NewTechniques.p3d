InteriorTree(x z scale) ->
[
    Object(InteriorTreeInstance class(Plant))
    T(x 0.22 z)
    BranchGraph(
        trunk(
            TaperedSweep(
                path(Bezier3((0 0 0) (0.05 0.60 0) (-0.03 1.25 0.02) (0 1.75 0)))
                radiusStart(0.055)
                radiusEnd(0.018)
                radialSegments(10)
                material(amberwarmwood)
            )
        )
        branches(
            LSystem(
                axiom(A)
                rule(A -> F[+A][-A]FA)
                iterations(3)
                angle(28)
                segmentLength(0.28)
            )
        )
        leaves(
            LeafBlade(profile(Elliptic) length(0.085) width(0.034) camber(0.004))
            OrganArray(density(14) phyllotaxis(Alternate divergence(137.5)))
        )
    )
]


