# ============================================================================
# MODERN TOWNHOUSE — ADVANCED PROGEN3D REFERENCE GRAMMAR
# RBGv1 + ARBv1 + Vegetation Grammar + MVGv1 concepts
#
# IMPORTANT:
# This file intentionally uses the PROPOSED higher-order operators discussed
# in the design work. It is NOT executable by the current Progen3D parser yet.
#
# Required future operators include:
#   Profile2D, ExtrudeProfile, ExtrudeProfileWithVoids, SweepProfile,
#   SweepDisk, Revolve, SurfaceLoft, ShellLoft, LayerSet, HostedOpening,
#   CurvedPanel, FoldedProfile, SurfaceTiling, PanelBox, PanelArray,
#   InstanceArray, BranchGraph, TaperedSweep, LeafBlade, Phyllotaxis,
#   SpaceColonization, VinePath, SurfaceAttachment, VehiclePackage,
#   BodySection, GuideCurve, PanelCut, RadialArray, Joint.
#
# SOURCE BASIS
# ------------
# Supplied/generated townhouse views show:
#   - front facade with white render and charcoal slatted/cladding zones
#   - black sectional garage door
#   - recessed timber entry
#   - front lawn, driveway, road, footpath, letterbox and planted borders
#   - rear garden with large glazed opening and small terrace
#   - side/rear elevations with white walls, black fencing and windows
#   - open-plan living
#   - kitchen + dining
#   - master bedroom
#   - bathroom
#
# Inferred for coherence:
#   - exact floor plan
#   - hidden laundry/powder/stair/service areas
#   - upper-floor bedroom arrangement
#   - exact structure and services
#
# Coordinate convention:
#   +X = right
#   +Y = up
#   +Z = rear
#   front facade = Z -7.50
#   rear facade  = Z +7.50
# ============================================================================


Start ->
    ModernTownhouse()


ModernTownhouse() ->
    TownhouseProgram()
    TownhouseStyle()
    TownhouseDatums()
    SiteAndStreet()
    SpatialProgram()
    StructuralSystem()
    EnvelopeSystem()
    OpeningSystem()
    GroundFloorInterior()
    UpperFloorInterior()
    VerticalCirculation()
    ElectricalAndLighting()
    PlumbingAndWetAreas()
    GarageSystem()
    LandscapeSystem()
    VehicleSystem()
    SpatialRelationships()
    ValidationModel()


# ============================================================================
# 1. PROGRAM / CONTROL GRAMMAR
# ============================================================================

TownhouseProgram() ->
    Program(
        buildingType(ModernTownhouse)
        storeys(2)
        bedrooms(3)
        bathrooms(2.5)
        garageSpaces(1)
        occupants(4)
        targetInternalArea(178)
        targetSiteWidth(11.5)
        targetSiteDepth(30.0)
    )


TownhouseStyle() ->
    StyleState(
        family(MinimalContemporary)
        primaryMaterial(WarmWhiteRender)
        secondaryMaterial(CharcoalVerticalCladding)
        tertiaryMaterial(WarmOakTimber)
        metal(CharcoalPowderCoat)
        glazing(ClearLowIron)
        roof(FlatParapet)
        facadeRhythm(Vertical)
        openingRatioFront(0.29)
        openingRatioRear(0.48)
        detailDensity(MediumHigh)
        edgeLanguage(SharpRectilinear)
        landscapeStyle(MinimalLush)
    )


TownhouseDatums() ->
    Datum(GroundPlane Y 0.00)
    Datum(GroundFloorFFL Y 0.20)
    Datum(UpperFloorFFL Y 3.25)
    Datum(RoofSlab Y 6.30)
    Datum(ParapetTop Y 6.80)

    Datum(FrontFacade Z -7.50)
    Datum(RearFacade Z 7.50)

    Datum(GridX_Left X -4.15)
    Datum(GridX_Centre X 0.00)
    Datum(GridX_Right X 4.15)

    Datum(GarageCentre X -2.45)
    Datum(EntryCentre X 0.55)
    Datum(LivingWindowCentre X 2.35)

    Datum(WindowSillGround Y 0.85)
    Datum(WindowHeadGround Y 2.75)
    Datum(WindowSillUpper Y 3.95)
    Datum(WindowHeadUpper Y 5.80)


# ============================================================================
# 2. SITE + STREET
# ============================================================================

SiteAndStreet() ->
    Road()
    KerbAndGutter()
    Footpath()
    Driveway()
    FrontPath()
    FrontLawn()
    SideAccess()
    BoundaryFences()
    Letterbox()
    StreetPlanting()


Road() ->
[
    Object(RoadSurface class(SiteSurface))
    T(0 -0.10 -12.80)
    SurfaceTiling(
        boundary(Rect(18.0 7.2))
        baseThickness(0.18)
        material(darkasphalt)
        pattern(Continuous)
    )
]


KerbAndGutter() ->
[
    Object(FrontKerb class(SiteEdge))
    SweepProfile(
        profile(KerbAndGutterProfile)
        path(Line3(-8.8 -0.02 -9.45, 8.8 -0.02 -9.45))
        material(lightgreyroughconcrete)
    )
]


KerbAndGutterProfile() ->
    Profile2D(
        polygon(
            0.00 0.00
            0.45 0.00
            0.45 0.14
            0.27 0.14
            0.18 0.28
            0.00 0.28
        )
    )


Footpath() ->
[
    Object(FrontFootpath class(SiteSurface))
    T(0 0.02 -9.00)
    SurfaceTiling(
        boundary(Rect(11.2 1.25))
        tile(Rect(1.20 1.20))
        joint(0.012 0.008)
        pattern(StackBond)
        material(lightgreyroughconcrete)
    )
]


Driveway() ->
[
    Object(DrivewaySlab class(SiteSurface))
    T(-2.45 0.04 -8.35)
    SurfaceTiling(
        boundary(Rect(4.25 2.95))
        tile(Rect(1.35 1.35))
        joint(0.012 0.008)
        border(0.12)
        slopeTo(FrontKerb 0.025)
        material(lightgreyroughconcrete)
    )
]


FrontPath() ->
[
    Object(EntryPath class(SiteSurface))
    T(0.55 0.05 -8.35)
    SurfaceTiling(
        boundary(Rect(1.25 3.00))
        tile(Rect(0.60 0.60))
        joint(0.010 0.006)
        pattern(StackBond)
        material(offwhiteceramic)
    )
]


FrontLawn() ->
[
    Object(FrontLawn class(LandscapeSurface))
    T(2.80 0.05 -8.15)
    HeightField(
        boundary(Rect(3.70 2.65))
        nominalHeight(0.05)
        variation(0.012)
        material(grass)
    )
]


SideAccess() ->
[
    Object(SideAccessPath class(SiteSurface))
    T(-5.05 0.05 0.25)
    SurfaceTiling(
        boundary(Rect(1.05 13.4))
        tile(Rect(0.50 0.50))
        joint(0.010 0.006)
        material(lightgreyroughconcrete)
    )
]


BoundaryFences() ->
    FrontFence()
    LeftFence()
    RightFence()
    RearFence()


FrontFence() ->
[
    Object(FrontFence class(FenceAssembly))
    RepeatExtrusion(
        profile(RectProfile(0.045 0.070))
        along(Line3(-5.20 0.08 -9.55, 5.20 0.08 -9.55))
        count(74)
        height(1.35)
        material(charcoalroughmetal)
    )
]


LeftFence() ->
[
    Object(LeftFence class(FenceAssembly))
    RepeatExtrusion(
        profile(RectProfile(0.045 0.070))
        along(Line3(-5.45 0.08 -7.6, -5.45 0.08 8.9))
        count(100)
        height(1.65)
        material(charcoalroughmetal)
    )
]


RightFence() ->
[
    Object(RightFence class(FenceAssembly))
    RepeatExtrusion(
        profile(RectProfile(0.045 0.070))
        along(Line3(5.45 0.08 -7.6, 5.45 0.08 8.9))
        count(100)
        height(1.65)
        material(charcoalroughmetal)
    )
]


RearFence() ->
[
    Object(RearFence class(FenceAssembly))
    RepeatExtrusion(
        profile(RectProfile(0.045 0.070))
        along(Line3(-5.45 0.08 9.0, 5.45 0.08 9.0))
        count(68)
        height(1.75)
        material(charcoalroughmetal)
    )
]


Letterbox() ->
[
    Object(FrontLetterbox class(SiteFixture))
    T(2.45 0.08 -9.15)
    PanelBox(
        width(0.62)
        height(1.02)
        depth(0.34)
        panelThickness(0.025)
        material(charcoalroughmetal)
        frontOpening(MailSlot 0.34 0.05 at(0 0.70))
        rearDoor(0.48 0.58)
    )
]
[
    Object(MailSlotLiner class(Detail))
    T(2.45 0.78 -9.34)
    ExtrudeProfile(
        profile(RoundedRect(0.34 0.05 0.012))
        depth(0.055)
        material(charcoalroughmetal)
    )
]


StreetPlanting() ->
    StreetTree(-6.5 -9.75)
    StreetTree(6.9 -9.75)


StreetTree(x z) ->
[
    Object(StreetTreeInstance class(Tree))
    T(x 0 z)
    BranchGraph(
        trunk(
            TaperedSweep(
                path(Bezier3((0 0 0) (0.05 1.8 0) (-0.05 3.4 0) (0 4.4 0)))
                radiusStart(0.20)
                radiusEnd(0.085)
                radialSegments(12)
                material(amberwarmwood)
            )
        )
        crown(
            SpaceColonization(
                volume(Ellipsoid(2.4 2.1 2.4 centre(0 4.0 0)))
                attractionPoints(850)
                influenceRadius(0.90)
                killRadius(0.24)
                step(0.28)
                branchTaper(0.65)
            )
        )
        leaves(
            LeafBlade(
                profile(Elliptic)
                length(0.10)
                width(0.042)
                camber(0.006)
                material(greenmattepaint)
            )
            OrganArray(
                attachment(terminalBranches)
                density(18)
                phyllotaxis(Alternate divergence(137.5))
                scaleVariation(0.85 1.12)
            )
        )
    )
]


# ============================================================================
# 3. SPATIAL PROGRAM
# ============================================================================

SpatialProgram() ->
    GroundFloorSpaces()
    UpperFloorSpaces()
    SpaceRelations()


GroundFloorSpaces() ->
    Space(Garage        rect(-4.20 -7.10 3.45 6.35))
    Space(Entry         rect(-0.45 -7.10 1.80 3.30))
    Space(PowderRoom    rect(-0.45 -3.65 1.80 1.65))
    Space(Laundry       rect(-4.20 -0.55 2.00 2.20))
    Space(StairHall     rect(-2.05 -3.60 2.30 5.45))
    Space(Kitchen       rect(-4.20  1.90 4.55 4.75))
    Space(Dining        rect( 0.55  1.90 3.75 3.00))
    Space(Living        rect( 0.55  5.10 3.75 2.10))


UpperFloorSpaces() ->
    Space(MasterBedroom rect( 0.10 -7.10 4.20 5.20))
    Space(MasterWIR     rect(-1.95 -7.10 1.85 2.35))
    Space(Ensuite       rect(-1.95 -4.55 1.85 2.65))
    Space(Bedroom2      rect(-4.20  1.15 4.05 3.55))
    Space(Bedroom3      rect( 0.10  1.15 4.20 3.55))
    Space(MainBathroom  rect(-4.20 -1.85 2.50 2.80))
    Space(UpperHall     rect(-1.45 -1.85 5.75 2.80))


SpaceRelations() ->
    Adjacent(Entry StairHall)
    Adjacent(StairHall Kitchen)
    Adjacent(Kitchen Dining)
    Adjacent(Dining Living)
    ConnectedToExterior(Living RearGarden)
    ConnectedToExterior(Dining RearGarden)
    Adjacent(MasterBedroom MasterWIR)
    Adjacent(MasterWIR Ensuite)
    Adjacent(UpperHall Bedroom2)
    Adjacent(UpperHall Bedroom3)
    Adjacent(UpperHall MainBathroom)


# ============================================================================
# 4. STRUCTURAL SYSTEM
# ============================================================================

StructuralSystem() ->
    GroundSlab()
    UpperSlab()
    RoofSlab()
    PrimaryWalls()
    GarageLintel()
    EntryLintel()


GroundSlab() ->
[
    Object(GroundSlab class(StructuralSlab))
    T(0 0.00 0)
    ExtrudeProfileWithVoids(
        outer(Rect(9.10 15.25))
        depth(0.20)
        material(lightgreyroughconcrete)
    )
]


UpperSlab() ->
[
    Object(UpperSlab class(StructuralSlab))
    T(0 3.05 0)
    ExtrudeProfileWithVoids(
        outer(Rect(9.10 15.25))
        void(StairVoid rect(-1.75 -2.10 2.45 5.10))
        depth(0.20)
        material(lightgreyroughconcrete)
    )
]


RoofSlab() ->
[
    Object(RoofSlab class(StructuralSlab))
    T(0 6.10 0)
    ExtrudeProfile(
        profile(RectProfile(9.10 15.25))
        depth(0.18)
        material(lightgreyroughconcrete)
    )
]


PrimaryWalls() ->
    StructuralWall(LeftBoundaryWall  -4.55 0.20 0.00 0.20 6.00 15.10)
    StructuralWall(RightBoundaryWall  4.55 0.20 0.00 0.20 6.00 15.10)
    StructuralWall(FrontSpineWall     0.20 0.20 -7.40 0.20 3.00 2.40)
    StructuralWall(StairCoreWall     -1.95 0.20 -0.90 0.18 6.00 5.40)
    StructuralWall(ServiceWall       -4.00 0.20  0.85 0.18 3.00 4.20)


StructuralWall(name x y z sx sy sz) ->
[
    Object(name class(StructuralWall))
    T(x y z)
    ExtrudeProfile(
        profile(RectProfile(sx sz))
        depth(sy)
        axis(Y)
        material(lightgreyroughconcrete)
    )
]


GarageLintel() ->
[
    Object(GarageLintel class(StructuralBeam))
    T(-2.48 2.75 -7.40)
    ExtrudeProfile(
        profile(RectProfile(3.65 0.30))
        depth(0.30)
        material(lightgreyroughconcrete)
    )
]


EntryLintel() ->
[
    Object(EntryLintel class(StructuralBeam))
    T(0.60 2.75 -7.40)
    ExtrudeProfile(
        profile(RectProfile(1.45 0.28))
        depth(0.28)
        material(lightgreyroughconcrete)
    )
]


# ============================================================================
# 5. ENVELOPE SYSTEM
# ============================================================================

EnvelopeSystem() ->
    FrontEnvelope()
    RearEnvelope()
    SideEnvelopes()
    FlatRoofAssembly()
    CharcoalCladdingZones()
    RenderedWallSystem()


RenderedWallSystem() ->
    LayerSet(
        name(StandardRenderedWall)
        reference(StructuralWallPlane)
        layers(
            Layer(InteriorPaint       0.002 warmwhitematteplaster)
            Layer(Plasterboard        0.013 offwhiteceramic)
            Layer(ServiceVoid         0.040 air)
            Layer(StudInsulation      0.140 insulation)
            Layer(StructuralSheathing 0.010 lightgreyroughconcrete)
            Layer(AirWaterBarrier     0.002 membrane)
            Layer(DrainageCavity      0.030 air)
            Layer(RenderCarrier       0.012 lightgreyroughconcrete)
            Layer(RenderFinish        0.010 warmwhitematteplaster)
        )
    )


FrontEnvelope() ->
    HostedWall(
        FrontGroundWall
        boundary(Rect(9.10 3.05))
        plane(Z -7.50)
        wallSystem(StandardRenderedWall)
        openings(
            GarageOpening
            EntryOpening
            LivingFrontWindowOpening
        )
    )

    HostedWall(
        FrontUpperWall
        boundary(Rect(9.10 3.05))
        plane(Z -7.50)
        offsetY(3.25)
        wallSystem(StandardRenderedWall)
        openings(
            MasterBalconyDoorOpening
            MasterWindowOpening
        )
    )


RearEnvelope() ->
    HostedWall(
        RearGroundWall
        boundary(Rect(9.10 3.05))
        plane(Z 7.50)
        wallSystem(StandardRenderedWall)
        openings(
            RearSliderOpening
        )
    )

    HostedWall(
        RearUpperWall
        boundary(Rect(9.10 3.05))
        plane(Z 7.50)
        offsetY(3.25)
        wallSystem(StandardRenderedWall)
        openings(
            Bedroom2RearWindowOpening
            Bedroom3RearWindowOpening
        )
    )


SideEnvelopes() ->
    HostedWall(
        LeftSideWall
        boundary(Rect(15.0 6.30))
        plane(X -4.55)
        wallSystem(StandardRenderedWall)
        openings(
            GarageSideWindowOpening
            Bedroom2SideWindowOpening
        )
    )

    HostedWall(
        RightSideWall
        boundary(Rect(15.0 6.30))
        plane(X 4.55)
        wallSystem(StandardRenderedWall)
        openings(
            LivingSideWindowOpening
            StairSideWindowOpening
            Bedroom3SideWindowOpening
        )
    )


FlatRoofAssembly() ->
[
    Object(FlatRoof class(RoofAssembly))
    T(0 6.10 0)
    LayerSet(
        referenceSurface(RectSurface(9.10 15.25))
        slope(0.015 toward(RearRoofDrain))
        layers(
            Layer(StructuralSlab 0.180 lightgreyroughconcrete)
            Layer(FallsScreed    0.050 lightgreyroughconcrete)
            Layer(VapourLayer    0.002 membrane)
            Layer(Insulation     0.090 insulation)
            Layer(Waterproofing  0.006 charcoalroughmetal)
            Layer(Protection     0.020 lightgreyroughconcrete)
        )
    )
]


RoofParapet() ->
[
    Object(Parapet class(RoofEdge))
    SweepProfile(
        profile(ParapetCopingProfile)
        path(ClosedRectPath(9.10 15.25 atY(6.58)))
        material(silverbluepolishedmetal)
    )
]


ParapetCopingProfile() ->
    FoldedProfile(
        thickness(0.0012)
        points(
            0.00 0.00
            0.05 0.03
            0.30 0.05
            0.34 0.02
            0.34 -0.05
            0.30 -0.06
            0.28 0.00
            0.06 0.00
            0.04 -0.06
            0.00 -0.05
        )
        dripEdges(true)
    )


CharcoalCladdingZones() ->
    FrontCladdingFrame()
    FrontVerticalScreen()
    RearUpperCladding()


FrontCladdingFrame() ->
[
    Object(FrontCladdingFrame class(CladdingAssembly))
    T(-2.80 3.50 -7.58)
    RepeatProfileOnSurface(
        surface(RectSurface(3.25 2.40))
        profile(RectProfile(0.045 0.085))
        pitch(0.095)
        orientation(Vertical)
        backingBattens(0.035 0.035 pitch(0.60))
        cavity(0.030)
        material(charcoalroughmetal)
    )
]


FrontVerticalScreen() ->
[
    Object(FrontPrivacyScreen class(ScreenAssembly))
    T(-3.68 3.40 -7.72)
    RepeatExtrusion(
        profile(RectProfile(0.055 0.090))
        axis(Y)
        height(2.55)
        count(13)
        pitch(0.14)
        material(charcoalroughmetal)
        topRail(RectProfile(1.95 0.08))
        bottomRail(RectProfile(1.95 0.08))
    )
]


RearUpperCladding() ->
[
    Object(RearUpperCladding class(CladdingAssembly))
    T(-2.70 3.50 7.58)
    RepeatProfileOnSurface(
        surface(RectSurface(3.10 2.25))
        profile(RectProfile(0.045 0.080))
        pitch(0.10)
        orientation(Vertical)
        material(charcoalroughmetal)
    )
]


# ============================================================================
# 6. OPENINGS + WINDOWS + DOORS
# ============================================================================

OpeningSystem() ->
    GarageDoorAssembly()
    MainEntryDoorAssembly()
    FrontWindows()
    RearSlidingDoorAssembly()
    SideWindows()
    UpperWindows()


GarageDoorAssembly() ->
[
    Object(GarageOpening class(HostedOpening))
    Host(FrontGroundWall)
    Opening(rect(-4.20 0.20 -0.70 2.75))
]
[
    Object(GarageDoor class(SectionalGarageDoor))
    PositionIn(GarageOpening)
    ArticulatedPanelSystem(
        overallWidth(3.50)
        overallHeight(2.42)
        panelCount(5)
        panelThickness(0.042)
        stilePitch(0.75)
        trackProfile(GarageTrackProfile)
        trackRadius(0.32)
        rollers(diameter(0.046))
        hinges(intermediateAndEnd)
        seals(perimeter bottom)
        material(charcoalroughmetal)
    )
]


MainEntryDoorAssembly() ->
[
    Object(EntryOpening class(HostedOpening))
    Host(FrontGroundWall)
    Opening(rect(-0.10 0.20 1.35 2.55))
]
[
    Object(MainEntryDoor class(HingedDoorAssembly))
    PositionIn(EntryOpening)
    LayeredPanel(
        width(1.05)
        height(2.35)
        thickness(0.055)
        skins(amberwarmwood)
        core(insulated)
        edgeLipping(0.025)
    )
    Frame(
        jambProfile(TimberDoorJambProfile)
        headProfile(TimberDoorHeadProfile)
        thresholdProfile(AluminiumThresholdProfile)
    )
    Hardware(
        hinge(type(ConcealedPivot) count(2))
        pullHandle(length(0.65) section(Round 0.026))
        latch(Magnetic)
    )
    SealPath(perimeter EPDM 0.010)
]


FrontWindows() ->
    FixedWindow(
        LivingFrontWindow
        host(FrontGroundWall)
        opening(LivingFrontWindowOpening rect(1.25 0.45 3.95 2.65))
        frameSystem(BlackThermalWindowSystem)
        mullions(1)
    )


UpperWindows() ->
    SlidingWindow(
        MasterBalconyDoor
        host(FrontUpperWall)
        opening(MasterBalconyDoorOpening rect(-3.40 3.72 -1.10 5.82))
        panels(2)
    )

    FixedWindow(
        MasterFrontWindow
        host(FrontUpperWall)
        opening(MasterWindowOpening rect(0.70 3.72 3.55 5.80))
        frameSystem(BlackThermalWindowSystem)
        mullions(1)
    )

    FixedWindow(
        Bedroom2RearWindow
        host(RearUpperWall)
        opening(Bedroom2RearWindowOpening rect(-3.75 3.85 -0.25 5.75))
        frameSystem(BlackThermalWindowSystem)
        mullions(1)
    )

    FixedWindow(
        Bedroom3RearWindow
        host(RearUpperWall)
        opening(Bedroom3RearWindowOpening rect(0.25 3.85 3.75 5.75))
        frameSystem(BlackThermalWindowSystem)
        mullions(1)
    )


SideWindows() ->
    FixedWindow(
        GarageSideWindow
        host(LeftSideWall)
        opening(GarageSideWindowOpening rect(-2.50 1.10 0.10 2.25))
        frameSystem(BlackThermalWindowSystem)
        mullions(0)
    )

    FixedWindow(
        LivingSideWindow
        host(RightSideWall)
        opening(LivingSideWindowOpening rect(4.55 0.80 7.25 2.60))
        frameSystem(BlackThermalWindowSystem)
        mullions(1)
    )

    FixedWindow(
        StairSideWindow
        host(RightSideWall)
        opening(StairSideWindowOpening rect(4.55 2.00 7.25 5.25))
        frameSystem(BlackThermalWindowSystem)
        mullions(0)
    )

    FixedWindow(
        Bedroom2SideWindow
        host(LeftSideWall)
        opening(Bedroom2SideWindowOpening rect(-4.55 4.00 1.35 5.45))
        frameSystem(BlackThermalWindowSystem)
        mullions(0)
    )

    FixedWindow(
        Bedroom3SideWindow
        host(RightSideWall)
        opening(Bedroom3SideWindowOpening rect(4.55 4.00 1.35 5.45))
        frameSystem(BlackThermalWindowSystem)
        mullions(0)
    )


RearSlidingDoorAssembly() ->
[
    Object(RearSliderOpening class(HostedOpening))
    Host(RearGroundWall)
    Opening(rect(-3.95 0.28 3.95 2.75))
]
[
    Object(RearSlider class(SlidingDoorAssembly))
    PositionIn(RearSliderOpening)
    ProfileLibrarySystem(BlackThermalSlidingDoorSystem)
    TrackAssembly(
        trackCount(3)
        sillProfile(SlidingDoorSillProfile)
        headProfile(SlidingDoorHeadProfile)
        jambProfile(SlidingDoorJambProfile)
        rollerDiameter(0.042)
    )
    Panels(
        SlidingPanel(width(2.62) height(2.35))
        SlidingPanel(width(2.62) height(2.35))
        SlidingPanel(width(2.62) height(2.35))
    )
    GlazingUnit(
        outerGlass(0.006)
        cavity(0.014)
        innerGlass(0.006)
        gasket(EPDM)
    )
]


FixedWindow(name host wallOpening frameSystem mullions) ->
[
    Object(name class(WindowAssembly))
    Host(host)
    HostedOpening(wallOpening)
    FrameProfiles(
        head(WindowHeadProfile)
        sill(WindowSillProfile)
        jambLeft(WindowJambProfile)
        jambRight(WindowJambProfile)
        mullion(WindowMullionProfile count(mullions))
    )
    GlazingUnit(
        outerGlass(0.006)
        cavity(0.014)
        innerGlass(0.006)
        spacer(0.012)
        gaskets(EPDM)
    )
    Flashing(
        head(HeadFlashingProfile)
        sill(SillPanProfile slope(0.03))
        jambSealant(0.010)
    )
    Anchors(spacing(0.450))
]


SlidingWindow(name host opening panels) ->
[
    Object(name class(SlidingDoorAssembly))
    Host(host)
    HostedOpening(opening)
    TrackAssembly(
        trackCount(2)
        frameDepth(0.125)
        interlockStile(0.055)
        rollerDiameter(0.038)
    )
    PanelArray(
        count(panels)
        panelWidth(1.10)
        panelHeight(2.10)
        overlap(0.045)
        glazing(IGU 6 14 6)
    )
]


