ColdWaterGraph() ->
    ServicePipe(
        name(ColdMain)
        path(Polyline3((-4.00 0.35 -0.20) (-3.20 0.35 4.20) (-1.30 0.35 4.20)))
        diameter(0.020)
        material(bluepipe)
    )


HotWaterGraph() ->
    ServicePipe(
        name(HotMain)
        path(Polyline3((-4.00 0.42 -0.20) (-3.20 0.42 4.20) (-1.30 0.42 4.20)))
        diameter(0.016)
        material(redpipe)
    )


WasteGraph() ->
    ServicePipe(
        name(WasteMain)
        path(Polyline3((-1.30 0.05 4.00) (-1.60 -0.10 1.00) (-1.60 -0.20 -8.00)))
        diameter(0.100)
        material(charcoalroughmetal)
        slope(0.020)
    )


ServicePipe(name path diameter material) ->
[
    Object(name class(Service))
    SweepDisk(
        path(path)
        radius(diameter/2)
        radialSegments(10)
        material(material)
    )
]


# ============================================================================
# 12. GARAGE
# ============================================================================

GarageSystem() ->
    GarageFloor()
    GarageStorage()
    GarageLighting()


GarageFloor() ->
[
    Object(GarageFloorFinish class(FloorFinish))
    T(-2.45 0.21 -4.50)
    SurfaceTiling(
        boundary(Rect(3.75 5.90))
        tile(Rect(1.20 1.20))
        joint(0.004 0.004)
        material(lightgreyroughconcrete)
    )
]


GarageStorage() ->
[
    Object(GarageRearCabinet class(CabinetAssembly))
    T(-3.85 0.23 -1.65)
    PanelArray(
        modules(3 width(0.62) height(2.10) depth(0.48))
        material(charcoalroughmetal)
    )
]


GarageLighting() ->
    GridArray(
        object(RecessedLuminaire(cutout(0.085) recessDepth(0.10)))
        nx(2) ny(3)
        spacingX(1.45)
        spacingZ(1.75)
        origin(-3.18 2.95 -6.00)
    )


# ============================================================================
# 13. REAR GARDEN / VEGETATION
# ============================================================================

LandscapeSystem() ->
    RearTerrace()
    RearLawn()
    PerimeterPlanting()
    FrontPlanting()
    BalconyVines()
    RearFenceVines()


RearTerrace() ->
[
    Object(RearTerrace class(SiteSurface))
    T(0 0.06 8.05)
    SurfaceTiling(
        boundary(Rect(5.50 1.60))
        tile(Rect(0.60 0.60))
        joint(0.008 0.006)
        material(offwhiteceramic)
    )
]


RearLawn() ->
[
    Object(RearLawn class(LandscapeSurface))
    T(0 0.05 10.20)
    HeightField(
        boundary(Rect(8.70 4.15))
        nominalHeight(0.05)
        variation(0.010)
        material(grass)
    )
]


PerimeterPlanting() ->
    ShrubBorder(-4.45 9.60 17)
    ShrubBorder( 4.45 9.60 17)
    RearTree(2.95 10.40)
    RearTree(-3.20 10.80)


ShrubBorder(x z count) ->
[
    Object(ShrubBorderInstance class(PlantingAssembly))
    T(x 0 z)
    InstanceArray(
        object(
            Plant(
                generator(
                    SpaceColonization(
                        volume(Ellipsoid(0.42 0.48 0.42))
                        attractionPoints(95)
                        step(0.10)
                    )
                )
                stem(TaperedSweep(radiusStart(0.018) radiusEnd(0.006)))
                leaves(
                    LeafBlade(profile(Ovate) length(0.065) width(0.032) camber(0.003))
                    OrganArray(density(34))
                )
            )
        )
        count(count)
        along(Line3(0 0 -2.5, 0 0 2.5))
        jitter(0.08)
        scaleVariation(0.85 1.15)
    )
]


RearTree(x z) ->
[
    Object(RearTreeInstance class(Tree))
    T(x 0 z)
    BranchGraph(
        trunk(TaperedSweep(path(Bezier3((0 0 0) (0.03 1.2 0) (-0.08 2.4 0.02) (0 3.6 0))) radiusStart(0.14) radiusEnd(0.05)))
        crown(
            SpaceColonization(
                volume(Ellipsoid(1.65 1.55 1.65 centre(0 3.25 0)))
                attractionPoints(520)
                influenceRadius(0.62)
                killRadius(0.18)
                step(0.20)
            )
        )
        leaves(
            LeafBlade(profile(Elliptic) length(0.085) width(0.036) camber(0.004))
            OrganArray(density(15) phyllotaxis(Alternate divergence(137.5)))
        )
    )
]


FrontPlanting() ->
    OrnamentalGrass(-4.65 -8.15 9)
    OrnamentalGrass( 0.20 -8.15 7)
    OrnamentalGrass( 3.80 -8.15 9)
    FrontFeatureTree(2.90 -7.65)


OrnamentalGrass(x z count) ->
[
    Object(GrassClump class(Plant))
    T(x 0 z)
    OrganArray(
        object(
            LeafBlade(
                profile(Linear)
                length(0.55)
                width(0.018)
                bend(0.22)
                twistVariation(-5 5)
                material(greenmattepaint)
            )
        )
        count(count)
        radial(true)
        azimuthVariation(0 360)
        tiltVariation(5 28)
    )
]


FrontFeatureTree(x z) ->
[
    Object(FrontFeatureTree class(Tree))
    T(x 0 z)
    BranchGraph(
        trunk(TaperedSweep(path(Bezier3((0 0 0) (0.02 0.8 0) (-0.03 1.8 0) (0 2.65 0))) radiusStart(0.085) radiusEnd(0.025)))
        branches(
            LSystem(
                axiom(A)
                rule(A -> F[+A][-A]FA)
                iterations(3)
                angle(31)
                segmentLength(0.24)
            )
        )
        leaves(
            LeafBlade(profile(Ovate) length(0.075) width(0.034) camber(0.003))
            OrganArray(density(18))
        )
    )
]


BalconyVines() ->
[
    Object(FrontBalconyVines class(VineAssembly))
    VinePath(
        start(-3.55 3.40 -7.65)
        support(FrontUpperWall)
        grow(direction(0.20 -0.08 0))
        surfaceAttachment(distance(0.015) mode(WallClimbing))
        branching(probability(0.16))
        stem(TaperedSweep(radiusStart(0.010) radiusEnd(0.003)))
        leaves(
            LeafBlade(profile(Cordate) length(0.060) width(0.050) camber(0.003))
            OrganArray(spacing(0.095) phyllotaxis(Alternate divergence(137.5)))
        )
    )
]


RearFenceVines() ->
[
    Object(RearFenceVines class(VineAssembly))
    VinePath(
        start(-5.20 0.10 8.95)
        support(RearFence)
        mode(TrellisClimbing)
        surfaceAttachment(distance(0.010))
        branchProbability(0.20)
        stem(TaperedSweep(radiusStart(0.007) radiusEnd(0.002)))
        leaves(LeafBlade(profile(Cordate) length(0.055) width(0.046)))
    )
]


# ============================================================================
# 14. VEHICLE — MVGv1 STYLE
# ============================================================================

VehicleSystem() ->
    DrivewayVehicle()


DrivewayVehicle() ->
[
    Object(DrivewayCar class(MotorVehicle))
    T(-2.45 0.15 -8.10)

    VehiclePackage(
        bodyType(FastbackSedan)
        length(4.62)
        width(1.84)
        height(1.42)
        wheelbase(2.75)
        frontTrack(1.58)
        rearTrack(1.57)
        groundClearance(0.145)
        frontOverhang(0.92)
        rearOverhang(0.95)
        wheelRadius(0.335)
    )

    VehicleDatums(
        centreline(X 0)
        ground(Y 0)
        frontAxle(Z 0.95)
        rearAxle(Z -1.80)
        beltLine(Y 0.92)
        roofDatum(Y 1.38)
    )

    BodyShell(
        SurfaceLoft(
            symmetryPlane(X 0)
            sections(
                BodySection(Nose        Z  2.18 profile(CarSection_Nose))
                BodySection(FrontArch   Z  1.22 profile(CarSection_FrontArch))
                BodySection(APillar     Z  0.45 profile(CarSection_APillar))
                BodySection(BPillar     Z -0.42 profile(CarSection_BPassenger))
                BodySection(RearCabin   Z -1.10 profile(CarSection_RearCabin))
                BodySection(RearArch    Z -1.72 profile(CarSection_RearArch))
                BodySection(Tail        Z -2.28 profile(CarSection_Tail))
            )
            guides(
                GuideCurve(RoofLine     CarRoofGuide)
                GuideCurve(BeltLine     CarBeltGuide)
                GuideCurve(ShoulderLine CarShoulderGuide)
                GuideCurve(RockerLine   CarRockerGuide)
            )
            continuity(C1)
        )
        thickness(0.0012)
        material(charcoalmetallicpaint)
    )

    WheelArch(frontLeft  wheelCentre(-0.79 0.335  0.95) radius(0.37) clearance(0.035))
    WheelArch(frontRight wheelCentre( 0.79 0.335  0.95) radius(0.37) clearance(0.035))
    WheelArch(rearLeft   wheelCentre(-0.785 0.335 -1.80) radius(0.37) clearance(0.035))
    WheelArch(rearRight  wheelCentre( 0.785 0.335 -1.80) radius(0.37) clearance(0.035))

    PanelCut(Hood       curve(HoodSeam)      gap(0.004))
    PanelCut(DoorFL     curve(DoorFLSeam)    gap(0.004))
    PanelCut(DoorFR     curve(DoorFRSeam)    gap(0.004))
    PanelCut(DoorRL     curve(DoorRLSeam)    gap(0.004))
    PanelCut(DoorRR     curve(DoorRRSeam)    gap(0.004))
    PanelCut(Boot       curve(BootSeam)      gap(0.004))

    CurvedPanel(Windshield source(CarBodySurface) boundary(WindshieldBoundary) thickness(0.005))
    CurvedPanel(RearGlass  source(CarBodySurface) boundary(RearGlassBoundary)  thickness(0.005))

    WheelAssembly(FrontLeft  position(-0.79 0.335  0.95))
    WheelAssembly(FrontRight position( 0.79 0.335  0.95))
    WheelAssembly(RearLeft   position(-0.785 0.335 -1.80))
    WheelAssembly(RearRight  position( 0.785 0.335 -1.80))

    HeadlampAssembly(left  position(-0.60 0.72 2.14))
    HeadlampAssembly(right position( 0.60 0.72 2.14))
]


WheelAssembly(name position) ->
[
    Object(name class(WheelAssembly))
    T(position)

    Tire(
        Revolve(
            profile(TireProfile(width(0.225) aspect(0.45) rimDiameter(0.48)))
            segments(48)
            material(charcoalroughrubber)
        )
    )

    Rim(
        Revolve(profile(RimBarrelProfile(0.48 0.205)) segments(40) material(silverbluepolishedmetal))
        RadialArray(
            object(Spoke profile(RectProfile(0.055 0.020)) length(0.18))
            count(10)
            axis(WheelAxis)
            material(silverbluepolishedmetal)
        )
    )

    BrakeDisc(
        Revolve(profile(BrakeRotorProfile) segments(40) material(silverbluepolishedmetal))
        RadialArray(object(VentHole diameter(0.008)) count(24))
    )

    Caliper(
        ShellLoft(
            sections(
                RoundedRect(0.12 0.05 0.02 at(0))
                RoundedRect(0.15 0.07 0.025 at(0.05))
                RoundedRect(0.12 0.05 0.02 at(0.11))
            )
            material(charcoalroughmetal)
        )
    )
]


HeadlampAssembly(side position) ->
[
    Object(Headlamp class(LightingAssembly))
    T(position)
    CurvedPanel(
        boundary(RoundedRectBoundary(0.42 0.12))
        curvature(0.025)
        thickness(0.003)
        material(bluewhiteglossysmoothglass)
    )
    Housing(
        ShellLoft(
            sections(
                RoundedRect(0.38 0.10 0.02 at(0))
                RoundedRect(0.32 0.08 0.02 at(-0.10))
            )
            material(charcoalroughmetal)
        )
    )
    LightGuide(
        path(Bezier3((-0.16 0 0) (-0.05 0.04 0) (0.07 0.04 0) (0.16 0 0)))
        crossSection(Circle 0.009)
    )
]


# ============================================================================
# 15. RELATIONSHIPS + COLLISION POSITIONING
# ============================================================================

SpatialRelationships() ->
    PositionConstraint(MainEntryDoor EntryOpening alignNormals touch clearance(0.004))
    PositionConstraint(GarageDoor GarageOpening centreInOpening clearance(0.010))
    PositionConstraint(RearSlider RearSliderOpening centreInOpening clearance(0.006))

    PositionConstraint(KitchenIsland GroundFloorTimber supportedBy clearance(0.000))
    PositionConstraint(KitchenIsland StairKitchenWall clearanceFrom 0.90)

    PositionConstraint(LivingSofa GroundFloorTimber supportedBy clearance(0.000))
    PositionConstraint(MasterBed UpperTimberFloor supportedBy clearance(0.000))

    Connection(KitchenSink.wasteOutlet WasteMain branch)
    Connection(KitchenSink.coldInlet ColdMain branch)
    Connection(KitchenSink.hotInlet HotMain branch)

    CollisionRule(DrivewayCar avoid(BuildingEnvelope FrontFence Letterbox))
    CollisionRule(FrontFeatureTree avoid(BuildingEnvelope Footpath))
    CollisionRule(FrontBalconyVines seek(FrontUpperWall))
    CollisionRule(RearFenceVines seek(RearFence))


# ============================================================================
# 16. VALIDATION
# ============================================================================

ValidationModel() ->
    ValidateUniqueObjectIds()
    ValidateSpatialContainment()
    ValidateRoomAdjacency()
    ValidateCirculation()
    ValidateSupportPaths()
    ValidateHostedOpenings()
    ValidateEnvelopeContinuity()
    ValidateServiceConnectivity()
    ValidateForbiddenCollisions()
    ValidateClearances()
    ValidateVehiclePackage()
    ValidateVegetationAttachments()
    ValidateProceduralMeshes()
    CommitOnlyIfValid()


ValidateCirculation() ->
    RequireReachable(Street Entry)
    RequireReachable(Entry Living)
    RequireReachable(Entry Kitchen)
    RequireReachable(Entry UpperHall)
    RequireReachable(UpperHall MasterBedroom)
    RequireReachable(UpperHall Bedroom2)
    RequireReachable(UpperHall Bedroom3)


ValidateSupportPaths() ->
    RequireSupport(UpperSlab PrimaryWalls)
    RequireSupport(RoofSlab PrimaryWalls)
    RequireSupport(MainStair GroundSlab UpperSlab)


ValidateHostedOpenings() ->
    RequireContained(GarageOpening FrontGroundWall)
    RequireContained(EntryOpening FrontGroundWall)
    RequireContained(RearSliderOpening RearGroundWall)
    RequireNoOpeningOverlap()


ValidateEnvelopeContinuity() ->
    RequireClosedEnvelopeExcept(Openings)
    RequireLayerContinuity(StandardRenderedWall)
    RequireRoofDrainage(FlatRoof RearRoofDrain)


ValidateServiceConnectivity() ->
    RequireConnected(KitchenSink WasteMain)
    RequireConnected(KitchenSink ColdMain)
    RequireConnected(KitchenSink HotMain)
    RequireConnected(EnsuiteShower WasteMain)
    RequireConnected(MainShower WasteMain)


ValidateForbiddenCollisions() ->
    RequireNoCollision(DrivewayCar BuildingEnvelope)
    RequireNoCollision(DrivewayCar FrontFence)
    RequireNoCollision(DrivewayCar Letterbox)
    RequireNoCollision(MainEntryDoor MainEntryDoorSwingClearance)


ValidateClearances() ->
    RequireClearance(DrivewayCar GarageDoor 0.60)
    RequireClearance(KitchenIsland DiningTable 1.00)
    RequireClearance(MainStair UpperHallRail 0.05)


ValidateVehiclePackage() ->
    RequireWheelClearance(DrivewayCar 0.025)
    RequireBodyGroundClearance(DrivewayCar 0.130)
    RequireVehicleSymmetry(DrivewayCar tolerance(0.004))


ValidateVegetationAttachments() ->
    RequireAttached(FrontBalconyVines FrontUpperWall)
    RequireAttached(RearFenceVines RearFence)
    RequireVegetationAvoidance(FrontFeatureTree BuildingEnvelope 0.25)


ValidateProceduralMeshes() ->
    RequireFiniteVertices()
    RequireValidIndices()
    RequireNoDegenerateTriangles()
    RequireManifoldWhereRequired()
    RequireDeterministicMeshHash()
