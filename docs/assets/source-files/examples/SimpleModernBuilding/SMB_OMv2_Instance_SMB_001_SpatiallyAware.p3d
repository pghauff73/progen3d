# -----------------------------------------------------------------------------
# Five-deep semantic and relationship templates
# -----------------------------------------------------------------------------

SMB_RELATIONSHIP_L1_SourceObject -> SMB_RELATIONSHIP_L2_SourceInterface
SMB_RELATIONSHIP_L2_SourceInterface -> SMB_RELATIONSHIP_L3_TypedRelation
SMB_RELATIONSHIP_L3_TypedRelation -> SMB_RELATIONSHIP_L4_TargetInterface
SMB_RELATIONSHIP_L4_TargetInterface -> SMB_RELATIONSHIP_L5_EvidenceLeaf
SMB_RELATIONSHIP_L5_EvidenceLeaf -> SMB_NoGeometry

SMB_SEMANTIC_L1_SemanticClass -> SMB_SEMANTIC_L2_SemanticInstance
SMB_SEMANTIC_L2_SemanticInstance -> SMB_SEMANTIC_L3_AttributeGroup
SMB_SEMANTIC_L3_AttributeGroup -> SMB_SEMANTIC_L4_ReferenceInterface
SMB_SEMANTIC_L4_ReferenceInterface -> SMB_SEMANTIC_L5_AtomicSemanticLeaf
SMB_SEMANTIC_L5_AtomicSemanticLeaf -> SMB_NoGeometry

# -----------------------------------------------------------------------------
# Geometry implementation helpers below the SMB hierarchy
# -----------------------------------------------------------------------------

SMB_StaticCube(x y z width height depth materialIndex alpha textureScale) -> [ T(x y-height/2 z) S(width height depth) !I(CubeY index(materialIndex) alpha textureScale) ]
SMB_DynamicCube(x y z width height depth materialIndex alpha textureScale mass) -> [ M(mass) T(x y-height/2 z) S(width height depth) I(CubeY index(materialIndex) alpha textureScale) ]
SMB_StaticCylinder(x y z width height depth materialIndex alpha textureScale) -> [ T(x y z) S(width height depth) !I(Cylinder index(materialIndex) alpha textureScale) ]
SMB_StaticSphere(x y z width height depth materialIndex alpha textureScale) -> [ T(x y z) S(width height depth) !I(Sphere index(materialIndex) alpha textureScale) ]

# Repeat zero is the supported no-op representation. The body remains a valid
# grammar production, but neither it nor its setup/tail sections are expanded.
SMB_NoGeometry 0 -> [ S(1 1 1) ]
