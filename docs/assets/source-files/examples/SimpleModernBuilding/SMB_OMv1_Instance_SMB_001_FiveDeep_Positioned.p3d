    SMB_SITE_BOUNDARY_L1_BoundarySystem(-SiteWidth/2 0.12 0 0.12 0.24 SiteDepth 14 1 0.4 0)
    SMB_SITE_BOUNDARY_L1_BoundarySystem(SiteWidth/2 0.12 0 0.12 0.24 SiteDepth 14 1 0.4 0)
