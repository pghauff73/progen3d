# SMB-OMv1 Small Modern Building
#
# This grammar implements the 124-object SMB_001 object model as a positioned,
# five-deep building scene. Container rules expand their declared child-object
# set. Physical leaves pass through purpose-named L1-L5 templates before an
# implementation primitive is emitted. Relationship and semantic leaves end in
# SMB_NoGeometry and therefore never invent geometric evidence.
#
# Positioning policy:
# - Site, structure, envelope, installed services, and fixed fittings are !I().
# - Loose furniture is I() and starts ContactAllowance above a supporting slab.
# - Gravity lets collision positioning settle those loose objects onto floors.
# - Fixed parts meet at authored boundaries and do not rely on static-static
#   collision correction.
#
# Error-checking policy:
# - Configuration variables are checked by one-comparison validation stages.
# - Invalid input fails closed into one visible red validation marker.
# - The building hierarchy is not expanded after a failed check.

Start ->
    R BuildingWidth(18 18)
    R BuildingDepth(14 14)
    R StoreyHeight(3.2 3.2)
    R WallThickness(0.22 0.22)
    R SlabThickness(0.45 0.45)
    R ContactAllowance(0.03 0.03)
    R SiteWidth(34 34)
    R SiteDepth(30 30)
    G(9.81 0 -1 0)
    SMB_001_ValidateBuildingWidthMinimum

# -----------------------------------------------------------------------------
# Staged fail-closed configuration validation
# -----------------------------------------------------------------------------

SMB_001_ValidateBuildingWidthMinimum -> ?(BuildingWidth>=14) SMB_001_ValidateBuildingWidthMaximum : SMB_Error_BuildingWidthMinimum
SMB_001_ValidateBuildingWidthMaximum -> ?(BuildingWidth<=30) SMB_001_ValidateBuildingDepthMinimum : SMB_Error_BuildingWidthMaximum
SMB_001_ValidateBuildingDepthMinimum -> ?(BuildingDepth>=10) SMB_001_ValidateBuildingDepthMaximum : SMB_Error_BuildingDepthMinimum
SMB_001_ValidateBuildingDepthMaximum -> ?(BuildingDepth<=24) SMB_001_ValidateStoreyHeightMinimum : SMB_Error_BuildingDepthMaximum
SMB_001_ValidateStoreyHeightMinimum -> ?(StoreyHeight>=2.6) SMB_001_ValidateStoreyHeightMaximum : SMB_Error_StoreyHeightMinimum
SMB_001_ValidateStoreyHeightMaximum -> ?(StoreyHeight<=4.5) SMB_001_ValidateWallThicknessMinimum : SMB_Error_StoreyHeightMaximum
SMB_001_ValidateWallThicknessMinimum -> ?(WallThickness>=0.12) SMB_001_ValidateWallThicknessMaximum : SMB_Error_WallThicknessMinimum
SMB_001_ValidateWallThicknessMaximum -> ?(WallThickness<=0.5) SMB_001_ValidateSlabThicknessMinimum : SMB_Error_WallThicknessMaximum
SMB_001_ValidateSlabThicknessMinimum -> ?(SlabThickness>=0.2) SMB_001_ValidateSlabThicknessMaximum : SMB_Error_SlabThicknessMinimum
SMB_001_ValidateSlabThicknessMaximum -> ?(SlabThickness<=0.8) SMB_001_ValidateContactAllowanceMinimum : SMB_Error_SlabThicknessMaximum
SMB_001_ValidateContactAllowanceMinimum -> ?(ContactAllowance>=0) SMB_001_ValidateContactAllowanceMaximum : SMB_Error_ContactAllowanceMinimum
SMB_001_ValidateContactAllowanceMaximum -> ?(ContactAllowance<=0.08) SMB_001_ValidateSiteWidth : SMB_Error_ContactAllowanceMaximum
SMB_001_ValidateSiteWidth -> ?(SiteWidth>=BuildingWidth+8) SMB_001_ValidateSiteDepth : SMB_Error_SiteWidth
SMB_001_ValidateSiteDepth -> ?(SiteDepth>=BuildingDepth+8) SMB_001 : SMB_Error_SiteDepth

SMB_Error_BuildingWidthMinimum -> SMB_ValidationErrorMarker(-6)
SMB_Error_BuildingWidthMaximum -> SMB_ValidationErrorMarker(-5)
SMB_Error_BuildingDepthMinimum -> SMB_ValidationErrorMarker(-4)
SMB_Error_BuildingDepthMaximum -> SMB_ValidationErrorMarker(-3)
SMB_Error_StoreyHeightMinimum -> SMB_ValidationErrorMarker(-2)
SMB_Error_StoreyHeightMaximum -> SMB_ValidationErrorMarker(-1)
SMB_Error_WallThicknessMinimum -> SMB_ValidationErrorMarker(0)
SMB_Error_WallThicknessMaximum -> SMB_ValidationErrorMarker(1)
SMB_Error_SlabThicknessMinimum -> SMB_ValidationErrorMarker(2)
SMB_Error_SlabThicknessMaximum -> SMB_ValidationErrorMarker(3)
SMB_Error_ContactAllowanceMinimum -> SMB_ValidationErrorMarker(4)
SMB_Error_ContactAllowanceMaximum -> SMB_ValidationErrorMarker(5)
SMB_Error_SiteWidth -> SMB_ValidationErrorMarker(6)
SMB_Error_SiteDepth -> SMB_ValidationErrorMarker(7)

SMB_ValidationErrorMarker(x) ->
    [ T(x 1 0) A(45 1) S(0.35 2.2 0.35) !I(Cube material(redroughmetal) 1 0.25) ]
    [ T(x 1 0) A(-45 1) S(0.35 2.2 0.35) !I(Cube material(redroughmetal) 1 0.25) ]

# -----------------------------------------------------------------------------
# L0 object rules: building root and containers
# -----------------------------------------------------------------------------

SMB_001 -> SMB_001_Site SMB_001_Structure SMB_001_GroundFloor SMB_001_UpperFloor SMB_001_Envelope SMB_001_RoofZone SMB_001_Services SMB_001_ExternalWorks SMB_001_Relationships

SMB_SemanticLeaf -> SMB_SEMANTIC_L1_SemanticClass

