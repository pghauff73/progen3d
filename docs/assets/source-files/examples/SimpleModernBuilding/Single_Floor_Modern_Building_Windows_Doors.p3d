# ================================================================
# SINGLE-FLOOR MODERN BUILDING
# Current Progen3D grammar syntax
#
# Overall dimensions:
#   width       = 12.0
#   depth       = 8.0
#   wall height = 3.2
#
# Openings:
#   front glazed entry door
#   rear solid service door
#   two front windows
#   two rear windows
#   one window on each side
#
# Openings are formed by assembling wall segments around them.
# No Boolean subtraction is required.
# ================================================================

Start ->
    SingleFloorBuilding()


SingleFloorBuilding() ->
    Foundation()
    FloorSlab()
    ExteriorWalls()
    Windows()
    Doors()
    EntryFeatures()
    FlatRoof()


# ================================================================
# REUSABLE MATERIAL PARTS
# ================================================================

WallBlock(x y z sx sy sz) ->
[
    T(x y z)
    S(sx sy sz)
    !I(CubeY material(warmwhitematteplaster) 1 0.34)
]


ConcreteBlock(x y z sx sy sz) ->
[
    T(x y z)
    S(sx sy sz)
    !I(CubeY material(lightgreyroughconcrete) 1 0.40)
]


MetalBlock(x y z sx sy sz) ->
[
    T(x y z)
    S(sx sy sz)
    !I(CubeY material(silverbluepolishedmetal) 1 0.20)
]


GlassBlock(x y z sx sy sz) ->
[
    T(x y z)
    S(sx sy sz)
    !I(CubeY material(bluewhiteglossysmoothglass) 0.68 0.24)
]


WoodBlock(x y z sx sy sz) ->
[
    T(x y z)
    S(sx sy sz)
    !I(CubeY material(amberwarmwood) 1 0.26)
]


# ================================================================
# FOUNDATION AND FLOOR
# ================================================================

Foundation() ->
    ConcreteBlock(0 -0.30 0 12.8 0.30 8.8)


FloorSlab() ->
    ConcreteBlock(0 0 0 12.0 0.20 8.0)


# ================================================================
# EXTERIOR WALLS
# Wall base = 0.20
# Wall top  = 3.40
# ================================================================

ExteriorWalls() ->
    FrontWall()
    RearWall()
    LeftWall()
    RightWall()


# ------------------------------------------------
# FRONT WALL
#
# Openings:
#   window centre -3.4, width 2.0
#   door centre    0.0, width 1.4
#   window centre  3.4, width 2.0
# ------------------------------------------------

FrontWall() ->
    WallBlock(-5.20 0.20 -4.00 1.60 3.20 0.20)
    WallBlock(-1.55 0.20 -4.00 1.70 3.20 0.20)
    WallBlock(1.55 0.20 -4.00 1.70 3.20 0.20)
    WallBlock(5.20 0.20 -4.00 1.60 3.20 0.20)

    WallBlock(-3.40 0.20 -4.00 2.00 0.90 0.20)
    WallBlock(-3.40 2.50 -4.00 2.00 0.90 0.20)

    WallBlock(3.40 0.20 -4.00 2.00 0.90 0.20)
    WallBlock(3.40 2.50 -4.00 2.00 0.90 0.20)

    WallBlock(0.00 2.60 -4.00 1.40 0.80 0.20)


# ------------------------------------------------
# REAR WALL
#
# Openings:
#   window centre -3.2, width 2.0
#   window centre  0.0, width 2.0
#   service door   4.5, width 1.2
# ------------------------------------------------

RearWall() ->
    WallBlock(-5.10 0.20 4.00 1.80 3.20 0.20)
    WallBlock(-1.60 0.20 4.00 1.20 3.20 0.20)
    WallBlock(2.45 0.20 4.00 2.90 3.20 0.20)
    WallBlock(5.55 0.20 4.00 0.90 3.20 0.20)

    WallBlock(-3.20 0.20 4.00 2.00 0.90 0.20)
    WallBlock(-3.20 2.50 4.00 2.00 0.90 0.20)

    WallBlock(0.00 0.20 4.00 2.00 0.90 0.20)
    WallBlock(0.00 2.50 4.00 2.00 0.90 0.20)

    WallBlock(4.50 2.40 4.00 1.20 1.00 0.20)


# ------------------------------------------------
# LEFT WALL
# One centred side window, width along Z = 2.6
# ------------------------------------------------

LeftWall() ->
    WallBlock(-6.00 0.20 -2.65 0.20 3.20 2.70)
    WallBlock(-6.00 0.20 2.65 0.20 3.20 2.70)
    WallBlock(-6.00 0.20 0.00 0.20 0.90 2.60)
    WallBlock(-6.00 2.50 0.00 0.20 0.90 2.60)


# ------------------------------------------------
# RIGHT WALL
# One centred side window, width along Z = 2.6
# ------------------------------------------------

RightWall() ->
    WallBlock(6.00 0.20 -2.65 0.20 3.20 2.70)
    WallBlock(6.00 0.20 2.65 0.20 3.20 2.70)
    WallBlock(6.00 0.20 0.00 0.20 0.90 2.60)
    WallBlock(6.00 2.50 0.00 0.20 0.90 2.60)


# ================================================================
# WINDOWS
# ================================================================

Windows() ->
    FrontRearWindow(-3.40 1.10 -4.12 2.00 1.40)
    FrontRearWindow(3.40 1.10 -4.12 2.00 1.40)

    FrontRearWindow(-3.20 1.10 4.12 2.00 1.40)
    FrontRearWindow(0.00 1.10 4.12 2.00 1.40)

    SideWindow(-6.12 1.10 0.00 2.60 1.40)
    SideWindow(6.12 1.10 0.00 2.60 1.40)


FrontRearWindow(cx sill z w h) ->
    GlassBlock(cx sill+0.08 z w-0.16 h-0.16 0.06)

    MetalBlock(cx-w/2 sill z 0.08 h 0.10)
    MetalBlock(cx+w/2 sill z 0.08 h 0.10)

    MetalBlock(cx sill z w 0.08 0.10)
    MetalBlock(cx sill+h-0.08 z w 0.08 0.10)

    MetalBlock(cx sill z-0.03 0.06 h 0.06)


SideWindow(x sill cz w h) ->
    GlassBlock(x sill+0.08 cz 0.06 h-0.16 w-0.16)

    MetalBlock(x sill cz-w/2 0.10 h 0.08)
    MetalBlock(x sill cz+w/2 0.10 h 0.08)

    MetalBlock(x sill cz 0.10 0.08 w)
    MetalBlock(x sill+h-0.08 cz 0.10 0.08 w)

    MetalBlock(x-0.03 sill cz 0.06 h 0.06)


# ================================================================
# DOORS
# ================================================================

Doors() ->
    MainGlazedDoor()
    RearServiceDoor()


MainGlazedDoor() ->
    GlassBlock(0.00 0.28 -4.14 1.20 2.24 0.08)

    MetalBlock(-0.70 0.20 -4.15 0.10 2.40 0.12)
    MetalBlock(0.70 0.20 -4.15 0.10 2.40 0.12)
    MetalBlock(0.00 2.50 -4.15 1.40 0.10 0.12)

    MainDoorHandle()


MainDoorHandle() ->
[
    T(0.42 1.05 -4.24)
    S(0.07 0.62 0.07)
    !I(Cylinder material(charcoalroughmetal) 1 0.14)
]


RearServiceDoor() ->
    WoodBlock(4.50 0.28 4.14 1.02 2.02 0.10)

    MetalBlock(3.90 0.20 4.15 0.10 2.20 0.12)
    MetalBlock(5.10 0.20 4.15 0.10 2.20 0.12)
    MetalBlock(4.50 2.30 4.15 1.20 0.10 0.12)

    RearDoorHandle()


RearDoorHandle() ->
[
    T(4.88 1.05 4.24)
    S(0.07 0.45 0.07)
    !I(Cylinder material(charcoalroughmetal) 1 0.14)
]


# ================================================================
# ENTRY FEATURES
# ================================================================

EntryFeatures() ->
    EntryStep()
    EntryCanopy()
    CanopyColumns()


EntryStep() ->
    ConcreteBlock(0.00 0.00 -4.80 2.80 0.16 1.40)


EntryCanopy() ->
    MetalBlock(0.00 2.90 -5.15 3.80 0.16 2.10)
    GlassBlock(0.00 2.84 -5.15 3.45 0.06 1.80)


CanopyColumns() ->
[
    T(-1.65 0.00 -5.75)
    S(0.18 2.90 0.18)
    !I(Cylinder material(silverbluepolishedmetal) 1 0.16)
]
[
    T(1.65 0.00 -5.75)
    S(0.18 2.90 0.18)
    !I(Cylinder material(silverbluepolishedmetal) 1 0.16)
]


# ================================================================
# FLAT ROOF AND PARAPET
# ================================================================

FlatRoof() ->
    ConcreteBlock(0.00 3.40 0.00 12.40 0.22 8.40)
    RoofParapet()


RoofParapet() ->
    WallBlock(0.00 3.62 -4.10 12.40 0.45 0.20)
    WallBlock(0.00 3.62 4.10 12.40 0.45 0.20)
    WallBlock(-6.10 3.62 0.00 0.20 0.45 8.00)
    WallBlock(6.10 3.62 0.00 0.20 0.45 8.00)
