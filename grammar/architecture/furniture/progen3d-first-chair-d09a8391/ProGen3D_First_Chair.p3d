# Run It Again / The First Chair. Native ProGen3D scene, Y up, front is +Z.
# RockerStudy(draft slats). draft=1 matches the image, draft=0 finishes the timber frame.
# slats=3 matches the reference; 2 through 5 all fit the same back frame.
# Model units are metres. Dimensions and hidden joinery are inferred from one image.
# The drafting mat is fixed. Orbit from +X, +Y, +Z for the illustrated three-quarter view.
Start -> RockerStudy(1 3)

RockerStudy(draft slats) ->
 [ Object(id(ChairStudy) class(FurnitureStudy) taxonomy(Design Study Rocker) layer(Furniture)) [
 [ Object(id(DraftingMat) class(GriddedCuttingMat) taxonomy(Design Study Rocker GriddedCuttingMat) layer(Terrain)) [ Mat ] ]
 [ Object(id(FloorSample) class(PlankSample) taxonomy(Design Study Rocker PlankSample) layer(Terrain)) [ Course(8) ] ]
 [ Object(id(Seat) class(CarvedSeat) taxonomy(Design Study Rocker CarvedSeat) layer(Furniture)) [ SeatShell ] ]
 [ Object(id(BackBow) class(BentBackFrame) taxonomy(Design Study Rocker BentBackFrame) layer(Furniture)) [ Bow ] ]
 [ Object(id(BackSlats) class(ShapedBackSlats) taxonomy(Design Study Rocker ShapedBackSlats) layer(Furniture)) [ Slats(slats) ] ]
 [ Object(id(LowerFrame) class(StretchersAndAprons) taxonomy(Design Study Rocker StretchersAndAprons) layer(Furniture)) [ Joinery ] ]
 [ Object(id(FarSide) class(TimberSideFrame) taxonomy(Design Study Rocker TimberSideFrame) layer(Furniture)) [ T(-0.266 0 0) Runner ArmLeg HindFoot ] ]
 [ Object(id(NearSide) class(TimberSideFrame) taxonomy(Design Study Rocker TimberSideFrame) layer(Furniture)) [ T(0.266 0 0) Near(draft) ] ]
 [ Object(id(Pegs) class(WoodenJointPlugs) taxonomy(Design Study Rocker WoodenJointPlugs) layer(Furniture)) [ PegSet(-1) PegSet(1) ] ]
 [ Object(id(Construction) class(ControlCurves) taxonomy(Design Study Rocker ControlCurves) layer(Equipment)) [ Overlay(draft) ] ]
 ] ]

Near(draft) -> ?(draft>0.5) [ FrontFoot ] : [ Runner ArmLeg HindFoot ]
Overlay(draft) -> ?(draft>0.5) [ T(0.266 0 0) Edges Handles ] : [ ]

# Fine lines stand just proud of the mat. Plank top and tangent of each wooden runner meet at Y=0.
Mat ->
 [ T(0 -0.040 0) S(2.10 0.014 1.85) !I(Cube material(blacktealmattepaint) 1 0.4) ]
 [ GridX(41) ] [ GridZ(37) ]
GridX(n) n -> [ T((GridX_count-20)*0.05 -0.0328 0) S(0.0011 0.0009 1.85) !I(Cube material(tealgreymattepaint) 1 0.4) ]
GridZ(n) n -> [ T(0 -0.0327 (GridZ_count-18)*0.05) S(2.10 0.0009 0.0011) !I(Cube material(tealgreymattepaint) 1 0.4) ]
Course(n) n -> [ T(0 -0.0165 (Course_count-(n-1)/2)*0.144) Board(Course_count) ]
Board(i) -> ?(wrap(i,0,3)<0.5)
 [ S(1.152 0.033 0.1428) !I(Cube material(brownwalnutwood) 1 0.3) ]
 : [ S(1.152 0.033 0.1428) !I(Cube material(browncedarwood) 1 0.3) ]

# Every slat has the same bent and tapered profile. Their centres fan out towards the crown.
Slats(n) n -> [ SlatAt((Slats_count+0.5)/n*2-1 n) ]
SlatAt(q n) -> [ T(q*0.213 0 0.024*q*q) A(0-2.1*q 2) S(3/n 1 1) BackSlat ]

