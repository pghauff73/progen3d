# One wooden standard forms both the tall arm support and its inboard shelf.
# The outer face stays fair as the inner face sweeps out beneath the cushion.
# The station above the shelf recedes inside the cushion. The last six rings
# roll the shoulder into a small rounded top. The glides sit directly below.
SideStandard(h) ->
    [ FrontGlide ]
    !I(VariableSectionSweep(
        path(0 3 0  0 h 0)
        station(0 RoundedRect 48 112 12 7)
        station(1.5/(h-3) RoundedRect 50 114 13 7)
        station(6/(h-3) RoundedRect 52 116 14 7)
        station(33/(h-3) RoundedRect 52 116 14 7)
        station(51/(h-3) RoundedRect 55 117 14 7)
        stationTransform(51/(h-3) -1.5 0 1 1 0)
        station(63/(h-3) RoundedRect 60 118 15 7)
        stationTransform(63/(h-3) -4 0 1 1 0)
        station(73/(h-3) RoundedRect 69 120 15 7)
        stationTransform(73/(h-3) -8.5 0 1 1 0)
        station(80/(h-3) RoundedRect 82 121 16 7)
        stationTransform(80/(h-3) -15 0 1 1 0)
        station(86/(h-3) RoundedRect 105 122 16 7)
        stationTransform(86/(h-3) -26.5 0 1 1 0)
        station(89/(h-3) RoundedRect 145 122 16 7)
        stationTransform(89/(h-3) -46.5 0 1 1 0)
        station(93/(h-3) RoundedRect 193 123 17 7)
        stationTransform(93/(h-3) -70.5 0 1 1 0)
        station(101/(h-3) RoundedRect 202 124 17 7)
        stationTransform(101/(h-3) -75 0 1 1 0)
        station(111/(h-3) RoundedRect 189 124 17 7)
        stationTransform(111/(h-3) -68.5 0 1 1 0)
        station(119/(h-3) RoundedRect 146 124 17 7)
        stationTransform(119/(h-3) -47 0 1 1 0)
        station(129/(h-3) RoundedRect 94 124 16 7)
        stationTransform(129/(h-3) -21 0 1 1 0)
        station(146/(h-3) RoundedRect 61 123 15 7)
        stationTransform(146/(h-3) -4.5 0 1 1 0)
        station(177/(h-3) RoundedRect 51 122 15 7)
        station(0.56 RoundedRect 49 119 15 7)
        stationTransform(0.56 -0.5 0 1 1 0)
        station(0.82 RoundedRect 48 116 15 7)
        stationTransform(0.82 -1 0 1 1 0)
        station((h-22)/(h-3) RoundedRect 47 114 16 7)
        stationTransform((h-22)/(h-3) -1.5 0 1 1 0)
        station((h-15)/(h-3) RoundedRect 46 113 16 7)
        stationTransform((h-15)/(h-3) -1.5 0 1 1 0)
        station((h-10)/(h-3) RoundedRect 44 109 16 7)
        stationTransform((h-10)/(h-3) -1.5 0 1 1 0)
        station((h-6)/(h-3) RoundedRect 39 101 16 7)
        stationTransform((h-6)/(h-3) -1.5 0 1 1 0)
        station((h-4)/(h-3) RoundedRect 33 93 15 7)
        stationTransform((h-4)/(h-3) -1.5 0 1 1 0)
        station(1 RoundedRect 25 84 11 7)
        stationTransform(1 -1.5 0 1 1 0)
        up(0 0 -1) frame(referenceAligned) cap(all))
       material(lightoakverticalwood) 1 1)

FrontGlide ->
    [ A(-90 0)
      !I(Loft(section(0 RoundedRect 45 108 12 6)
              section(1 RoundedRect 48 111 13 6)
              section(3 RoundedRect 48 112 13 6) cap(all))
         material(blackmatteplastic) 1 1) ]

# Symmetric rear feet stay tucked under the upholstered body. The unseen
# mounting rails terminate over these feet and enter the integral front ledges.
Undercarriage ->
    [ T(-223 0 -192) RearFoot ]
    [ T(223 0 -192) RearFoot ]
    [ T(-233 0 -10) Bearer ]
    [ T(233 0 -10) Bearer ]

RearFoot ->
    [ A(-90 0)
      !I(Loft(section(0 RoundedRect 42 62 11 6)
              section(3 RoundedRect 45 65 12 6) cap(all))
         material(blackmatteplastic) 1 1)
      !I(Loft(section(3 RoundedRect 45 65 12 6)
              section(8 RoundedRect 49 70 13 6)
              section(97 RoundedRect 57 83 15 6)
              section(116 RoundedRect 62 86 17 6) cap(all))
         material(lightoakverticalwood) 1 1) ]

Bearer ->
    [ A(-90 0)
      !I(Loft(section(97 RoundedRect 48 465 18 6)
              section(100 RoundedRect 55 472 20 6)
              section(120 RoundedRect 55 472 20 6) cap(all))
         material(lightoakwood) 1 1) ]
