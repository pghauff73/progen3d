# WRAPAROUND LOUNGE CHAIR
# Single-view reconstruction from the supplied photograph, 904.jpg.
# Native ProGen3D desktop. World axes: X across, Y up, +Z toward the open front.
# Edit the four Start arguments: overall width (mm), depth (mm), seat crown
# height (mm), and back rise (mm from the arm datum to the rear centre).
# Defaults are photographic estimates. Suggested editing range: 760-1000 mm wide,
# 710-930 mm deep, 370-460 mm seat height, 30-85 mm back rise.
# The nominal model is 890 mm wide, 825 mm deep and 696 mm tall.
# Profiles are in millimetres. LoungeChair converts the finished chair to metres.
# Four ground contacts and the recessed underframe are inferred from the image.
# The native beige rough finish stands in for the photographed looped fabric.

Start -> LoungeChair(890 825 410 58)

LoungeChair(width depth seatHeight backRise) ->
    [ S(0.001 0.001 0.001)
      S(width/832 1 depth/772.578)
      [ T(0 96 7) S(1 (seatHeight-96)/314 1) SeatCushion ]
      [ T(0 seatHeight+124 0) Horseshoe(backRise) ]
      [ T(390 0 188) SideStandard(seatHeight+169) ]
      [ T(-390 0 188) A(180 1) SideStandard(seatHeight+169) ]
      Undercarriage
    ]

# The lowest outline closes the underside. The last forms a small flat at the crown.
# Progressively smaller outlines turn the top into a shallow dome. The three
# closely spaced rings near 226 mm form the recessed boxing seam.
SeatCushion ->
    [ A(-90 0)
      !I(Loft(
        section(0 RoundedRect 554 484 159 11)
        section(2 RoundedRect 593 523 166 11)
        section(6 RoundedRect 636 565 176 11)
        section(13 RoundedRect 677 609 190 11)
        section(23 RoundedRect 708 643 204 11)
        section(36 RoundedRect 738 672 211 11)
        section(52 RoundedRect 757 695 222 11)
        section(74 RoundedRect 774 716 229 11)
        section(102 RoundedRect 783 730 232 11)
        section(140 RoundedRect 789 739 238 11)
        section(184 RoundedRect 790 742 243 11)
        section(210 RoundedRect 788 743 245 11)
        section(225 RoundedRect 785.8 741.2 244 11)
        section(226.8 RoundedRect 784.4 739.8 243.6 11)
        section(228.6 RoundedRect 785.1 740.5 244 11)
        section(244 RoundedRect 781 737 243 11)
        section(259 RoundedRect 775 731 241 11)
        section(272 RoundedRect 766 722 237 11)
        section(283 RoundedRect 749 705 232 11)
        section(293 RoundedRect 718 674 222 11)
        section(301 RoundedRect 662 621 205 11)
        section(307 RoundedRect 556 521 173 11)
        section(311 RoundedRect 421 394 132 11)
        section(313 RoundedRect 270 254 86 11)
        section(314 RoundedRect 110 104 35 11)
        cap(all)) material(oatmealbeigeroughcloth) 1 1) ]

# The horseshoe is one closed swept solid, open toward the front of the chair.
# Its path follows the horizontal midline from the left tip around to the right.
# Stations are arc-length fractions. The section softens and shrinks into each
# tip. Vertical station offsets raise the rear while retaining a level arm end.
# Each unit rounded rectangle is scaled to its local half-width and half-height.
# The final rotation leans the upper edge outwards at the back. A shallow
# compression at station 0.5 suggests the centre-back join.
