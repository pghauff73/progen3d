# Coruscant Component_24 semantic decomposition
# Source: coruscant-city-20.zip -> source/city+5.zip -> model.dae
# Source node: Component_24 / ID3049
# Source geometry: 98 instance_geometry elements, ~27.239 normalized units high.
# Normalization used here: 10,000 COLLADA source units = 1 Progen3D unit.
# Axis mapping: COLLADA X -> Progen3D X; COLLADA Z(up) -> Progen3D Y; COLLADA Y -> Progen3D Z.
#
# IMPORTANT: dimensions/offsets below are source-derived or slice-derived.
# Material choices and replacement of continuous/irregular surfaces by Cube/Sphere
# are a Progen3D approximation using the current executable primitive set.

Start ->
    CoruscantTower24(0 0)

CoruscantTower24(px pz) ->
    Tower24Base(px pz)
    Tower24LowerBody(px pz)
    Tower24MainShaft(px pz)
    Tower24Crown(px pz)
    Tower24Spire(px pz)
    Tower24FacadeRibs(px pz)

# Source main shell ID3050:
# z=0.0..1.424, cross-section about 1.883 x 1.883.
Tower24Base(px pz) ->
[
    T(px 0 pz)
    S(1.883 1.424 1.883)
    !I(Cube material(darkslateroughmetal) 1 0.42)
]

# Source slice: z=1.424..2.957, about 1.672 x 1.672.
Tower24LowerBody(px pz) ->
[
    T(px+0.006 1.424 pz+0.006)
    S(1.672 1.533 1.672)
    !I(Cube material(charcoalsmoothmetal) 1 0.38)
]
[
    T(px+0.037 2.957 pz+0.037)
    S(1.545 0.28 1.545)
    !I(Cube material(silverblueroughmetal) 1 0.30)
]

# Source slice: approximately z=3.3..22.472,
# dominant cross-section about 1.485 x 1.485.
Tower24MainShaft(px pz) ->
[
    T(px+0.037 3.237 pz+0.037)
    S(1.485 19.235 1.485)
    !I(Cube material(darkslatesmoothmetal) 1 0.34)
]
[
    T(px+0.037 8.0 pz+0.037)
    S(1.535 0.16 1.535)
    !I(Cube material(silverbluepolishedmetal) 1 0.28)
]
[
    T(px+0.037 14.0 pz+0.037)
    S(1.535 0.16 1.535)
    !I(Cube material(silverbluepolishedmetal) 1 0.28)
]
[
    T(px+0.037 20.0 pz+0.037)
    S(1.535 0.16 1.535)
    !I(Cube material(silverbluepolishedmetal) 1 0.28)
]

# The source crown narrows mainly on one horizontal axis before contracting
# on both axes. These steps follow sampled cross-sections of ID3050.
Tower24Crown(px pz) ->
[
    T(px+0.037 22.472 pz+0.045)
    S(1.485 0.394 1.382)
    !I(Cube material(silverbluesmoothmetal) 1 0.30)
]
[
    T(px+0.037 22.866 pz+0.037)
    S(1.485 1.437 1.232)
    !I(Cube material(silverbluesmoothmetal) 1 0.30)
]
[
    T(px+0.037 24.303 pz+0.068)
    S(1.485 0.416 1.083)
    !I(Cube material(bluewhiteshinysmoothmetal) 1 0.27)
]
[
    T(px+0.037 24.719 pz+0.033)
    S(1.485 0.293 0.994)
    !I(Cube material(bluewhiteshinysmoothmetal) 1 0.27)
]
[
    T(px+0.045 25.012 pz-0.028)
    S(1.382 0.642 0.854)
    !I(Cube material(silverbluepolishedmetal) 1 0.25)
]

# Upper source shell contracts rapidly and shifts off the lower centerline.
Tower24Spire(px pz) ->
[
    T(px-0.176 25.654 pz+0.070)
    S(0.806 0.346 0.626)
    !I(Cube material(silverbluepolishedmetal) 1 0.23)
]
[
    T(px-0.097 26.000 pz+0.038)
    S(0.648 0.300 0.562)
    !I(Cube material(silverbluepolishedmetal) 1 0.22)
]
[
    T(px-0.041 26.300 pz+0.038)
    S(0.536 0.300 0.562)
    !I(Cube material(bluewhiteshinysmoothmetal) 1 0.21)
]
[
    T(px+0.038 26.600 pz+0.038)
    S(0.433 0.200 0.433)
    !I(Cube material(bluewhiteshinysmoothmetal) 1 0.20)
]
[
    T(px+0.038 26.800 pz+0.038)
    S(0.329 0.318 0.329)
    !I(Cube material(silverbluepolishedmetal) 1 0.18)
]
[
    # Source top cap ID3060: 0.261 x 0.261 x 0.121.
    # Sphere is centered, unlike Cube/Cylinder which rise from local Y=0.
    T(px+0.038 27.1785 pz+0.038)
    S(0.261 0.121 0.261)
    !I(Sphere material(bluewhiteglossysmoothglass) 0.86 0.18)
]

# Selected real façade/detail meshes approximated as long rectangular ribs.
# ID3118: span 1.424..21.410, ext 0.149 x 0.194.
# ID3158: span 1.424..21.410, ext 0.131 x 0.180.
# ID3188: span 1.424..24.863, ext 0.194 x 0.149.
# ID3258: span 1.424..24.863, ext 0.180 x 0.139.
# ID3198: span 0.679..26.575, ext 0.528 x 0.429.
