# =====================================================================
# FIRST FLOOR INTERIOR
# Source images do not fully define this level. It is treated as an
# upper lounge/gallery around the double-height stair volume.
# =====================================================================

FirstFloorInterior() ->
    FirstFloorFinish()
    FirstFloorGallery()
    FirstFloorLounge()
    FirstFloorPartitions()

FirstFloorFinish() ->
    Timber(1.30 3.28 0.20 12.50 0.08 10.1)

