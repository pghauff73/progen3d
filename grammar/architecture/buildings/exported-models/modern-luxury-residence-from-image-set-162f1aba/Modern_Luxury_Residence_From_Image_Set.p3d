# =====================================================================
# MODERN LUXURY RESIDENCE — MULTI-IMAGE ARCHITECTURAL GRAMMAR
# Current Progen3D syntax
#
# SOURCE BASIS
# ------------
# Exterior reference views:
#   front elevation
#   rear elevation with pool/patio
#   left/front oblique
#   right/front oblique
#
# Interior reference views:
#   double-height foyer + floating stair
#   living room
#   kitchen
#   dining room
#   bedroom
#   bathroom
#
# SOURCE-DERIVED DESIGN LANGUAGE
# ------------------------------
#   exposed pale concrete
#   charcoal metal framing
#   warm timber soffits and slats
#   dark stacked-stone accent walls
#   large black-framed glazing
#   glass balcony rails
#   flat roof / deep framed balconies
#   full-height privacy louvers
#   rear garden terrace and pool
#   warm timber cabinetry
#   stone/marble floors and counters
#
# INFERRED / NOT DIRECTLY SHOWN
# -----------------------------
#   exact floor-plan dimensions
#   exact internal partition positions
#   hidden utility/service rooms
#   exact upper-floor room allocation
#   structural sizing
#
# These are kept deliberately simple so visible evidence dominates.
#
# Coordinate convention:
#   X = left/right
#   Y = vertical
#   Z = front/back
#   front facade at Z = -5.5
#   rear facade  at Z = +5.5
#
# Approximate overall:
#   width          16.0
#   depth          11.0
#   floor height    3.2
#   three levels    9.6
# =====================================================================


Start ->
    Residence()


Residence() ->
    Site()
    StructuralShell()
    ExteriorEnvelope()
    GroundFloorInterior()
    FirstFloorInterior()
    SecondFloorInterior()
    VerticalCirculation()
    RearAmenity()
    FrontLandscape()


# =====================================================================
# REUSABLE MATERIAL / GEOMETRY HELPERS
# =====================================================================

Concrete(x y z sx sy sz) ->
[
    T(x y z)
    S(sx sy sz)
    !I(Cube material(lightgreyroughconcrete) 1 0.36)
]

WhitePlaster(x y z sx sy sz) ->
[
    T(x y z)
    S(sx sy sz)
    !I(Cube material(warmwhitematteplaster) 1 0.32)
]

DarkMetal(x y z sx sy sz) ->
[
    T(x y z)
    S(sx sy sz)
    !I(Cube material(charcoalroughmetal) 1 0.20)
]

PolishedMetal(x y z sx sy sz) ->
[
    T(x y z)
    S(sx sy sz)
    !I(Cube material(silverbluepolishedmetal) 1 0.18)
]

Timber(x y z sx sy sz) ->
[
    T(x y z)
    S(sx sy sz)
    !I(Cube material(amberwarmwood) 1 0.22)
]

Glass(x y z sx sy sz) ->
[
    T(x y z)
    S(sx sy sz)
    !I(Cube material(bluewhiteglossysmoothglass) 0.64 0.16)
]

Stone(x y z sx sy sz) ->
[
    T(x y z)
    S(sx sy sz)
    !I(Cube material(lightgreyroughconcrete) 1 0.14)
]

WarmStone(x y z sx sy sz) ->
[
    T(x y z)
    S(sx sy sz)
    !I(Cube material(offwhiteceramic) 1 0.18)
]

BlackGlass(x y z sx sy sz) ->
[
    T(x y z)
    S(sx sy sz)
    !I(Cube material(charcoalroughmetal) 0.82 0.16)
]

Green(x y z sx sy sz) ->
[
    T(x y z)
    S(sx sy sz)
    !I(Cube material(greenmattepaint) 1 0.24)
]

Water(x y z sx sy sz) ->
[
    T(x y z)
    S(sx sy sz)
    !I(Cube material(bluewhiteglossysmoothglass) 0.72 0.12)
]


# =====================================================================
# SITE
# =====================================================================

Site() ->
    SiteGround()
    FrontDrive()
    FrontEntryPath()
    RearGardenGround()


SiteGround() ->
    Concrete(0 -0.34 0 19.0 0.30 14.0)

FrontDrive() ->
    Concrete(4.70 -0.10 -6.90 5.60 0.12 2.70)

FrontEntryPath() ->
    WarmStone(-1.90 -0.08 -6.85 3.10 0.12 2.60)

RearGardenGround() ->
    Green(0 -0.18 7.70 15.8 0.18 4.10)


# =====================================================================
# STRUCTURAL SHELL
# =====================================================================

StructuralShell() ->
    FoundationSlab()
    FloorSlabs()
    SideStructuralWalls()
    RearStructuralPiers()
    RoofSlab()


FoundationSlab() ->
    Concrete(0 -0.12 0 16.0 0.24 11.0)

FloorSlabs() ->
    Concrete(0 3.20 0 16.0 0.22 11.0)
    Concrete(0 6.40 0 16.0 0.22 11.0)

RoofSlab() ->
    Concrete(0 9.60 0 16.0 0.22 11.0)

SideStructuralWalls() ->
    Concrete(-7.88 0.12 0 0.24 9.46 11.0)
    Concrete(7.88 0.12 0 0.24 9.46 11.0)

RearStructuralPiers() ->
    Concrete(-7.30 0.12 5.40 0.72 9.45 0.35)
    Stone(7.28 0.12 5.40 0.78 9.45 0.42)


# =====================================================================
# EXTERIOR ENVELOPE
# =====================================================================

ExteriorEnvelope() ->
    FrontFacade()
    RearFacade()
    LeftFacade()
    RightFacade()
    RoofFrame()


