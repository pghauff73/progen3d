    DarkMetal(cx-w/2 y -5.60 0.08 h 0.16)
    DarkMetal(cx+w/2 y -5.60 0.08 h 0.16)
    DarkMetal(cx y -5.60 w 0.08 0.16)
    DarkMetal(cx y+h-0.08 -5.60 w 0.08 0.16)

BalconyGlass(cx y z w) ->
