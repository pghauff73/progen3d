    Timber(-2.10 0.30 -5.68 1.12 2.40 0.12)
    DarkMetal(-2.78 0.20 -5.70 0.10 2.55 0.15)
    DarkMetal(-1.45 0.20 -5.70 0.10 2.55 0.15)
    DarkMetal(-2.10 2.65 -5.70 1.42 0.10 0.15)
    DarkMetal(-1.66 1.16 -5.80 0.06 0.58 0.06)

FrontGroundCanopy() ->
