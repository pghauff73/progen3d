    DarkMetal(0.00 9.35 5.80 13.80 0.34 0.55)
    Timber(0.20 9.12 -5.62 9.25 0.08 1.15)
    Timber(0.00 9.12 5.62 13.30 0.08 1.05)


# =====================================================================
# GROUND FLOOR INTERIOR
# =====================================================================

GroundFloorInterior() ->
    GroundFloorFinish()
    GroundFloorPartitions()
    Foyer()
    LivingRoom()
    Kitchen()
    DiningRoom()
    GroundServiceCore()


GroundFloorFinish() ->
    WarmStone(0 0.02 0 15.3 0.08 10.3)

GroundFloorPartitions() ->
    # Foyer / garage separator
    Concrete(1.85 0.20 -3.20 0.18 2.78 4.20)
    # Kitchen/service partition
    WhitePlaster(-4.60 0.20 1.05 0.16 2.78 4.20)
    # Short dining/living separator spine
    Stone(0.80 0.20 2.45 0.55 2.50 1.25)


# ---------------------------------------------------------------------
# FOYER + ENTRY
# ---------------------------------------------------------------------

Foyer() ->
    FoyerConsole()
    FoyerArtPanel()
    FoyerPlanter()
    FoyerPendantCluster()

FoyerConsole() ->
    Timber(4.85 0.86 -1.95 2.20 0.22 0.55)
    DarkMetal(4.85 0.73 -1.95 2.20 0.04 0.55)

FoyerArtPanel() ->
    WhitePlaster(4.85 1.55 -2.24 1.15 1.55 0.06)

FoyerPlanter() ->
[
    T(3.75 0.08 -2.05)
    S(0.44 0.64 0.44)
    !I(Cylinder material(charcoalroughmetal) 1 0.16)
]
[
    T(3.75 0.72 -2.05)
    S(0.62 0.62 0.62)
    !I(Sphere material(greenmattepaint) 1 0.22)
]

FoyerPendantCluster() ->
    Pendant(-0.50 2.30 -2.20)
    Pendant(0.20 4.65 -2.00)
    Pendant(-0.25 6.90 -1.75)


