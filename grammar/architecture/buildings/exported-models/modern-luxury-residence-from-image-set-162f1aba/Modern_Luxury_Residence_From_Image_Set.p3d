    Concrete(-4.60 0.10 -5.40 0.55 3.00 0.30)
    Stone(0.55 0.10 -5.52 2.35 2.72 0.34)
    Concrete(1.95 0.10 -5.40 0.35 3.00 0.30)
    Concrete(7.45 0.10 -5.40 0.70 3.00 0.30)

FrontEntry() ->
