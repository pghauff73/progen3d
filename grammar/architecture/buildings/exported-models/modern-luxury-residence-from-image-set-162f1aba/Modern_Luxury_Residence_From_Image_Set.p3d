    DarkMetal(x-0.05 y z+w/2 0.14 h 0.08)
    DarkMetal(x-0.05 y z 0.14 0.08 w)
    DarkMetal(x-0.05 y+h-0.08 z 0.14 0.08 w)

RightVerticalTimberPanel() ->
