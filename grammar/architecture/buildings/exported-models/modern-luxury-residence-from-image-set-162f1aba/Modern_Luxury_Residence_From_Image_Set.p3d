    DarkMetal(cx-w/2 y z-0.03 0.055 0.88 0.09)
    DarkMetal(cx+w/2 y z-0.03 0.055 0.88 0.09)
    DarkMetal(cx y+0.82 z-0.03 w 0.045 0.09)

