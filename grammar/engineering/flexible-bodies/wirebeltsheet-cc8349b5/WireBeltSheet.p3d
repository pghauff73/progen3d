# Z up, length in metres. Play Physics or Step, then Reset Sim to replay.
Start -> G(9.81 0 0 -1) [ T(-1.4 0 0.7) Harness(1.0) ] [ T(0 0 0.55) ReturnBelt(0.65) ] [ T(1.05 0 0.7) Membrane(0.65) ]

Harness(span) ->
    FlexDimensions(span 0.012 0.025) FlexGrid(20 0)
    FlexMaterial(1150 8000000 2.5)
    FlexPin(0 0) FlexPin(20 0)
    I(FlexibleWire material(copper) 1 1)

ReturnBelt(centres) ->
    FlexDimensions(centres 0.09 0.003) FlexGuideRadius(0.14) FlexGrid(32 2) FlexBeltSpeed(0.3)
    FlexMaterial(1100 1600000 2)
    I(FlexibleBelt material(graphite) 1 1)

Membrane(length) ->
    FlexDimensions(length 0.45 0.003) FlexGrid(12 8)
    FlexMaterial(1080 1200000 2.5)
    FlexPin(0 0) FlexPin(0 8) FlexPin(12 0) FlexPin(12 8)
    I(ElasticSheet material(tealmatteceramic) 1 1)
