# NATIVE PROCEDURAL HARDWARE — dimensions are millimetres.
# Caller supplies one root S(0.001 0.001 0.001).
# Analytic cylinders, radial profiles, genuine bores, spheres and swept helices.
# All screw-thread ridges have round preview cross-sections, not ISO flank forms.
# Modelled nominal bores/clearances are visual parameters, not certified fits.

HW_Cylinder(d h) -> [ S(d h d) I(Cylinder(segments(32 1)) material(silverbrushedmetal) 1 1) ]

HW_Ring(od id h) -> [ S(od h od) I(Cylinder(radial(id/od 1) segments(48 1)) material(silverbrushedmetal) 1 1) ]

HW_DarkRing(od id h) -> [ S(od h od) I(Cylinder(radial(id/od 1) segments(48 1)) material(graymattemetal) 1 1) ]

HW_BlackRing(od id h) -> [ S(od h od) I(Cylinder(radial(id/od 1) segments(48 1)) material(blackmatteplastic) 1 1) ]

HW_CopperRing(od id h) -> [ S(od h od) I(Cylinder(radial(id/od 1) segments(48 1)) material(coppermetal) 1 1) ]

HW_GoldRing(od id h) -> [ S(od h od) I(Cylinder(radial(id/od 1) segments(48 1)) material(goldmetal) 1 1) ]

HW_SplitWasher(od id h) -> [ S(od h od) I(Cylinder(radial(id/od 1) azimuth(4 356) segments(48 1)) material(silverbrushedmetal) 1 1) ]

# Hexagonal exterior with a genuinely circular through-bore.

HW_HexNut(flat bore h) -> [ A(-90 0) I(HostedOpening(host(Polygon flat/sqrt(3) 0 flat/(2*sqrt(3)) flat/2 -flat/(2*sqrt(3)) flat/2 -flat/sqrt(3) 0 -flat/(2*sqrt(3)) -flat/2 flat/(2*sqrt(3)) -flat/2) opening(Circle bore/2 32) depth(h) cap(all)) material(silverbrushedmetal) 1 1) ]

HW_LockNut(flat bore h) -> [ HW_HexNut(flat bore h*0.72) ] [ T(0 h*0.72 0) HW_Ring(flat*0.96 bore h*0.28) ] [ T(0 h*0.94 0) HW_BlackRing(flat*0.82 bore h*0.06) ]

# Low polygon spheres inside separate inner and outer races; shields close the faces.

HW_Bearing(od bore h count ballD) -> [ HW_Ring(od od*0.78 h) ] [ HW_Ring(bore*1.6 bore h) ] [ T(0 h/2 0) HW_BearingBalls((od*0.78+bore*1.6)/4 ballD count) ] [ T(0 h*0.025 0) HW_DarkRing(od*0.91 bore*1.25 h*0.045) ] [ T(0 h*0.93 0) HW_DarkRing(od*0.91 bore*1.25 h*0.045) ]

HW_BearingBalls(r d n) n -> [ A(HW_BearingBalls_count*360/n 1) T(r 0 0) S(d d d) I(Sphere(segments(12 8)) material(silverbrushedmetal) 1 1) ]

# Two chamfered V-slot running faces and a central web between 16 mm bearing seats.

HW_VWheel(od width seat web) -> [ I(Revolve(profile(Polygon seat/2+0.1 0 10 0 od/2 2.05 od/2 width-2.05 10 width seat/2+0.1 width seat/2 width-0.1 seat/2 width/2+0.5 web/2 width/2+0.4 web/2 width/2-0.4 seat/2 width/2-0.5 seat/2 0.1) angle(0 360) segments(64) cap(all)) material(blackmatteplastic) 1 1) ]

HW_PanHead(d h socketD) -> [ I(Revolve(profile(Polygon socketD/2 0 d*0.36 0 d*0.47 h*0.30 d/2 h*0.65 d/2 h socketD/2 h) angle(0 360) segments(32) cap(all)) material(silverbrushedmetal) 1 1) ] [ T(0 h*0.68 0) HW_Cylinder(d*0.5 h*0.32) ]

HW_SocketHead(d h flat) -> [ A(-90 0) I(HostedOpening(host(Circle d/2 32) opening(Polygon flat/sqrt(3) 0 flat/(2*sqrt(3)) flat/2 -flat/(2*sqrt(3)) flat/2 -flat/sqrt(3) 0 -flat/(2*sqrt(3)) -flat/2 flat/(2*sqrt(3)) -flat/2) depth(h) cap(all)) material(silverbrushedmetal) 1 1) ] [ T(0 h*0.65 0) HW_Cylinder(d*0.75 h*0.35) ]

