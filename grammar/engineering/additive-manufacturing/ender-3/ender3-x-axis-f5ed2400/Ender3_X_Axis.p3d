# Timing belt parameters: source local endpoints and upper mounting tabs.

AX_M007 -> AX_TimingBelt(-265.6038 120.5883 -131.6121 0.5636 7.1 1.4 6 2 -119.4 -77.5)

AX_TimingBelt(leftX rightX centreY zMin radius thickness width pitch leftEnd rightEnd) ->
    [ T(leftX centreY+radius zMin) AX_BeltRun(leftEnd-leftX thickness width pitch -1) ]
    [ T(rightEnd centreY+radius zMin) AX_BeltRun(rightX-rightEnd thickness width pitch -1) ]
    [ T(leftX centreY-radius zMin) AX_BeltRun(rightX-leftX thickness width pitch 1) ]
    [ T(leftX centreY zMin) A(180 2) AX_BeltArc(radius thickness width) ]
    [ T(rightX centreY zMin) AX_BeltArc(radius thickness width) ]
    [ T(leftEnd centreY+radius+7 zMin+width/2) S(thickness 14 width) I(Cube material(blackmatteplastic) 1 1) ]
    [ T(rightEnd centreY+radius+7 zMin+width/2) S(thickness 14 width) I(Cube material(blackmatteplastic) 1 1) ]

AX_BeltRun(length thickness width pitch side) ->
    [ T(length/2 0 width/2) S(length thickness width) I(Cube material(blackmatteplastic) 1 1) ]
    AX_BeltTeeth(length/pitch length thickness width pitch side)

AX_BeltTeeth(count length thickness width pitch side) count ->
    [ T((AX_BeltTeeth_count+0.5)*pitch side*(thickness/2+0.3) width/2)
      S(1.05 0.65 width) I(Cube material(blackmatteplastic) 1 1) ]

AX_BeltArc(radius thickness width) ->
    [ I(Extrude(Polygon((radius+thickness/2)*cos(radians(-90)) (radius+thickness/2)*sin(radians(-90)) (radius+thickness/2)*cos(radians(-78.75)) (radius+thickness/2)*sin(radians(-78.75)) (radius+thickness/2)*cos(radians(-67.5)) (radius+thickness/2)*sin(radians(-67.5)) (radius+thickness/2)*cos(radians(-56.25)) (radius+thickness/2)*sin(radians(-56.25)) (radius+thickness/2)*cos(radians(-45)) (radius+thickness/2)*sin(radians(-45)) (radius+thickness/2)*cos(radians(-33.75)) (radius+thickness/2)*sin(radians(-33.75)) (radius+thickness/2)*cos(radians(-22.5)) (radius+thickness/2)*sin(radians(-22.5)) (radius+thickness/2)*cos(radians(-11.25)) (radius+thickness/2)*sin(radians(-11.25)) (radius+thickness/2)*cos(radians(0)) (radius+thickness/2)*sin(radians(0)) (radius+thickness/2)*cos(radians(11.25)) (radius+thickness/2)*sin(radians(11.25)) (radius+thickness/2)*cos(radians(22.5)) (radius+thickness/2)*sin(radians(22.5)) (radius+thickness/2)*cos(radians(33.75)) (radius+thickness/2)*sin(radians(33.75)) (radius+thickness/2)*cos(radians(45)) (radius+thickness/2)*sin(radians(45)) (radius+thickness/2)*cos(radians(56.25)) (radius+thickness/2)*sin(radians(56.25)) (radius+thickness/2)*cos(radians(67.5)) (radius+thickness/2)*sin(radians(67.5)) (radius+thickness/2)*cos(radians(78.75)) (radius+thickness/2)*sin(radians(78.75)) (radius+thickness/2)*cos(radians(90)) (radius+thickness/2)*sin(radians(90)) (radius-thickness/2)*cos(radians(90)) (radius-thickness/2)*sin(radians(90)) (radius-thickness/2)*cos(radians(78.75)) (radius-thickness/2)*sin(radians(78.75)) (radius-thickness/2)*cos(radians(67.5)) (radius-thickness/2)*sin(radians(67.5)) (radius-thickness/2)*cos(radians(56.25)) (radius-thickness/2)*sin(radians(56.25)) (radius-thickness/2)*cos(radians(45)) (radius-thickness/2)*sin(radians(45)) (radius-thickness/2)*cos(radians(33.75)) (radius-thickness/2)*sin(radians(33.75)) (radius-thickness/2)*cos(radians(22.5)) (radius-thickness/2)*sin(radians(22.5)) (radius-thickness/2)*cos(radians(11.25)) (radius-thickness/2)*sin(radians(11.25)) (radius-thickness/2)*cos(radians(0)) (radius-thickness/2)*sin(radians(0)) (radius-thickness/2)*cos(radians(-11.25)) (radius-thickness/2)*sin(radians(-11.25)) (radius-thickness/2)*cos(radians(-22.5)) (radius-thickness/2)*sin(radians(-22.5)) (radius-thickness/2)*cos(radians(-33.75)) (radius-thickness/2)*sin(radians(-33.75)) (radius-thickness/2)*cos(radians(-45)) (radius-thickness/2)*sin(radians(-45)) (radius-thickness/2)*cos(radians(-56.25)) (radius-thickness/2)*sin(radians(-56.25)) (radius-thickness/2)*cos(radians(-67.5)) (radius-thickness/2)*sin(radians(-67.5)) (radius-thickness/2)*cos(radians(-78.75)) (radius-thickness/2)*sin(radians(-78.75)) (radius-thickness/2)*cos(radians(-90)) (radius-thickness/2)*sin(radians(-90))) width) material(blackmatteplastic) 1 1) ]
    AX_ArcTeeth(radius thickness width)

AX_ArcTeeth(radius thickness width) 11 ->
    [ A(-90+(AX_ArcTeeth_count+0.5)*180/11 2)
      T(radius-thickness/2-0.3 0 width/2) S(0.65 1.05 width) I(Cube material(blackmatteplastic) 1 1) ]


# Native procedural motors, extruder, carriage, fans and hotend.
# Dimensions are millimetres; parent supplies one S(.001 .001 .001).
# PC_Mnnn wrappers preserve the source component local frame.
# No imported or embedded surface geometry is used.
# Small features are dimensional reconstructions, not manufacturing-certified CAD.
# Material codes: 0 dark metal, 1 steel, 2 plastic, 3 brass, 4 copper, 5 PCB.

PC_EmitBox(m) ->
    ?(m<0.5) I(Cube material(blackmattemetal) 1 1) :
    ?(m<1.5) I(Cube material(silverbrushedmetal) 1 1) :
    ?(m<2.5) I(Cube material(blackmatteplastic) 1 1) :
    ?(m<3.5) I(Cube material(goldmetal) 1 1) :
    ?(m<4.5) I(Cube material(coppermetal) 1 1) :
    I(Cube material(greenmatteplastic) 1 1)

PC_EmitRing(ratio sides m) ->
    ?(m<0.5) I(Cylinder(radial(ratio 1) segments(sides 1)) material(blackmattemetal) 1 1) :
    ?(m<1.5) I(Cylinder(radial(ratio 1) segments(sides 1)) material(silverbrushedmetal) 1 1) :
    ?(m<2.5) I(Cylinder(radial(ratio 1) segments(sides 1)) material(blackmatteplastic) 1 1) :
    ?(m<3.5) I(Cylinder(radial(ratio 1) segments(sides 1)) material(goldmetal) 1 1) :
    ?(m<4.5) I(Cylinder(radial(ratio 1) segments(sides 1)) material(coppermetal) 1 1) :
    I(Cylinder(radial(ratio 1) segments(sides 1)) material(greenmatteplastic) 1 1)

PC_EmitChamfer(w h depth corner m) ->
    ?(m<0.5) I(Extrude(ChamferRect(w h corner) depth) material(blackmattemetal) 1 1) :
    ?(m<1.5) I(Extrude(ChamferRect(w h corner) depth) material(silverbrushedmetal) 1 1) :
    ?(m<2.5) I(Extrude(ChamferRect(w h corner) depth) material(blackmatteplastic) 1 1) :
    ?(m<3.5) I(Extrude(ChamferRect(w h corner) depth) material(goldmetal) 1 1) :
    ?(m<4.5) I(Extrude(ChamferRect(w h corner) depth) material(coppermetal) 1 1) :
    I(Extrude(ChamferRect(w h corner) depth) material(greenmatteplastic) 1 1)

PC_EmitRound(w h depth radius m) ->
    ?(m<0.5) I(Extrude(RoundedRect(w h radius 4) depth) material(blackmattemetal) 1 1) :
    ?(m<1.5) I(Extrude(RoundedRect(w h radius 4) depth) material(silverbrushedmetal) 1 1) :
    ?(m<2.5) I(Extrude(RoundedRect(w h radius 4) depth) material(blackmatteplastic) 1 1) :
    ?(m<3.5) I(Extrude(RoundedRect(w h radius 4) depth) material(goldmetal) 1 1) :
    ?(m<4.5) I(Extrude(RoundedRect(w h radius 4) depth) material(coppermetal) 1 1) :
    I(Extrude(RoundedRect(w h radius 4) depth) material(greenmatteplastic) 1 1)

PC_Box(w h depth m) -> [ S(w h depth) PC_EmitBox(m) ]

PC_RingZ(od id height m sides) -> [ T(0 0 -height/2) A(90 0) S(od height od) PC_EmitRing(id/od sides m) ]

PC_CylinderZ(d height m) -> PC_RingZ(d 0 height m 32)

PC_ChamferZ(w h depth corner m) -> [ T(0 0 -depth/2) PC_EmitChamfer(w h depth corner m) ]

PC_RoundZ(w h depth radius m) -> [ T(0 0 -depth/2) PC_EmitRound(w h depth radius m) ]

# NEMA-size motor. Front mounting face is local Z=0; shaft points +Z.

PC_MotorZ(face body shaft) ->
    [ T(0 0 -body+2.5) PC_ChamferZ(face face 5 3 1) ]
    [ T(0 0 -body/2) PC_ChamferZ(face-.6 face-.6 body-10 3 0) ]
    [ T(0 0 -2.5) PC_ChamferZ(face face 5 3 1) ]
    [ T(0 0 1) PC_RingZ(22 5 2 1 40) ]
    [ T(0 0 shaft/2) PC_CylinderZ(5 shaft 1) ]
    [ T(-face/2-4.35 0 -body/2) PC_Box(8.7 12 21 2) ]

PC_M003 -> PC_MotorZ(42 33.75 20)

PC_M023 -> [ T(75.500002 41.526432 -56.400003) A(-90 0) A(-90 2) PC_MotorZ(42 40 24) ]

# Open switch/motor support bracket: triangular web, edge arms and bored bosses.
# Source is a 42 x 42 x 34 open bracket, not a 42 mm solid block.

PC_M006 ->
    [ I(Extrude(Polygon(-21 -21 21 -21 -21 21) 1.8) material(blackmatteplastic) 1 1) ]
    [ T(-19.5 0 17.9) PC_Box(3 42 32.2 2) ]
    [ T(0 -19.5 17.9) PC_Box(42 3 32.2 2) ]
    [ T(-15.5 15.5 17) PC_RingZ(8 3.2 34 2 24) ]
    [ T(15.5 -15.5 17) PC_RingZ(8 3.2 34 2 24) ]
    [ T(-15.5 -15.5 2.5) PC_RingZ(8 3.2 5 2 24) ]
    [ T(15.5 15.5 2.5) PC_RingZ(8 3.2 5 2 24) ]
    PC_BracketRibs

PC_BracketRibs 4 ->
    [ T(-14+PC_BracketRibs_count*7 -14+PC_BracketRibs_count*7 7) A(45 2) PC_Box(2.2 9 10 2) ]

# PCB, microswitch body and actuating leaf. The board fixes the 26 x 20 envelope.

PC_M008 ->
    [ T(-1 0 -1) PC_ChamferZ(26 20 2 1 5) ]
    [ T(-2 -2 5) PC_RoundZ(20 10 6 1 2) ]
    [ T(-1 4.7 8.7) PC_Box(23 2 .6 1) ]
    PC_SwitchContacts

PC_SwitchContacts 3 ->
    [ T(5+PC_SwitchContacts_count*2.5 6 3) PC_Box(1 5 6 1) ]

# The helix uses an analytic SweepDisk; no spring force or plastic deformation model.

PC_M026 -> [ T(0 0 8.55687) A(90 0) PC_SpringY(7.7 1.2 17.11374 7) ]

# Local CAD frames of these two extruder parts contain a rotation.
# The inverse rotations below reconstruct simple engineering axes.

PC_M028 -> [ T(19.250256 -38.456863 4.640830) A(90 0) A(22.522674 1) PC_ExtruderHousing ]

PC_ExtruderHousing ->
    [ T(0 -7.6875 0) A(-90 0) I(HostedOpening(host(ChamferRect 42 42 3.51) opening(Circle 11.5 32) depth(4) cap(all)) material(blackmatteplastic) 1 1) ]
    [ T(0 -3.6875 0) A(-90 0) I(HostedOpening(host(ChamferRect 42 42 3.51) opening(Circle 18.5 40) depth(11.375) cap(all)) material(blackmatteplastic) 1 1) ]
    [ T(-15.5 1 -15.5) A(-90 0) PC_RingZ(9 3.2 13.375 2 24) ]
    [ T(15.5 1 -15.5) A(-90 0) PC_RingZ(9 3.2 13.375 2 24) ]

PC_M029 -> [ T(9.464841 -37.333834 6.399580) S(.847585 .990774 1) T(0 4.004868 0) A(90 0) A(27.137544 1) PC_ExtruderLever ]

PC_ExtruderLever ->
    [ T(6 5.42625 20) A(90 0) I(HostedOpening(host(Polygon -19.56027 -48.32825 -10 -48.32825 -10 -8 7.56027 -8 7.56027 8.32825 -19.56027 8.32825) opening(Circle 2.5 24) depth(3) cap(all)) material(blackmattemetal) 1 1) ]
    [ T(6 0 20) A(-90 0) PC_RingZ(15 5 10.8525 0 32) ]
    [ T(-9 1 -23) PC_Box(8 6 8 0) ]

PC_M031 -> [ T(-184.511088 -57.600062 191.526435) A(90 1) PC_PneumaticSmallZ ]

PC_PneumaticSmallZ ->
    [ T(0 0 -5) PC_RingZ(6 4 5 1 32) ]
    [ T(0 0 0) PC_RingZ(9.237604 4 5 1 6) ]
    [ T(0 0 4) PC_RingZ(7.5 4 3 1 32) ]
    [ T(0 0 6.25) PC_RingZ(8 4 2.5 2 32) ]

# Carriage plate with wheel mounting bores and two folded rear belt tabs.

PC_M041 ->
    [ I(HostedOpening(host(Polygon -32 -25 -25 -32 25 -32 32 -25 32 25 25 32 -25 32 -32 25) opening(Circle 8 32) depth(2.5) cap(all)) material(blackmattemetal) 1 1) ]
    [ T(-20 20.1 2.75) PC_RingZ(12 5.2 8.5 0 32) ]
    [ T(20 20.1 2.75) PC_RingZ(12 5.2 8.5 0 32) ]
    [ T(0 -20.1 2.75) PC_RingZ(12 7.2 8.5 0 32) ]
    [ T(-22 -17.5 -10.2) PC_Box(3 5 20.4 0) ]
    [ T(22 -17.5 -10.2) PC_Box(3 5 20.4 0) ]
    [ T(-18 -17.5 -19.4) PC_Box(8 5 2 0) ]
    [ T(18 -17.5 -19.4) PC_Box(8 5 2 0) ]

# Axial fan: real annular opening, seven analytic blade polygons and three spokes.
# Blade count and dimensions are editable construction parameters.

PC_AxialFanZ(face depth blades) ->
    [ T(0 0 -depth/2) I(HostedOpening(host(RoundedRect face face 2 4) opening(Circle face*.4375 40) depth(depth) cap(all)) material(blackmatteplastic) 1 1) ]
    [ PC_CylinderZ(face*.30 depth*.65 2) ]
    PC_FanBlades(face depth blades)
    PC_FanSpokes(face depth)

PC_FanBlades(face depth n) n ->
    [ A(360*PC_FanBlades_count/n 2) T(0 0 -depth*.06) I(Extrude(Polygon(face*.13 -face*.045 face*.355 -face*.175 face*.422 -face*.08 face*.22 face*.06) depth*.12) material(blackmatteplastic) 1 1) ]

PC_FanSpokes(face depth) 3 ->
    [ A(120*PC_FanSpokes_count 2) T(face*.285 0 depth*.41) A(18 2) PC_Box(face*.30 face*.0375 depth*.10 2) ]

PC_M042 -> [ T(246.666677 189.777784 -64.000005) A(90 1) PC_AxialFanZ(40 8.888885 7) ]

PC_M045 -> [ T(108.191721 23.577509 -5.734341) A(55 0) PC_AxialFanZ(40 10 7) ]

# Open-backed fan cover; both fan apertures are actual holes.

PC_M043 ->
    [ T(-1.5 .8 0) I(HostedOpening(host(Polygon -24 -22.9 33 -22.9 33 26 27 31.79767 -24 31.79767) opening(Circle 18.5 40) depth(.8) cap(all)) material(blackmatteplastic) 1 1) ]
    [ T(-25.5 1.5 22.5) A(90 1) I(HostedOpening(host(Polygon -22.5 -23.6 22.5 -23.6 22.5 31.09767 -22.5 31.09767) opening(Circle 18.5 40) depth(.8) cap(all)) material(blackmatteplastic) 1 1) ]
    [ T(-9 31.79767 31.5) A(-90 0) I(HostedOpening(host(Polygon -16.5 -13.5 40.5 -13.5 40.5 31.5 -16.5 31.5) opening(Circle 6 32) depth(.8) cap(all)) material(blackmatteplastic) 1 1) ]
    [ T(31.1 5.248835 22.5) PC_Box(.8 54.69767 45 2) ]
    [ T(3 27 42.5) PC_Box(57 9.2 5 2) ]

# Hollow rectangular air channel. The source-specific wall curvature is simplified.

PC_M044 ->
    [ T(-20 .011278 -.225) A(90 1) I(HostedOpening(host(RoundedRect 9.65 9.977444 .8 4) opening(Rect 7.25 7.577444) depth(40) cap(all)) material(blackmatteplastic) 1 1) ]

# Heatsink: ten 1 mm fins at 1.8 mm pitch, bored core and end blocks.

PC_M046 ->
    [ T(0 0 -4) I(HostedOpening(host(RoundedRect 12 20 2 4) opening(Circle 2 24) depth(5.6) cap(all)) material(silverbrushedmetal) 1 1) ]
    [ T(0 0 9.9) PC_RingZ(8 4 27.8 1 32) ]
    PC_HeatFins(10 1.8 1 12 20)
    [ T(0 0 19.8) I(HostedOpening(host(RoundedRect 12 20 2 4) opening(Circle 2 24) depth(4) cap(all)) material(silverbrushedmetal) 1 1) ]

PC_HeatFins(n pitch thick w h) n ->
    [ T(0 0 2.6+PC_HeatFins_count*pitch) I(HostedOpening(host(RoundedRect w h 2 4) opening(Circle 2 24) depth(thick) cap(all)) material(silverbrushedmetal) 1 1) ]

# Nozzle: a continuous revolved taper with a 0.4 mm outlet and drilled inner funnel.
# Hex flats are a six-sided native radial cylinder; thread geometry is schematic.

PC_M047 ->
    [ A(90 0) I(Revolve(profile(Polygon 2.5 -5 3 -4.5 3 4 .45 8 .2 8 .2 7.2 1 6.4 1.5 -5) angle(0 360) segments(40) cap(all)) material(goldmetal) 1 1) ]
    [ T(0 0 2) PC_RingZ(6.928204 3 4 3 6) ]

# Heater block with a drilled nozzle passage.
# Outer dimensions are source measured; cartridge bore and small threads are simplified.

PC_M048 ->
