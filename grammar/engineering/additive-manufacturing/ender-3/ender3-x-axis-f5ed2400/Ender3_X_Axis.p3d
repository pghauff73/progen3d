HW_DarkThreadedShaft(d length pitch) -> [ HW_DarkCylinder(d-pitch*0.52 length) ] [ HW_DarkThreadTurns(d length pitch floor((length-pitch*0.26)/pitch)) ]

HW_DarkThreadTurns(d length pitch n) n -> [ T(0 pitch*0.13+HW_DarkThreadTurns_count*pitch 0) HW_DarkHelixTurn(d pitch) ]

HW_DarkHelixTurn(d pitch) -> [ I(SweepDisk(path((d/2-pitch*0.13)*cos(6.283185307179586*0/12) pitch*0/12 (d/2-pitch*0.13)*sin(6.283185307179586*0/12) (d/2-pitch*0.13)*cos(6.283185307179586*1/12) pitch*1/12 (d/2-pitch*0.13)*sin(6.283185307179586*1/12) (d/2-pitch*0.13)*cos(6.283185307179586*2/12) pitch*2/12 (d/2-pitch*0.13)*sin(6.283185307179586*2/12) (d/2-pitch*0.13)*cos(6.283185307179586*3/12) pitch*3/12 (d/2-pitch*0.13)*sin(6.283185307179586*3/12) (d/2-pitch*0.13)*cos(6.283185307179586*4/12) pitch*4/12 (d/2-pitch*0.13)*sin(6.283185307179586*4/12) (d/2-pitch*0.13)*cos(6.283185307179586*5/12) pitch*5/12 (d/2-pitch*0.13)*sin(6.283185307179586*5/12) (d/2-pitch*0.13)*cos(6.283185307179586*6/12) pitch*6/12 (d/2-pitch*0.13)*sin(6.283185307179586*6/12) (d/2-pitch*0.13)*cos(6.283185307179586*7/12) pitch*7/12 (d/2-pitch*0.13)*sin(6.283185307179586*7/12) (d/2-pitch*0.13)*cos(6.283185307179586*8/12) pitch*8/12 (d/2-pitch*0.13)*sin(6.283185307179586*8/12) (d/2-pitch*0.13)*cos(6.283185307179586*9/12) pitch*9/12 (d/2-pitch*0.13)*sin(6.283185307179586*9/12) (d/2-pitch*0.13)*cos(6.283185307179586*10/12) pitch*10/12 (d/2-pitch*0.13)*sin(6.283185307179586*10/12) (d/2-pitch*0.13)*cos(6.283185307179586*11/12) pitch*11/12 (d/2-pitch*0.13)*sin(6.283185307179586*11/12) (d/2-pitch*0.13)*cos(6.283185307179586*12/12) pitch*12/12 (d/2-pitch*0.13)*sin(6.283185307179586*12/12)) radius(pitch*0.13) longitudinalSegments(12) radialSegments(6) cap(none)) material(blackmattemetal) 1 1) ]

HW_SetScrew -> [ HW_SocketHead(3 1.1 1.5) ] [ T(0 1.1 0) HW_ThreadedShaft(3 1.9 0.5) ]

