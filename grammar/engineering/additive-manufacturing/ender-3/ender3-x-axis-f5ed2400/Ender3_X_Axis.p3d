# ENDER-3 X-AXIS — NATIVE PROCEDURAL GRAMMAR
# Prepared for Pamela G. Hauff / ProGen3D.
# Replaces the previous stored-geometry version with parameterized native shapes.
# 57 procedural component types; 141 source assembly placements.
# Units: every dimension and T(...) is millimetres inside the root scope.
# One root S(0.001 0.001 0.001) converts the assembly to metres.
# Coordinates: X travel, Y vertical, Z depth.
# Shapes: boxes, cylinders, spheres, profile extrusions, revolutions, openings and sweeps.
# No imported geometry, stored vertex/face tables or external asset dependencies.
# Source anchors retained; surface details are editable engineering approximations.
# Screw ridges use round helical preview sections. Fits/threads are illustrative.
# Plate details and section dimensions are model parameters, not fabrication drawings.
# Native analytic descriptors were tested with the recovered Paper Studio 0.82 engine.
#
# CONTROL: 0 = assembled; 25 = component groups separated by 25 mm.
Start -> [ S(0.001 0.001 0.001) Ender3_XAxis(0) ]

Ender3_XAxis(explodeMM) ->
    [ Rail_2020 ]
    [ T(-explodeMM 0 0) Left_Support_Motor_Extruder ]
    [ T(explodeMM 0 0) Right_Support_Wheels ]
    [ T(0 0 -explodeMM) GT2_Belt ]
    [ T(0 0 -explodeMM) Belt_End_Fittings ]
    [ T(explodeMM 0 explodeMM) Idler_Tensioner ]
    [ T(0 0 explodeMM) Printhead_Carriage ]

