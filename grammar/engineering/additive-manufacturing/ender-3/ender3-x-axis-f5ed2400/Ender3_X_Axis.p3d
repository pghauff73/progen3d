# Native procedural geometry helpers for the mesh-free Ender-3 reconstruction.
# All geometric dimensions are millimetres. Caller uses one root S(.001 .001 .001).
# These are procedural analytic descriptions, not sampled source model geometry.
# Every helper isolates its transforms; materials can be edited at instantiation.

PG_TSlotRailX(length side mouth cavity root inner shoulder lip bore) ->
    [ T(-length/2 0 0) A(90 1)
      I(HostedOpening(host(Rect 2*inner 2*inner) opening(Circle bore/2 32) depth(length) cap(all)) material(blackmattemetal) 1 1)
      PG_TSlotRailCorners(length side mouth cavity root inner shoulder lip) ]

PG_TSlotRailCorners(length side mouth cavity root inner shoulder lip) 4 ->
    [ A(PG_TSlotRailCorners_count*90 2)
      I(Extrude(Polygon(side/2 side/2 mouth/2 side/2 mouth/2 side/2-lip cavity/2 side/2-lip cavity/2 shoulder root/2 inner inner inner inner root/2 shoulder cavity/2 side/2-lip cavity/2 side/2-lip mouth/2 side/2 mouth/2) length) material(blackmattemetal) 1 1) ]
