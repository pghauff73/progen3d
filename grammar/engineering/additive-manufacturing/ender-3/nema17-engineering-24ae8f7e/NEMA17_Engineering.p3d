# NEMA 17 | STEPPERONLINE 17HS19-2004S1 | engineering reference
# Self-contained native ProGen3D grammar. Paper Studio Android 0.82.
# Start arguments: section (0 assembled / 1 longitudinal cutaway), full steps/s,
# direction (+1/-1), shaft projection in mm, flat length in mm.
# Set the rate to 0 to park. Use a positive projection with 0 < flat < projection.
# One grammar unit = one millimetre throughout, including the assembly interfaces.
# Origin: mounting face centre, +Z out of shaft, +X normal to flat at t=0.
# Positive direction is CCW viewed from the output end. Ideal command position.
Start -> Nema17(0 8 1 24 15)

Nema17(section rate direction projection flat) ->
  [ Object(id(Nema17Motor) class(StepperMotor) taxonomy(Machine StepperMotor)) [ MotorParts(section rate direction projection flat) ] ]

MotorParts(section rate direction projection flat) ->
  [ Object(id(MotorFrame) class(MotorHousing) taxonomy(Machine MotorHousing) container(Nema17Motor)) [
    Interface(id(Mount) type(Mate) origin(0 0 0) normal(0 0 1) tangent(1 0 0) region(PlaneRectangle 42 42))
    Interface(id(MountNE) type(Socket) origin(15.5 15.5 0) normal(0 0 1) tangent(1 0 0) region(AxisSegment 4.5))
    Interface(id(MountNW) type(Socket) origin(-15.5 15.5 0) normal(0 0 1) tangent(1 0 0) region(AxisSegment 4.5))
    Interface(id(MountSW) type(Socket) origin(-15.5 -15.5 0) normal(0 0 1) tangent(1 0 0) region(AxisSegment 4.5))
    Interface(id(MountSE) type(Socket) origin(15.5 -15.5 0) normal(0 0 1) tangent(1 0 0) region(AxisSegment 4.5))
    FrameQuarters(4-2*section)
  ] ]
  [ Object(id(Stator) class(WoundStator) taxonomy(Machine WoundStator) container(Nema17Motor)) [ Poles(8-4*section) ] ]
  [ Object(id(FrontBearing) class(Bearing) taxonomy(Machine Bearing) container(Nema17Motor)) [ T(0 0 -3.8) BearingQuarters(4-2*section) ] ]
  [ Object(id(RearBearing) class(Bearing) taxonomy(Machine Bearing) container(Nema17Motor)) [ T(0 0 -45) BearingQuarters(4-2*section) ] ]
  [ A(direction*1.8*floor(rate*t) 2) RotatingGroup(projection flat) ]
  [ Object(id(PhaseLeads) class(WiringHarness) taxonomy(Machine WiringHarness) container(Nema17Motor)) [ VisibleLeads(1-section) ] ]

# Front taps are open smooth 2.5 mm minor-bore representations of M3 x 0.5.
# They terminate 4.5 mm behind the mounting face. Threads are schematic.
FrameQuarters(n) n ->
  [ A(FrameQuarters_count*90 2)
    [ T(0 0 -4.5) FaceLower ] [ T(0 0 -4.5) FaceUpper ]
    [ T(0 0 -6) EndBellWeb(6.5 1.5) ]
    [ PilotQuarter(3.5 11 2) ]
    [ T(0 0 -42) CaseBands(12) ]
    [ T(0 0 -42) YokeQuarter(18.3 19.5 36) ]
    [ T(0 0 -46) EndBellWeb(6.5 4) ]
    [ T(0 0 -48) RearClosure ]
  ]

# Three millimetres per visible group of laminations. The stripe marks a group,
# rather than specifying the manufacturing lamination gauge.
CaseBands(n) n ->
  [ T(0 0 CaseBands_count*3) [ StackWeb(2.7) ] [ T(0 0 2.7) StackJoint(0.3) ] ]

# Eight radial teeth carriers. Each pole has five face teeth on a 7.2 deg pitch.
Poles(n) n ->
  [ A(22.5+Poles_count*45 2)
    [ T(0 0 -36) PoleShoe ] [ T(0 0 -36) PoleStem ] [ StatorTeeth(5) ]
    [ T(0 0 -23.5) Turns(7) ]
  ]
StatorTeeth(n) n ->
  [ A((StatorTeeth_count-2)*7.2 2) T(0 0 -36) StatorTooth ]
Turns(n) n ->
  [ T(13+Turns_count*0.72 0 0) WindingTurn ]

RotatingGroup(projection flat) ->
  [ Object(id(OutputShaft) class(DriveShaft) taxonomy(Machine DriveShaft) container(Nema17Motor)) [
    Interface(id(Output) type(Shaft) origin(0 0 projection) normal(0 0 1) tangent(1 0 0) region(AxisSegment flat))
    [ T(0 0 -45) !I(Extrude(Circle(2.5 40) 45+projection-flat cap(all)) material(silverbrushedmetal) 1 1) ]
    [ T(0 0 projection-flat) ShaftFlat(flat) ]
  ] ]
  [ Object(id(RearRotor) class(HybridRotorCup) taxonomy(Machine HybridRotorCup) container(Nema17Motor)) [ T(0 0 -36) RotorPitches(50) ] ]
  [ Object(id(FrontRotor) class(HybridRotorCup) taxonomy(Machine HybridRotorCup) container(Nema17Motor)) [ T(0 0 -21.5) A(3.6 2) RotorPitches(50) ] ]
  [ Object(id(AxialMagnet) class(PermanentMagnet) taxonomy(Machine PermanentMagnet) container(Nema17Motor)) [ T(0 0 -25.5) MagnetQuarters(4) ] ]

RotorPitches(n) n ->
  [ A(RotorPitches_count*7.2 2) RotorPitch ]
MagnetQuarters(n) n ->
  [ A(MagnetQuarters_count*90 2) MagnetQuarter(2.5 9.05 4) ]

# Sealed bearings shown as stepped concentric races and shields.
BearingQuarters(n) n ->
  [ A(BearingQuarters_count*90 2)
    [ BearingRace(2.5 3.65 3.8) ] [ BearingRace(5.6 6.5 3.8) ]
    [ T(0 0 0.2) BearingShield(3.65 5.6 3.4) ] ]

# Rear four-colour pigtail is shortened for inspection. The cable and end plug
# are omitted beyond the displayed ends. Pair A black/green, pair B red/blue.
VisibleLeads(n) n -> Leads
Leads ->
  [ T(0 -19.8 -44.4) !I(Extrude(RoundedRect(7.6 4.8 0.8) 2.0 cap(all)) material(graphite) 1 1) ]
  [ T(-2.2 0 0) LeadBlack ] [ T(-0.75 0 0) LeadGreen ]
  [ T(0.75 0 0) LeadRed ] [ T(2.2 0 0) LeadBlue ]

LeadBlack -> !I(SweepDisk(path(0 -21 -43.4  0 -23.5 -43.4  0 -26 -44  0 -28.2 -45.1  0 -31.4 -46.3) radius(0.57) segments(10) cap(all)) material(graphite) 1 1)

LeadGreen -> !I(SweepDisk(path(0 -21 -43.4  0 -23.5 -43.4  0 -26 -44  0 -28.2 -45.1  0 -31.4 -46.3) radius(0.57) segments(10) cap(all)) material(greenmattepaint) 1 1)

LeadRed -> !I(SweepDisk(path(0 -21 -43.4  0 -23.5 -43.4  0 -26 -44  0 -28.2 -45.1  0 -31.4 -46.3) radius(0.57) segments(10) cap(all)) material(redmattepaint) 1 1)

LeadBlue -> !I(SweepDisk(path(0 -21 -43.4  0 -23.5 -43.4  0 -26 -44  0 -28.2 -45.1  0 -31.4 -46.3) radius(0.57) segments(10) cap(all)) material(bluemattepaint) 1 1)

