# Pantograph rosette. Pantograph(scale period traceChords).
# Tested scales include 1.70 and 2.30. Try 5 or 8 seconds for the cycle.
# The fixed pivot is the scale centre. The tracing stylus follows the small rosette.
Start -> Pantograph(1.70 8 72)

Pantograph(s period n) ->
 [ Board(s n radians(360*t/period)) ]
Board(s n angle) ->
 [ Object(id(Exhibit) class(PantographTable) taxonomy(Study Drafting Linkage) layer(Equipment)) [
   [ Object(id(Bed) class(DraftingBed) taxonomy(Study Drafting Surface) layer(Structure)) [ Bed ] ]
   [ T(-1.93 0 0)
     [ Object(id(MasterTrace) class(TemplateEngraving) taxonomy(Study Drafting Trace) layer(Equipment))
       [ Trace(n 1 0) ] ]
     [ Object(id(CopyTrace) class(CopyEngraving) taxonomy(Study Drafting Trace) layer(Equipment))
       [ Trace(n s 1) ] ]
     [ Object(id(Origin) class(FixedBearing) taxonomy(Study Drafting Pivot) layer(Equipment))
       [ Bearing ] ]
     [ Path(angle s 1+0.18*cos(3*angle)) ] ] ] ]

Path(a s r) ->
 [ Locate(1.13+0.20*r*cos(a) 0.32*r*sin(a) s) ]
Locate(x z s) ->
 [ Split(x z s x*x+z*z 1.18/s) ]
Split(x z s r d) ->
 [ Solve(x z s 0.94*0.94/r 0.5+(0.94*0.94-d*d)/(2*r)) ]
Solve(x z s f k) ->
 [ Elbow(x z s k sqrt(f-k*k)) ]
Elbow(x z s k q) ->
 [ Parallelogram(x z s k*x-q*z k*z+q*x) ]
Parallelogram(x z s ax az) ->
 [ Build(x z s ax az s*(x-ax) s*(z-az)) ]
Build(x z s a b c d) ->
 [ Linkage(x z s*x s*z a b c d a+c b+d) ]

Linkage(px pz qx qz ax az bx bz cx cz) ->
 [ Object(id(Links) class(ParallelogramArms) taxonomy(Study Drafting Linkage) layer(Equipment)) [
   [ Bar(0 0 ax az 0.655 0) ] [ Bar(bx bz qx qz 0.655 0) ]
   [ Bar(0 0 bx bz 0.548 1) ] [ Bar(ax az cx cz 0.548 1) ] ] ]
 [ Object(id(Pins) class(HingePins) taxonomy(Study Drafting Pivot) layer(Equipment)) [
   [ T(ax 0 az) Knuckle ] [ T(bx 0 bz) Knuckle ] [ T(cx 0 cz) Knuckle ] ] ]
 [ Object(id(InputStylus) class(TraceFollower) taxonomy(Study Drafting Stylus) layer(Equipment)) [
   [ T(px 0 pz) Stylus(0.548) ] ] ]
 [ Object(id(OutputStylus) class(CopyPen) taxonomy(Study Drafting Stylus) layer(Equipment)) [
   [ T(qx 0 qz) Stylus(0.655) ] ] ]

Bar(x z X Z y k) -> ?(k<0.5)
 [ !I(SweepProfile(profile(Rect 0.102 0.064) path(x y z X y Z) up(0 1 0) cap(all))
   material(bluegreymattepaint) 1 0.25) ]
 : [ !I(SweepProfile(profile(Rect 0.092 0.061) path(x y z X y Z) up(0 1 0) cap(all))
   material(copperpolishedmetal) 1 0.24) ]
Knuckle ->
 [ T(0 0.503 0) S(0.098 0.206 0.098) !I(Cylinder(segments(20 1)) material(silverbrushedmetal) 1 0.24) ]
 [ T(0 0.702 0) S(0.153 0.034 0.153) !I(Cylinder(segments(12 1)) material(goldbrushedmetal) 1 0.24) ]
 [ T(0 0.735 0) S(0.069 0.009 0.012) !I(Cube material(charcoalmattemetal) 1 0.24) ]
Stylus(h) ->
 [ !I(Revolve(profile(Polygon 0 0.245 0.012 0.245 0.038 0.307 0.040 h-0.058
   0.076 h-0.036 0.076 h+0.041 0.059 h+0.068 0.022 h+0.068 0.022 h+0.113 0 h+0.113)
   angle(0 360) segments(32)) material(goldbrushedmetal) 1 0.24) ]
 [ T(0 h+0.104 0) S(0.118 0.058 0.118) !I(Cylinder(segments(10 1)) material(redmattepaint) 1 0.24) ]
Bearing ->
 [ !I(Revolve(profile(Polygon 0 0.244 0.155 0.244 0.185 0.279 0.185 0.341 0.106 0.385
   0.073 0.500 0.073 0.709 0 0.709) angle(0 360) segments(48)) material(silverbrushedmetal) 1 0.25) ]
 [ T(0 0.704 0) S(0.184 0.042 0.184) !I(Cylinder(segments(12 1)) material(goldbrushedmetal) 1 0.24) ]

Trace(n s k) n ->
 [ TraceChord(radians(360*Trace_count/n) radians(360*(Trace_count+1)/n) s k) ]
TraceChord(a b s k) ->
 [ TracePoints(a b s k 1+0.18*cos(3*a) 1+0.18*cos(3*b)) ]
TracePoints(a b s k r R) ->
 [ Ink(s*1.13+s*0.20*r*cos(a) s*0.32*r*sin(a)
       s*1.13+s*0.20*R*cos(b) s*0.32*R*sin(b) k) ]
Ink(x z X Z k) -> ?(k<0.5)
 [ !I(TaperedSweep(samples(x 0.243 z 0.006 X 0.243 Z 0.006) up(0 1 0) segments(6) cap(all))
   material(copperpolishedmetal) 1 0.24) ]
 : [ !I(TaperedSweep(samples(x 0.243 z 0.007 X 0.243 Z 0.007) up(0 1 0) segments(6) cap(all))
   material(tealmatteceramic) 1 0.24) ]

Bed ->
 [ T(0 0.096 0) S(5.11 0.192 3.02) !I(Cube material(amberwarmwood) 1 0.25) ]
 [ T(0 0.207 0) S(5.00 0.042 2.92) !I(Cube material(charcoalmattemetal) 1 0.27) ]
 [ T(0 0.235 0) S(4.79 0.020 2.70) !I(Cube material(offwhiteceramic) 1 0.24) ]
 [ T(-1.93 0.248 1.03) Measure(37) ]
 [ T(0 0.238 1.12) S(4.67 0.012 0.016) !I(Cube material(goldbrushedmetal) 1 0.24) ]
 [ T(-2.25 0 1.18) Screw ] [ T(2.25 0 1.18) Screw ]
 [ T(-2.25 0 -1.18) Screw ] [ T(2.25 0 -1.18) Screw ]
Measure(n) n ->
 [ T(0.10*Measure_count 0 0)
   S(0.009 0.006 0.035+0.035*(1-min(1,wrap(Measure_count,0,5))))
   !I(Cube material(charcoalmattemetal) 1 0.24) ]
Screw ->
 [ T(0 0.239 0) S(0.086 0.027 0.086) !I(Cylinder(segments(12 1)) material(goldbrushedmetal) 1 0.24) ]
 [ T(0 0.268 0) S(0.052 0.005 0.009) !I(Cube material(charcoalmattemetal) 1 0.24) ]
