# Polar projection atlas. Atlas(latitudeBands meridians).
# Try 6 12 or 9 16. Lambert is left, orthographic is right.
# The north hemisphere bands divide sin(latitude) into equal steps.
Start -> Atlas(6 12)

Atlas(n m) ->
 [ Object(id(Atlas) class(CartographicExhibit) taxonomy(Study Cartography Projections) layer(Equipment)) [
   [ Object(id(Case) class(DisplayCase) taxonomy(Study Cartography Mount) layer(Structure)) [ Bed ] ]
   [ T(-1.61 0 0.24)
     [ Object(id(Lambert) class(EqualAreaProjection) taxonomy(Study Cartography Plate) layer(Equipment))
       [ Disc(n m 1.30 0) ] ]
     [ Object(id(LambertFrame) class(CompassFrame) taxonomy(Study Cartography Frame) layer(Equipment))
       [ Frame(m 1.30) ] ] ]
   [ T(1.61 0 0.24)
     [ Object(id(Orthographic) class(OrthographicProjection) taxonomy(Study Cartography Plate) layer(Equipment))
       [ Disc(n m 1.30 1) ] ]
     [ Object(id(OrthographicFrame) class(CompassFrame) taxonomy(Study Cartography Frame) layer(Equipment))
       [ Frame(m 1.30) ] ] ]
   [ T(0 0.342 -1.32)
     [ Object(id(Hemisphere) class(ReferenceHemisphere) taxonomy(Study Cartography Globe) layer(Equipment)) [
       Globe(n 6*m 0.66)
       [ T(0 0.702 0) S(0.045 0.045 0.045) !I(Sphere material(goldbrushedmetal) 1 0.25) ] ] ]
     [ Object(id(Pedestal) class(HemisphereStand) taxonomy(Study Cartography Mount) layer(Structure)) [ Stand ] ] ]
   [ Object(id(Legend) class(ProjectionLabels) taxonomy(Study Cartography Labels) layer(Equipment)) [
     [ T(-1.61 0.220 1.825) Nameplate(0) ] [ T(1.61 0.220 1.825) Nameplate(1) ] ] ] ] ]

Disc(n m r k) n ->
 [ Radii(r 6*m Disc_count/n (Disc_count+1)/n k wrap(Disc_count,0,4)) ]
Radii(r f a b k color) ->
 [ Painted(r*sqrt(a+k*a*(1-a)) r*sqrt(b+k*b*(1-b)) f color) ]
Painted(a b f color) -> ?(color<0.5)
 [ !I(Revolve(profile(Polygon a 0.262 b 0.262 b 0.315 a 0.315) angle(0 360) segments(f))
   material(bluegreymattepaint) 1 0.24) ]
 : [ MidShade(a b f color) ]
MidShade(a b f color) -> ?(color<1.5)
 [ !I(Revolve(profile(Polygon a 0.262 b 0.262 b 0.315 a 0.315) angle(0 360) segments(f))
   material(tealmatteceramic) 1 0.25) ]
 : [ WarmShade(a b f color) ]
WarmShade(a b f color) -> ?(color<2.5)
 [ !I(Revolve(profile(Polygon a 0.262 b 0.262 b 0.315 a 0.315) angle(0 360) segments(f))
   material(offwhiteceramic) 1 0.24) ]
 : [ !I(Revolve(profile(Polygon a 0.262 b 0.262 b 0.315 a 0.315) angle(0 360) segments(f))
   material(sagegreenmattepaint) 1 0.26) ]

Globe(n f r) n ->
 [ Latitudes(1-Globe_count/n 1-(Globe_count+1)/n r f wrap(Globe_count,0,4)) ]
Latitudes(a b r f color) ->
 [ Profile(a 0.75*a+0.25*b 0.5*a+0.5*b 0.25*a+0.75*b b r f color) ]
Profile(a b c d e r f color) ->
 [ Shell(r*sqrt(1-a*a) r*a+0.04 r*sqrt(1-b*b) r*b+0.04 r*sqrt(1-c*c) r*c+0.04
         r*sqrt(1-d*d) r*d+0.04 r*sqrt(1-e*e) r*e+0.04 f color) ]
Shell(a ya b yb c yc d yd e ye f color) -> ?(color<0.5)
 [ !I(Revolve(profile(Polygon a 0 e 0 e ye d yd c yc b yb a ya) angle(0 360) segments(f))
   material(bluegreymattepaint) 1 0.24) ]
 : [ ShellMid(a ya b yb c yc d yd e ye f color) ]
ShellMid(a ya b yb c yc d yd e ye f color) -> ?(color<1.5)
 [ !I(Revolve(profile(Polygon a 0 e 0 e ye d yd c yc b yb a ya) angle(0 360) segments(f))
   material(tealmatteceramic) 1 0.25) ]
 : [ ShellWarm(a ya b yb c yc d yd e ye f color) ]
ShellWarm(a ya b yb c yc d yd e ye f color) -> ?(color<2.5)
 [ !I(Revolve(profile(Polygon a 0 e 0 e ye d yd c yc b yb a ya) angle(0 360) segments(f))
   material(offwhiteceramic) 1 0.24) ]
 : [ !I(Revolve(profile(Polygon a 0 e 0 e ye d yd c yc b yb a ya) angle(0 360) segments(f))
   material(sagegreenmattepaint) 1 0.26) ]

Frame(m r) ->
 [ !I(Revolve(profile(Polygon 0 0.207 r+0.061 0.207 r+0.091 0.230
         r+0.091 0.260 0 0.260) angle(0 360) segments(6*m)) material(charcoalmattemetal) 1 0.27) ]
 [ !I(Revolve(profile(Polygon r 0.250 r+0.086 0.250 r+0.086 0.310 r+0.066 0.332
         r 0.332) angle(0 360) segments(6*m)) material(goldbrushedmetal) 1 0.24) ]
 [ Meridians(m r) ] [ FineTicks(2*m r) ]
 [ T(0 0.315 0) S(0.091 0.018 0.091) !I(Cylinder(segments(12 1)) material(goldbrushedmetal) 1 0.25) ]
Meridians(m r) m ->
 [ A(Meridians_count*360/m 1) T((r+0.040)/2 0.316 0) S(r-0.054 0.005 0.008)
   !I(Cube material(charcoalmattemetal) 1 0.26) ]
FineTicks(m r) m ->
 [ A(FineTicks_count*360/m 1) T(r+0.035 0.333 0)
   S(0.022+0.034*(1-wrap(FineTicks_count,0,2)) 0.007 0.010)
   !I(Cube material(charcoalmattemetal) 1 0.23) ]

Stand ->
 [ !I(Revolve(profile(Polygon 0 -0.135 0.67 -0.135 0.722 -0.096 0.722 -0.030
         0.682 0.008 0 0.008) angle(0 360) segments(72)) material(charcoalmattemetal) 1 0.28) ]
 [ !I(Revolve(profile(Polygon 0.650 -0.004 0.722 -0.004 0.722 0.038
         0.695 0.056 0.650 0.056) angle(0 360) segments(72)) material(goldbrushedmetal) 1 0.24) ]
Bed ->
 [ T(0 0.185 0) A(90 0) !I(Extrude(Polygon(-3.16 -2.12 3.16 -2.12 3.34 -1.94
         3.34 1.92 3.16 2.10 -3.16 2.10 -3.34 1.92 -3.34 -1.94) 0.177 cap(all))
   material(amberwarmwood) 1 0.31) ]
 [ T(0 0.207 0) A(90 0) !I(Extrude(Polygon(-3.13 -2.03 3.13 -2.03 3.25 -1.91
         3.25 1.88 3.13 2.00 -3.13 2.00 -3.25 1.88 -3.25 -1.91) 0.022 cap(all))
   material(charcoalmattemetal) 1 0.28) ]
 [ T(0 0.211 2.027) S(6.26 0.021 0.033) !I(Cube material(goldbrushedmetal) 1 0.28) ]
Nameplate(k) ->
 [ [ S(0.46 0.034 0.30) !I(Cube material(goldbrushedmetal) 1 0.26) ] Glyph(k) ]
Glyph(k) -> ?(k<0.5)
 [ [ T(-0.052 0.023 -0.012) S(0.024 0.017 0.157) !I(Cube material(charcoalmattemetal) 1 0.25) ]
   [ T(-0.007 0.023 0.060) S(0.111 0.017 0.025) !I(Cube material(charcoalmattemetal) 1 0.25) ] ]
 : [ !I(Revolve(profile(Polygon 0.052 0.014 0.078 0.014 0.078 0.030 0.052 0.030)
   angle(0 360) segments(32)) material(charcoalmattemetal) 1 0.25) ]
