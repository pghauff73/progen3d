# Hollow corner cube. Corner(rearTiltDegrees entryX).
# Try 0 or 6 degrees at entry X 0.52. Another tested setup is -4 and 0.66.
# The marked ray takes the X, floor, rear reflection sequence.
Start -> Corner(0 0.52)

Corner(tilt sx) ->
 [ Incident(tilt sx 0.82 1.36 0.31 0.36 0.44) ]
Incident(tilt sx sy sz u v w) ->
 [ FirstTwo(tilt sx sy sz u v w sx/u sy/v) ]
FirstTwo(tilt sx sy sz u v w a b) ->
 [ SecondHit(tilt sx sy sz u v w sy-v*a sz-w*a u*(b-a) sz-w*b) ]
SecondHit(tilt sx sy sz u v w fy fz gx gz) ->
 [ RearNormal(tilt sx sy sz u v w fy fz gx gz sin(radians(tilt)) cos(radians(tilt))) ]
RearNormal(tilt sx sy sz u v w fy fz gx gz nx nz) ->
 [ RearHit(tilt sx sy sz u v w fy fz gx gz nx nz 1*(nx*gx+nz*gz)/(w*nz-u*nx)) ]
RearHit(tilt sx sy sz u v w fy fz gx gz nx nz s) ->
 [ Return(tilt sx sy sz fy fz gx gz gx+u*s v*s gz-w*s
          u-2*(u*nx-w*nz)*nx v -w-2*(u*nx-w*nz)*nz) ]
Return(tilt sx sy sz fy fz gx gz hx hy hz dx dy dz) ->
 [ Exhibit(tilt sx sy sz fy fz gx gz hx hy hz dx*(sz-hz)/dz dy*(sz-hz)/dz sz-hz) ]

Exhibit(tilt sx sy sz fy fz gx gz hx hy hz dx dy dz) ->
 [ Object(id(Exhibit) class(RetroreflectionBench) taxonomy(Study Optics CornerCube) layer(Equipment)) [
   [ Object(id(Base) class(DisplayBase) taxonomy(Study Optics Mount) layer(Structure)) [ Base ] ]
   [ T(-0.85 0.46 -0.76)
     [ A(-90 1)
       [ Object(id(XMirror) class(PlanarMirror) taxonomy(Study Optics Mirror) layer(Equipment)) [ Mirror(0) ] ] ]
     [ A(90 0)
       [ Object(id(FloorMirror) class(PlanarMirror) taxonomy(Study Optics Mirror) layer(Equipment)) [ Mirror(0) ] ] ]
     [ A(tilt 1)
       [ Object(id(RearMirror) class(AdjustableMirror) taxonomy(Study Optics Mirror) layer(Equipment)) [ Mirror(1) ] ] ]
     [ Object(id(Incoming) class(IncidentRay) taxonomy(Study Optics Trace) layer(Equipment)) [
       [ Ray(sx sy sz 0 fy fz 0) ] [ Tip(sx sy sz 0 fy fz 0) ] ] ]
     [ Object(id(FirstBounce) class(ReflectedRay) taxonomy(Study Optics Trace) layer(Equipment)) [
       [ Ray(0 fy fz gx 0 gz 1) ] [ T(0 fy fz) Dot ] ] ]
     [ Object(id(SecondBounce) class(ReflectedRay) taxonomy(Study Optics Trace) layer(Equipment)) [
       [ Ray(gx 0 gz hx hy hz 1) ] [ T(gx 0 gz) Dot ] ] ]
     [ Object(id(Returning) class(ReturnRay) taxonomy(Study Optics Trace) layer(Equipment)) [
       [ Ray(hx hy hz hx+dx hy+dy hz+dz 2) ] [ Tip(hx hy hz hx+dx hy+dy hz+dz 2) ] [ T(hx hy hz) Dot ] ] ] ] ] ]

# The reflective face is local z=0. Two fixed mirrors are transformed from
# the back-facing profile so their positive local z goes out of the cavity.
Mirror(k) -> ?(k<0.5)
 [ Plate(1.82 0 0.061) ] [ Mount(1.82 0.057) ]
 : [ Plate(1.82 -0.061 0.061) ] [ Mount(1.82 -0.057) ]
Plate(side z d) ->
 [ T(0 0 z) !I(Extrude(Polygon(0 0 side 0 0 side) d cap(all)) material(silverbluepolishedmetal) 1 0.18) ]
Mount(side z) ->
 [ !I(SweepProfile(profile(Rect 0.079 0.119) path(side 0 z 0 side z) up(0 0 1) cap(all))
   material(bluegreymattepaint) 1 0.27) ]
 [ Fasteners(5 side z) ]
Fasteners(n side z) n ->
 [ T(side*(Fasteners_count+0.5)/n side*(1-(Fasteners_count+0.5)/n) z)
   [ T(0 0 -0.074) A(90 0) S(0.048 0.148 0.048)
     !I(Cylinder(segments(8 1)) material(goldbrushedmetal) 1 0.24) ] ]

Ray(x y z X Y Z code) -> ?(code<0.5)
 [ !I(TaperedSweep(samples(x y z 0.023 X Y Z 0.023) up(0 1 0) segments(12) cap(all))
   material(redmattepaint) 1 0.24) ]
 : [ Reflected(x y z X Y Z code) ]
Reflected(x y z X Y Z code) -> ?(code<1.5)
 [ !I(TaperedSweep(samples(x y z 0.021 X Y Z 0.021) up(0 1 0) segments(12) cap(all))
   material(goldbrushedmetal) 1 0.24) ]
 : [ !I(TaperedSweep(samples(x y z 0.023 X Y Z 0.023) up(0 1 0) segments(12) cap(all))
   material(tealmatteceramic) 1 0.24) ]
Tip(x y z X Y Z code) -> ?(code<0.5)
 [ !I(TaperedSweep(samples(0.87*x+0.13*X 0.87*y+0.13*Y 0.87*z+0.13*Z 0.062
     0.72*x+0.28*X 0.72*y+0.28*Y 0.72*z+0.28*Z 0.004) up(0 1 0) segments(12) cap(all))
   material(redmattepaint) 1 0.24) ]
 : [ !I(TaperedSweep(samples(0.14*x+0.86*X 0.14*y+0.86*Y 0.14*z+0.86*Z 0.062 X Y Z 0.004)
      up(0 1 0) segments(12) cap(all)) material(tealmatteceramic) 1 0.24) ]
Dot ->
 [ S(0.089 0.089 0.089) !I(Sphere material(goldbrushedmetal) 1 0.25) ]

Base ->
 [ T(0.04 0.090 0.04) S(2.73 0.18 2.43) !I(Cube material(amberwarmwood) 1 0.29) ]
 [ T(0.04 0.191 0.04) S(2.64 0.032 2.35) !I(Cube material(charcoalmattemetal) 1 0.25) ]
 [ T(0.04 0.211 1.15) S(2.57 0.017 0.030) !I(Cube material(goldbrushedmetal) 1 0.25) ]
 [ T(-0.85 0.207 -0.76)
   [ T(0.16 0 0.16) Seat ] [ T(1.34 0 0.16) Seat ] [ T(0.16 0 1.34) Seat ] ]
 [ T(-0.85 0.202 -0.76)
   [ S(0.25 0.23 0.25) !I(Cylinder(segments(24 1)) material(bluegreymattepaint) 1 0.27) ]
   [ T(0 0.217 0) S(0.17 0.112 0.17) !I(Cylinder(segments(16 1)) material(goldbrushedmetal) 1 0.24) ] ]
Seat ->
 [ S(0.239 0.210 0.239) !I(Cylinder(segments(12 1)) material(bluegreymattepaint) 1 0.25) ]
 [ T(0 0.189 0) S(0.212 0.035 0.212) !I(Cylinder(segments(24 1)) material(goldbrushedmetal) 1 0.25) ]
