        name(MCSM_crossover)
        package(
            length(4.518660)
            width(1.869440)
            height(1.620520)
            wheelbase(2.750820)
            trackFront(1.600000)
            trackRear(1.600000)
            groundClearance(0.185000)
        )
        wheels(radius(0.365000) width(0.245000))
        style(
            roofScale(1.120000)
            flare(0.060000)
            cabinFrontFactor(1.020000)
            cabinRearFactor(1.080000)
            tailTaper(0.930000)
