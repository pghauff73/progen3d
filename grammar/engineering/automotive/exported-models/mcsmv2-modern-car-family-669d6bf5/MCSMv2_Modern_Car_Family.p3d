MCSMv2_crossover() ->
    ModernCarV23(
        name(MCSMv2_crossover)
        package(
            length(4.518660) width(1.869440) height(1.620520)
            wheelbase(2.750820)
            trackFront(1.600000) trackRear(1.600000)
            groundClearance(0.185000)
        )
        wheelSystem(
            radius(0.365000) width(0.245000)
            steerRange(-32.000 32.000)
            travelRange(-0.085000 0.075000)
        )
        closureSystem(
            frontDoor(68.000)
            rearDoor(68.000)
            bonnet(62.000)
            hatch(72.000)
            glassTravel(0.550000)
        )
        researchProfile(
            packageArchetype(compact_ev_crossover)
            aerodynamicReference(compact_ev_crossover)
            calibrationStrength(0.0)
            researchAssurance(R2)
        )
        output(MCSMv2_crossover)
    )


ValidateMCSMv23(name) ->
    RequireAcyclicParameterGraph(name)
    RequireWatertightBody(name)
    RequireSurfaceProjection(name tolerance(0.000001))
    RequireBidirectionalSurfaceAlignment(name tolerance(0.012))
    RequireExclusiveSurfaceOwnership(name coverage(1.0))
    RequireSuspensionHardpointSymmetry(name)
    RequireActualTyreSweepClearance(name)
    RequireNoCollisionDuringClosureSweeps(name)
    RequireHelicalGlassCavityContainment(name)
    RequireResearchSourceRegistry(name minimumSources(12))
    RequirePublishedPackagePrior(name)
    RequireResearchScreenCompleteness(name)
    RequireResearchClaimBoundary(name notClaimed(R3))
    RequireCombinedAssurance(name geometry(V3) research(R2))
    RequireDeterministicMeshHash(name)
    CommitOnlyIfValid()
