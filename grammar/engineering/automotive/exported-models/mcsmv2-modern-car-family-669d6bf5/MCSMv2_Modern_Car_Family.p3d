# ============================================================================
# MCSMv2.3 RESEARCH-ENRICHED MODERN-CAR FAMILY
# FGKv1/MVPv2.5 target grammar generated by the MCSMv2.3 Python reference.
#
# Geometry assurance carried forward:
#   MCSMv2.2 persistent UV semantic surface and V3 sampled kinematics.
#
# Research enrichment:
#   ResearchEvidenceRegistry
#   PublishedVehicleReferenceDataset
#   PackageArchetypePrior
#   Aero / visibility / pedestrian / manufacturing / closure / structural screens
#   Separate R0-R3 research assurance, with R3 explicitly unclaimed.
#
# Research priors are soft. geometryCalibrationStrength = 0.0 in this release.
# ============================================================================

Start ->
    MCSMv2Family()

MCSMv2Family() ->
    MCSMv2_reference()
    MCSMv2_track()
    MCSMv2_aero()
    MCSMv2_crossover()

ModernCarV23(name package wheelSystem closureSystem researchProfile output) ->
    VehicleReferenceFrame(x(Front) y(Right) z(Up) handedness(Right) units(m))
    ParameterDependencyGraph(package wheelSystem closureSystem researchProfile)

    ResearchEvidenceRegistry(
        accessDate(2026-08-25)
        sourcePolicy(PrimaryOfficialAndResearch)
        sources(
            SAEJ1100 SAEJ826 UNECER125 UNECER127 EuroNCAP2026_2028
            SiemensNXBodyDesign AutodeskAliasContinuity TUMDrivAer
            DrivAerNet DrivAerNetPP ManufacturerTechnicalData
        )
        output(name.ResearchSources)
    )

    PublishedVehicleReferenceDataset(
        records(8)
        archetypes(PerformanceHatch CompactEVHatch CompactEVCrossover AeroFastback)
        metrics(
            WheelbaseLength WidthLength HeightLength HeightWidth
            FrontTrackWidth RearTrackWidth FrontalAreaBoxRatio
        )
        output(name.VehicleReferences)
    )

    PackageArchetypePrior(
        profile(researchProfile)
        dataset(name.VehicleReferences)
        mode(SoftEvidence)
        output(name.PackagePrior)
    )

    SemanticSectionField(output(name.Sections))
    CharacterCurveNetwork(source(name.Sections) output(name.Curves))

    PersistentUVSemanticSurface(
        sections(name.Sections)
        curves(name.Curves)
        coordinates(u(Rear Front) v(Circumference))
        output(name.UVSurface)
    )

    ImplicitOuterScaffold(
        source(name.Sections)
        wheelhouses(false)
        output(name.OuterScaffold)
    )

    ProjectSurfaceToScaffold(
        surface(name.UVSurface)
        scaffold(name.OuterScaffold)
        method(BracketedRadial)
        output(name.AuthoritativeSurface)
    )

    SurfaceDomainPartition(
        source(name.AuthoritativeSurface)
        panels(
            Hood Roof FrontDoors RearDoors FrontFenders RearQuarters
            RearHatch FrontBumper RearBumper Rockers Underbody FixedBody
        )
        apertures(
            Windshield RearGlass FrontSideGlassL FrontSideGlassR
            RearSideGlassL RearSideGlassR
        )
        ownership(Exclusive)
        output(name.Partition)
    )

    SuspensionHardpointGraph(
        package(package)
        front(MacPherson)
        rear(MultiLink)
        output(name.Suspension)
    )

    WheelPoseSolver(
        suspension(name.Suspension)
        wheelSystem(wheelSystem)
        output(name.WheelPoses)
    )

    ActualTyrePoseSweep(
        poses(name.WheelPoses)
        tyre(EllipticalSectionTorus)
        envelope(ConvexHull)
        output(name.TyreSweeps)
    )

    ClosureKinematicGraph(
        partition(name.Partition)
        doors(PairedVerticalRevolute)
        bonnet(RisingFourBarApproximation)
        hatch(RoofHeaderRevolute)
        output(name.Closures)
    )

    HelicalSideGlassMotion(
        closures(name.Closures)
        glassApertures(name.Partition)
        output(name.GlassMotion)
    )

    BodyInWhiteIntentGraph(
        package(package)
        members(FrontRails RearRails Rockers Pillars RoofRails Crossmembers Towers)
        output(name.BIWIntent)
    )

    AerodynamicGeometryScreen(
        package(package)
        surface(name.AuthoritativeSurface)
        wheels(name.TyreSweeps)
        references(TUMDrivAer DrivAerNet DrivAerNetPP)
        outputs(FrontalAreaProxy WheelExposure UnderbodyPriority CoolingOpeningRequirements)
        claimBoundary(NoCdPrediction NoCFD NoWindTunnelCorrelation)
        output(name.AeroScreen)
    )

    DriverVisibilityGeometryScreen(
        sections(name.Sections)
        references(SAEJ826 UNECER125)
        outputs(EyeRoofMargin HoodDepressionProxy)
        claimBoundary(NoR125ComplianceClaim)
        output(name.VisibilityScreen)
    )

    PedestrianGeometryScreen(
        sections(name.Sections)
        package(package)
        references(UNECER127 EuroNCAP2026_2028)
        outputs(BonnetPackageClearance LeadingEdgeHeightProxy)
        claimBoundary(NoImpactSimulation NoComplianceClaim)
        output(name.PedestrianScreen)
    )

    ManufacturingGeometryScreen(
        surface(name.AuthoritativeSurface)
        partition(name.Partition)
        continuityChecks(G0 G1 G2)
        references(AutodeskAliasContinuity SiemensNXBodyDesign)
        missingAnalyses(StampingDirection Flanges Hems Springback Tooling)
        claimBoundary(NoClassAApproval NoManufacturingApproval)
        output(name.ManufacturingScreen)
    )

    ClosureResearchScreen(
        closures(name.Closures)
        glass(name.GlassMotion)
        reference(SiemensNXBodyDesign)
        present(HingeRise HelicalGlassDrop SampledCollisionChecks)
        missing(BLine JSurface SolidGlassChannels SealCompression RegulatorHardware)
        claimBoundary(NoProductionDoorFeasibilityClaim)
        output(name.ClosureResearch)
    )

    StructuralIntentScreen(
        graph(name.BIWIntent)
        references(EuroNCAP2026_2028)
        checks(SideImpactPath RoofLoadPath GraphConnectivity)
        claimBoundary(NoCrashFEA NoStiffnessProof NoPhysicalTest)
        output(name.StructuralResearch)
    )

    ResearchAssurance(
        sources(name.ResearchSources)
        packagePrior(name.PackagePrior)
        screens(
            name.AeroScreen name.VisibilityScreen name.PedestrianScreen
            name.ManufacturingScreen name.ClosureResearch name.StructuralResearch
        )
        achieved(R2)
        notClaimed(R3 CFD Crash Regulatory Physical)
        output(name.ResearchAssurance)
    )

    ValidateMCSMv23(name)


MCSMv2_reference() ->
    ModernCarV23(
        name(MCSMv2_reference)
        package(
            length(4.353000) width(1.816000) height(1.468120)
            wheelbase(2.628900)
            trackFront(1.568250) trackRear(1.567990)
            groundClearance(0.130000)
        )
        wheelSystem(
            radius(0.340000) width(0.235000)
            steerRange(-32.000 32.000)
            travelRange(-0.070000 0.060000)
        )
        closureSystem(
            frontDoor(68.000)
            rearDoor(68.000)
            bonnet(62.000)
            hatch(72.000)
            glassTravel(0.550000)
        )
        researchProfile(
            packageArchetype(performance_hatch)
            aerodynamicReference(performance_hatch)
            calibrationStrength(0.0)
            researchAssurance(R2)
        )
        output(MCSMv2_reference)
    )

