# Decimal rod calculator. Rack(fourDigitNumber selectedRow).
# Read the four rod headers left to right. Add the selected row's diagonals from right to left.
Start -> Rack(4678 7)

Rack(number row) ->
 [ Object(id(Calculator) class(RodCalculator) taxonomy(Study Computation Napier) layer(Equipment)) [
   [ Object(id(Tray) class(CalculatorCase) taxonomy(Study Computation Napier) layer(Structure)) [ Casework ] ]
   [ Object(id(Index) class(MultiplierScale) taxonomy(Study Computation Napier) layer(Equipment)) [ Scale ] ]
   [ Object(id(Thousands) class(NumberRod) taxonomy(Study Computation Napier) layer(Equipment))
     [ T(-0.96 0 0) Rod(wrap(floor(number/1000),0,10)) ] ]
   [ Object(id(Hundreds) class(NumberRod) taxonomy(Study Computation Napier) layer(Equipment))
     [ T(-0.32 0 0) Rod(wrap(floor(number/100),0,10)) ] ]
   [ Object(id(Tens) class(NumberRod) taxonomy(Study Computation Napier) layer(Equipment))
     [ T(0.32 0 0) Rod(wrap(floor(number/10),0,10)) ] ]
   [ Object(id(Units) class(NumberRod) taxonomy(Study Computation Napier) layer(Equipment))
     [ T(0.96 0 0) Rod(wrap(number,0,10)) ] ]
   [ Object(id(Cursor) class(RowSelector) taxonomy(Study Computation Napier) layer(Equipment))
     [ T(0 0 -2.50+0.50*row) Reader ] ] ] ]

Casework ->
 [ T(-0.17 0.09 -0.23) S(3.76 0.18 5.47) !I(Cube material(amberwarmwood) 1 0.30) ]
 [ T(-0.17 0.196 -0.23) S(3.68 0.032 5.40) !I(Cube material(goldbrushedmetal) 1 0.25) ]
 [ T(-0.17 0.233 -0.23) S(3.60 0.042 5.34) !I(Cube material(charcoalmattemetal) 1 0.28) ]
 [ T(1.46 0.30 -2.71) RailEnd ] [ T(1.46 0.30 2.25) RailEnd ]
 [ !I(SweepDisk(path(1.46 0.368 -2.71 1.46 0.368 2.25) up(0 1 0) radius(0.040) radialSegments(12) cap(all)) material(goldbrushedmetal) 1 0.24) ]
 [ T(-0.24 0.305 2.33) S(3.24 0.10 0.11) !I(Cube material(amberwarmwood) 1 0.28) ]
RailEnd ->
 [ S(0.20 0.15 0.17) !I(Cube material(copperpolishedmetal) 1 0.27) ]
 [ T(0 0.078 0) S(0.078 0.016 0.078) !I(Cylinder(segments(6 1)) material(goldbrushedmetal) 1 0.25) ]
Scale ->
 [ T(-1.58 0.334 -0.25) S(0.44 0.16 5.00) !I(Cube material(sagegreenmattepaint) 1 0.28) ]
 [ IndexRows(9) ]
IndexRows(n) n ->
 [ T(-1.58 0.414 -2.00+0.50*IndexRows_count) Digit(IndexRows_count+1) ]

Rod(d) ->
 [ T(0 0.335 -0.25) S(0.628 0.162 5.00) !I(Cube material(offwhiteceramic) 1 0.30) ]
 [ T(0 0.422 -2.50) S(0.605 0.012 0.47) !I(Cube material(goldbrushedmetal) 1 0.26) ]
 [ T(0 0.429 -2.50) S(1.42 1 1.42) Digit(d) ]
 [ TableRows(9 d) ]
TableRows(n d) n ->
 [ T(0 0.416 -2.00+0.50*TableRows_count) Cell(d*(TableRows_count+1)) ]
Cell(v) ->
 [ T(0 0.006 -0.245) S(0.628 0.012 0.010) !I(Cube material(copperpolishedmetal) 1 0.28) ]
 [ T(0 0.006 0) A(38.0 1) S(0.786 0.012 0.009) !I(Cube material(copperpolishedmetal) 1 0.28) ]
 [ T(-0.145 0 -0.111) Digit(floor(v/10)) ]
 [ T(0.145 0 0.111) Digit(wrap(v,0,10)) ]

# Seven-segment numerals. Masks use bits A through G, least significant first.
Digit(d) -> ?(d<0.5) [ Glyph(63) ] : [ Nonzero(d) ]
Nonzero(d) -> ?(d<1.5) [ Glyph(6) ] : [ TwoUp(d) ]
TwoUp(d) -> ?(d<2.5) [ Glyph(91) ] : [ ThreeUp(d) ]
ThreeUp(d) -> ?(d<3.5) [ Glyph(79) ] : [ FourUp(d) ]
FourUp(d) -> ?(d<4.5) [ Glyph(102) ] : [ FiveUp(d) ]
FiveUp(d) -> ?(d<5.5) [ Glyph(109) ] : [ SixUp(d) ]
SixUp(d) -> ?(d<6.5) [ Glyph(125) ] : [ SevenUp(d) ]
SevenUp(d) -> ?(d<7.5) [ Glyph(7) ] : [ EightUp(d) ]
EightUp(d) -> ?(d<8.5) [ Glyph(127) ] : [ Glyph(111) ]
Glyph(mask) ->
 [ T(0 0 -0.085) Bit(mask 1) ]
 [ T(0.052 0 -0.043) A(90 1) S(0.80 1 1) Bit(mask 2) ]
 [ T(0.052 0 0.043) A(90 1) S(0.80 1 1) Bit(mask 4) ]
 [ T(0 0 0.085) Bit(mask 8) ]
 [ T(-0.052 0 0.043) A(90 1) S(0.80 1 1) Bit(mask 16) ]
 [ T(-0.052 0 -0.043) A(90 1) S(0.80 1 1) Bit(mask 32) ]
 [ Bit(mask 64) ]
Bit(mask weight) -> ?(wrap(floor(mask/weight),0,2)>0.5)
 [ T(0 0.008 0) S(0.094 0.016 0.019) !I(Cube material(charcoalmattemetal) 1 0.22) ]
 : [ ]

Reader ->
 [ T(1.46 0.368 0) S(0.19 0.17 0.44) !I(Cube material(copperpolishedmetal) 1 0.23) ]
 [ T(1.46 0.45 0) S(0.16 0.092 0.16) !I(Cylinder(segments(12 1)) material(redmattepaint) 1 0.25) ]
 [ T(-0.165 0.454 -0.245) CursorBar ] [ T(-0.165 0.454 0.245) CursorBar ]
 [ T(-1.82 0.454 0) S(0.035 0.027 0.51) !I(Cube material(redmattepaint) 1 0.25) ]
 [ T(1.48 0.454 0) S(0.047 0.027 0.51) !I(Cube material(redmattepaint) 1 0.25) ]
CursorBar ->
 [ S(3.34 0.026 0.023) !I(Cube material(redmattepaint) 1 0.25) ]
