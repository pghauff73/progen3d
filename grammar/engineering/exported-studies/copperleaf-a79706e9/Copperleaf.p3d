  [ A(-90 2) !I(Revolve(profile(Polygon 0.677 -0.0235 0.72 -0.0235 0.72 0.0235 0.677 0.0235) angle(0 360) segments(36) cap(all)) material(copperbrushedmetal) 1 1) ]
  [ T(0.52 0 0) A(-90 2) !I(Revolve(profile(Polygon 0.677 -0.0235 0.72 -0.0235 0.72 0.0235 0.677 0.0235) angle(0 360) segments(36) cap(all)) material(copperbrushedmetal) 1 1) ]
  [ T(1.04 0 0) A(-90 2) !I(Revolve(profile(Polygon 0.677 -0.0235 0.72 -0.0235 0.72 0.0235 0.677 0.0235) angle(0 360) segments(36) cap(all)) material(copperbrushedmetal) 1 1) ]
  [ T(0 -0.34 0) S(1.94 0.14 0.78) !I(Cube material(darkwalnutwood) 1 1) ]
  [ T(-0.74 -0.05 -0.22) S(0.28 0.45 0.25) !I(Sphere(segments(16 10)) material(olivegreenmattepaint) 1 1) ]
  [ T(-0.74 -0.05 0.22) S(0.28 0.45 0.25) !I(Sphere(segments(16 10)) material(olivegreenmattepaint) 1 1) ]
  [ T(-0.37 0.03 -0.22) S(0.28 0.45 0.25) !I(Sphere(segments(16 10)) material(sagegreenmattepaint) 1 1) ]
  [ T(-0.37 0.03 0.22) S(0.28 0.45 0.25) !I(Sphere(segments(16 10)) material(sagegreenmattepaint) 1 1) ]
  [ T(0 -0.05 -0.22) S(0.28 0.45 0.25) !I(Sphere(segments(16 10)) material(olivegreenmattepaint) 1 1) ]
  [ T(0 -0.05 0.22) S(0.28 0.45 0.25) !I(Sphere(segments(16 10)) material(olivegreenmattepaint) 1 1) ]
  [ T(0.39 0.03 -0.22) S(0.28 0.45 0.25) !I(Sphere(segments(16 10)) material(sagegreenmattepaint) 1 1) ]
  [ T(0.39 0.03 0.22) S(0.28 0.45 0.25) !I(Sphere(segments(16 10)) material(sagegreenmattepaint) 1 1) ]
  [ T(0.75 -0.05 -0.22) S(0.28 0.45 0.25) !I(Sphere(segments(16 10)) material(olivegreenmattepaint) 1 1) ]
  [ T(0.75 -0.05 0.22) S(0.28 0.45 0.25) !I(Sphere(segments(16 10)) material(olivegreenmattepaint) 1 1) ]

ShipObservation ->
