BoxBeigebrownmattepolyester(width depth height) ->
  [ S(width height depth) !I(CubeY material(beigebrownmattepolyester) alpha(1) texscale(1)) ]

BoxSilverbrushedmetal(width depth height) ->
  [ S(width height depth) !I(CubeY material(silverbrushedmetal) alpha(1) texscale(1)) ]

RodCharcoalmattemetal(ax ay az bx by bz ra rb ux uy uz) ->
  !I(TaperedSweep(samples(ax ay az ra bx by bz rb) up(ux uy uz) segments(10) cap(all)) material(charcoalmattemetal) alpha(1) texscale(1))

BoxWarmteakwood(width depth height) ->
  [ S(width height depth) !I(CubeY material(warmteakwood) alpha(1) texscale(1)) ]

BoxCharcoalmattemetal(width depth height) ->
  [ S(width height depth) !I(CubeY material(charcoalmattemetal) alpha(1) texscale(1)) ]

BoxLightashwood(width depth height) ->
  [ S(width height depth) !I(CubeY material(lightashwood) alpha(1) texscale(1)) ]

RodGoldbrushedmetal(ax ay az bx by bz ra rb ux uy uz) ->
  !I(TaperedSweep(samples(ax ay az ra bx by bz rb) up(ux uy uz) segments(10) cap(all)) material(goldbrushedmetal) alpha(1) texscale(1))

FacetSlateblueglossyglass(base offset rise depth) ->
  !I(AxialProfile(axis(y) profile(Face polygon(0 0 base 0 offset rise)) at(0 Face) hold(depth) cap(all)) material(slateblueglossyglass) alpha(0.74) texscale(1))

FacetOrangebrownmattefabric(base offset rise depth) ->
  !I(AxialProfile(axis(y) profile(Face polygon(0 0 base 0 offset rise)) at(0 Face) hold(depth) cap(all)) material(orangebrownmattefabric) alpha(1) texscale(1))

