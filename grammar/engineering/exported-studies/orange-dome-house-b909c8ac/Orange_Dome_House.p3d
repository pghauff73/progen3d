  [ T(0 0.06 0) !I(AxialProfile(axis(y) profile(Low polygon(-0.23 2.965 -0.205251 2.954749 -0.195 2.93 -0.205251 2.905251 -0.23 2.895 -0.254749 2.905251 -0.265 2.93 -0.254749 2.954749)) at(0 Low) hold(0.025) cap(all)) material(charcoalmattemetal) alpha(1) texscale(1)) ]
  [ T(0 0.06 0) !I(AxialProfile(axis(y) profile(Low polygon(-0.23 3.325 -0.205251 3.314749 -0.195 3.29 -0.205251 3.265251 -0.23 3.255 -0.254749 3.265251 -0.265 3.29 -0.254749 3.314749)) at(0 Low) hold(0.025) cap(all)) material(charcoalmattemetal) alpha(1) texscale(1)) ]
  [ T(0 0.06 0) !I(AxialProfile(axis(y) profile(Low polygon(0.23 2.965 0.254749 2.954749 0.265 2.93 0.254749 2.905251 0.23 2.895 0.205251 2.905251 0.195 2.93 0.205251 2.954749)) at(0 Low) hold(0.025) cap(all)) material(charcoalmattemetal) alpha(1) texscale(1)) ]
  [ T(0 0.06 0) !I(AxialProfile(axis(y) profile(Low polygon(0.23 3.325 0.254749 3.314749 0.265 3.29 0.254749 3.265251 0.23 3.255 0.205251 3.265251 0.195 3.29 0.205251 3.314749)) at(0 Low) hold(0.025) cap(all)) material(charcoalmattemetal) alpha(1) texscale(1)) ]

PylonArray ->
  [ Object(id(PylonArray) class(Support) taxonomy(Building Residential DetachedHouse RaisedDome SingleStorey Support PylonArray) layer(Structure))
    [
      [ A(45 1) TaperedPylon ]
      [ A(135 1) TaperedPylon ]
      [ A(225 1) TaperedPylon ]
      [ A(315 1) TaperedPylon ]
    ]
  ]

