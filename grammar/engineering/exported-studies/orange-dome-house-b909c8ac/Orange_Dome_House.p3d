# ORANGE DOME HOUSE | ProGen3D native grammar | metres | Y up
# A single pod reconstructed from the supplied exterior photograph.
# Start -> DomeHouse           complete raised pod
# Start -> FurnishedCutaway    rear shell course, access stair and interior
# Start -> OpenFloorPlan       shell removed for top or orbit inspection
# Change only the active Start production below, then rebuild.
# Floor level 2.78 m. Decagonal rim diameter through opposite vertices 7.20 m.
# Floor finish, walls, furniture, stair, access opening and scale are design assumptions.
# Panel material tokens select burnt-orange and amber swatches in the Android palette.
# Four repeated pylons and two outward-propped upper windows are modelling choices.
# Model axes: +Z toward the lounge glazing, +X toward the sleeping berth.

Start -> DomeHouse

# Whole-house assembly. The cutaway and plan below reuse the same rooms and fittings.
DomeHouse ->
  [ Object(id(DomeHouse) class(Building) taxonomy(Building SpatialOrganisation SpatialBreakdown BuildingContext Building EnclosedBuilding ProgrammedBuilding) layer(Temporary))
    [
      SitePad
      PylonArray
      DeckCassette
      RearStair
      HabitatFloor
      RearVestibule
      Fitout
      LowerFarFacets
      LowerNearFacets
      ShoulderFacets
      RoofFacets
    ]
  ]

FurnishedCutaway ->
  [ Object(id(FurnishedCutaway) class(Building) taxonomy(Building SpatialOrganisation SpatialBreakdown BuildingContext Building EnclosedBuilding ProgrammedBuilding) layer(Temporary))
    [
      PylonArray
      DeckCassette
      RearStair
      HabitatFloor
      RearVestibule
      Fitout
      LowerFarFacets
    ]
  ]

OpenFloorPlan ->
  [ Object(id(OpenFloorPlan) class(Building) taxonomy(Building SpatialOrganisation SpatialBreakdown BuildingContext Building EnclosedBuilding ProgrammedBuilding) layer(Temporary))
    [
      DeckCassette
      RearStair
      HabitatFloor
      RearVestibule
      Fitout
    ]
  ]

SitePad ->
  [ Object(id(SitePad) class(Foundation) taxonomy(Building Residential DetachedHouse RaisedDome SingleStorey Foundation SitePad) layer(Terrain))
    [
      [ T(0 -0.18 0) !I(AxialProfile(axis(y) profile(Low polygon(0 4.65 0.45578 4.627609 0.90717 4.560652 1.349824 4.449773 1.779478 4.29604 2.191995 4.100934 2.583402 3.866334 2.949929 3.594499 3.288047 3.288047 3.594499 2.949929 3.866334 2.583402 4.100934 2.191995 4.29604 1.779478 4.449773 1.349824 4.560652 0.90717 4.627609 0.45578 4.65 0 4.627609 -0.45578 4.560652 -0.90717 4.449773 -1.349824 4.29604 -1.779478 4.100934 -2.191995 3.866334 -2.583402 3.594499 -2.949929 3.288047 -3.288047 2.949929 -3.594499 2.583402 -3.866334 2.191995 -4.100934 1.779478 -4.29604 1.349824 -4.449773 0.90717 -4.560652 0.45578 -4.627609 0 -4.65 -0.45578 -4.627609 -0.90717 -4.560652 -1.349824 -4.449773 -1.779478 -4.29604 -2.191995 -4.100934 -2.583402 -3.866334 -2.949929 -3.594499 -3.288047 -3.288047 -3.594499 -2.949929 -3.866334 -2.583402 -4.100934 -2.191995 -4.29604 -1.779478 -4.449773 -1.349824 -4.560652 -0.90717 -4.627609 -0.45578 -4.65 0 -4.627609 0.45578 -4.560652 0.90717 -4.449773 1.349824 -4.29604 1.779478 -4.100934 2.191995 -3.866334 2.583402 -3.594499 2.949929 -3.288047 3.288047 -2.949929 3.594499 -2.583402 3.866334 -2.191995 4.100934 -1.779478 4.29604 -1.349824 4.449773 -0.90717 4.560652 -0.45578 4.627609)) at(0 Low) hold(0.18) cap(all)) material(beigebrownmattepolyester) alpha(1) texscale(1)) ]
      [ T(-3.92 -0.12 -3.9) BoxBeigebrownmattepolyester(1.25 1.3 0.12) ]
    ]
  ]

# One radial support in local coordinates. PylonArray rotates this rule to four bearings.
TaperedPylon ->
  [ T(0 0.005 3.11) BoxSilverbrushedmetal(0.62 0.57 0.055) ]
  RodCharcoalmattemetal(0 0.06 3.11 0 0.52 3.06 0.115 0.115 1 0 0)
  [ T(0 0.47 0) !I(AxialProfile(axis(y) profile(Low polygon(-0.1116 2.905 0.1116 2.905 0.155 2.9658 0.155 3.1642 0.1116 3.225 -0.1116 3.225 -0.155 3.1642 -0.155 2.9658)) profile(High polygon(-0.234 2.635 0.234 2.635 0.325 2.7433 0.325 3.0967 0.234 3.205 -0.234 3.205 -0.325 3.0967 -0.325 2.7433)) at(0 Low) linear(0.94 High) cap(all)) material(orangebrownmattefabric) alpha(1) texscale(1)) ]
  [ T(0 1.41 0) !I(AxialProfile(axis(y) profile(Low polygon(-0.234 2.635 0.234 2.635 0.325 2.7433 0.325 3.0967 0.234 3.205 -0.234 3.205 -0.325 3.0967 -0.325 2.7433)) profile(High polygon(-0.3564 2.295 0.3564 2.295 0.495 2.4527 0.495 2.9673 0.3564 3.125 -0.3564 3.125 -0.495 2.9673 -0.495 2.4527)) at(0 Low) linear(1.01 High) cap(all)) material(charcoalmattemetal) alpha(1) texscale(1)) ]
