    [ T(-0.0008 0.0188 0.0096) S(0.0184 0.0008 0.0008) !I(Cube material(tealmatteplastic) 1 0.45) ]
    [ T(-0.0096 0.0096 0.0096) S(0.0008 0.0192 0.0008) !I(Cube material(tealmatteplastic) 1 0.45) ]
    [ T(0.0096 0.0096 -0.0096) S(0.0008 0.0192 0.0008) !I(Cube material(tealmatteplastic) 1 0.45) ]
    [ T(-0.0004 0.0196 -0.0096) S(0.0192 0.0008 0.0008) !I(Cube material(tealmatteplastic) 1 0.45) ]
    [ T(-0.0096 0.0196 -0.0004) S(0.0008 0.0008 0.0192) !I(Cube material(tealmatteplastic) 1 0.45) ]

