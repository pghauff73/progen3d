# Cali Cat, from Dezign's original calibration figure.
# Original page: https://www.thingiverse.com/thing:1545913
# Reference dimensions: 20 mm body width/depth, 35 mm total height, 5 mm tail section.
# This reconstruction builds the angular head, sloping chin, ears and raised tail
# with editable native solids. The contour and tail routing are estimated.
Cat_Start -> Cat_Cat(1)

Cat_Cat(scaleFactor) ->
    [ S(scaleFactor scaleFactor scaleFactor) Cat_Body Cat_Head Cat_EarPair Cat_Tail ]

Cat_Body ->
    [ T(0 0.0074 0) S(0.02 0.0148 0.02) !I(Cube material(orangeyellowmatteplastic) 1 0.45) ]
    [ T(-0.0068 0.0021 0.0065) S(0.006 0.0042 0.007) !I(Cube material(orangeyellowmatteplastic) 1 0.45) ]
    [ T(0.0068 0.0021 0.0065) S(0.006 0.0042 0.007) !I(Cube material(orangeyellowmatteplastic) 1 0.45) ]

Cat_Head ->
    [ T(0 0 .0015) Cat_AngularHead ]

Cat_AngularHead ->
    [
      S(0.015 0.015 0.015)
      !I(AxialProfile(
        axis(y)
        profile(Profile0 polygon(
          -0.43333333 -0.38666667   0.43333333 -0.38666667   0.43333333 0.38666667   -0.43333333 0.38666667
        ))
        profile(Profile1 polygon(
          -0.66666667 -0.5   0.66666667 -0.5   0.66666667 0.66666667   -0.66666667 0.66666667
        ))
        at(0.96666667 Profile0)
        linear(1.26666667 Profile1)
        linear(1.86666667 Profile1)
        cap(all)
      ) material(orangeyellowmatteplastic) 1 0.5)
    ]

Cat_EarPair ->
    [ T(-.0052 0 .0006) Cat_Ear ]
    [ T(.0052 0 .0006) Cat_Ear ]

Cat_Ear ->
    [
      S(0.015 0.015 0.015)
      !I(AxialProfile(
        axis(y)
        profile(Profile0 polygon(
          -0.32 -0.25333333   0.32 -0.25333333   0.32 0.25333333   -0.32 0.25333333
        ))
        profile(Profile1 polygon(
          -0.12 -0.12666667   0.12 -0.12666667   0.12 0.12666667   -0.12 0.12666667
        ))
        profile(Profile2 polygon(
          -0.03 -0.05333333   0.03 -0.05333333   0.03 0.05333333   -0.03 0.05333333
        ))
        at(1.83333333 Profile0)
        linear(2.28 Profile1)
        linear(2.33333333 Profile2)
        cap(all)
      ) material(orangeyellowmatteplastic) 1 0.5)
    ]

Cat_Tail ->
    [ T(0 .008 -.011) A(-45 0) Cat_TailRise ]
    [ T(0 .0193 -.0223) S(.005 .005 .005) !I(Cube material(orangeyellowmatteplastic) 1 .45) ]

Cat_TailRise ->
    [ S(.005 .016 .005) !I(CubeY material(orangeyellowmatteplastic) 1 .45) ]

# Charging phone stand, adapted from GoAftens' cable-through design.
# https://www.thingiverse.com/thing:2120591
# Native reconstruction in metres. The two separate cradle fingers leave a clear cable path.
# Set widthScale for wider phones; chargeGap is the unscaled gap between the two fingers.
Phone_Start -> Phone_PhoneStand(1 .016)

Phone_PhoneStand(widthScale chargeGap) ->
    [ S(widthScale 1 1)
      [ T(-.029 0 0) Phone_Cheek ] [ T(.029 0 0) Phone_Cheek ]
      Phone_BackSupport
      [ T(-.018-chargeGap/2 .014 .029) Phone_CradleFinger ]
      [ T(.018+chargeGap/2 .014 .029) Phone_CradleFinger ]
      [ T(0 .006 -.024) S(.077 .012 .034) !I(Cube material(tealbluematteplastic) 1 .45) ]
    ]

Phone_BackSupport ->
    [ T(0 .046 -.012) A(-21 0) S(.080 .074 .008) !I(Cube material(tealbluematteplastic) 1 .45) ]
    [ T(.040 .084 -.026) A(90 2) S(.008 .080 .008) !I(Cylinder material(tealbluematteplastic) 1 .45) ]

Phone_CradleFinger ->
    [ S(.036 .009 .036) !I(Cube material(tealbluematteplastic) 1 .45) ]
    [ T(0 .004 .017) S(.036 .017 .006) !I(Cube material(tealbluematteplastic) 1 .45) ]

Phone_Cheek ->
    [
      A(-90 2)
      S(0.02 0.02 0.02)
      !I(AxialProfile(
        axis(y)
        profile(Profile0 polygon(
          0 -2.2   -0.3 -2.3   -1.05 -1.55   -4.2 -1.9   -4.35 -1.55
          -2.9 -0.8   -1.25 0.7   -0.95 1.95   -0.65 2.2   -0.2 2.1
        ))
        at(-0.6 Profile0)
        linear(0.6 Profile0)
        cap(all)
      ) material(tealbluematteplastic) 1 0.5)
    ]

# Spiral vase, adapted from BigBadBison’s 150 mm spiral-vase family.
# https://www.thingiverse.com/thing:570288
# Reported source licence: Creative Commons Attribution-NonCommercial.
# 150 mm high. Six joined wall sectors form an open mouth with real interior space.
# Twist is the rotation from the lowest to highest profile, in degrees.
Vase_Start -> Vase_Vase(108)

Vase_Vase(twist) ->
    [ S(.082 .003 .082) !I(Cylinder material(goldorangeceramic) 1 .4) ]
    Vase_VaseWalls(twist)

Vase_VaseWalls(twist) 6 ->
    [ A(60*Vase_VaseWalls_count 1) Vase_WallSector(twist) ]

Vase_WallSector(twist) ->
