# Popular objects collection. Six native procedural studies.
# The layout scales the objects for viewing. Open the individual files for true metre dimensions.
Start -> Collection

Collection ->
    [ T(-0.27 0 0.16) S(5 5 5) Cube_Start ]
    [ T(0 0 0.16) S(4.6 4.6 4.6) Cat_Start ]
    [ T(0.27 0 0.16) S(1.55 1.55 1.55) Phone_Start ]
    [ T(-0.27 0 -0.16) S(1 1 1) Vase_Start ]
    [ T(0 0 -0.16) S(0.73 0.73 0.73) Stand_Start ]
    [ T(0.27 0.027 -0.16) A(28 0) S(1.52 1.52 1.52) Bearing_Start ]

# 20 mm XYZ calibration cube, dimensions in metres.
# Reference geometry: Innerscene's independently authored CC0 20 mm XYZ cube.
# https://www.innerscene.com/tools/library/3d-parts/20-mm-xyz-calibration-cube-eb88de5c
# The block-letter faces here are rebuilt with strips around real 0.8 mm recesses.
# On this Y-up model, the letter Z is on top to match the conventional print axes.
Cube_Start -> Cube_CubeModel(1)

Cube_CubeModel(scaleFactor) ->
    [ S(scaleFactor scaleFactor scaleFactor) Cube_Body Cube_XSkin Cube_YSkin Cube_ZSkin ]

Cube_Body ->
    [ T(-0.0004 0.0096 -0.0004) S(0.0192 0.0192 0.0192) !I(Cube material(tealmatteplastic) 1 0.45) ]
    [ T(0.00915 0.0092 -0.0004) S(0.0001 0.0184 0.0192) !I(Cube material(darkbluegreenmatteplastic) 1 0.45) ]
    [ T(-0.0004 0.0092 0.00915) S(0.0192 0.0184 0.0001) !I(Cube material(darkbluegreenmatteplastic) 1 0.45) ]
    [ T(-0.0004 0.01915 -0.0004) S(0.0192 0.0001 0.0192) !I(Cube material(darkbluegreenmatteplastic) 1 0.45) ]
    [ T(0.0096 0.0096 0.0096) S(0.0008 0.0192 0.0008) !I(Cube material(tealmatteplastic) 1 0.45) ]
    [ T(0.0096 0.0196 -0.0004) S(0.0008 0.0008 0.0192) !I(Cube material(tealmatteplastic) 1 0.45) ]
    [ T(-0.0004 0.0196 0.0096) S(0.0192 0.0008 0.0008) !I(Cube material(tealmatteplastic) 1 0.45) ]
    [ T(0.0096 0.0196 0.0096) S(0.0008 0.0008 0.0008) !I(Cube material(tealmatteplastic) 1 0.45) ]
