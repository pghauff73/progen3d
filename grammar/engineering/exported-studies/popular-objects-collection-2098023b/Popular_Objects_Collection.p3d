# Herringbone gear-bearing study based on emmett's Gear Bearing.
# https://www.thingiverse.com/thing:53451
# Source attributed as Creative Commons Attribution-ShareAlike.
# Educational motion model. A 15-tooth sun, six 9-tooth planets and a 33-tooth ring.
# Carrier motion follows the fixed-ring planetary equation; tooth flanks are simplified.
# Geometry is a screen model, without a tested operating clearance.
# Change 55 to adjust the sun speed in degrees per second.
Bearing_Start -> Bearing_Bearing(55)

Bearing_Bearing(rate) ->
    [ Bearing_Ring ]
    [ A(rate*t 1) Bearing_SunGear ] 
    [ A(rate*t*15/(15+33) 1) Bearing_Planets(rate) ]

Bearing_Ring 33 ->
    [ A(Bearing_Ring_count*360/33 1) Bearing_RingSector ]

Bearing_Planets(rate) 6 ->
    [ A(Bearing_Planets_count*60 1)
      T(.0336 0 0)
      A(20-rate*t*33/(15+33)*15/9 1)
      Bearing_PlanetGear
    ]

