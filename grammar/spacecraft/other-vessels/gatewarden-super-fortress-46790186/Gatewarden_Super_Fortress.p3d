# GATEWARDEN | mobile harbour super fortress
# Native ProGen3D grammar. Bow +X, dorsal +Y, starboard +Z. Time t is in seconds.
# The root arguments set metres per design unit and seconds per harbour cycle.
# Default study: t=0 gate closed and ferry outside; t=5 gate half open;
# t=10 gate fully open and ferry sheltered; t=20 returns to the opening pose.
# Geometry is self-contained. Five native rules are embedded from Spaceship Object Model v1.
# Structure: Start > Gatewarden > named spatial objects > reusable geometry rules.

Start -> Gatewarden(20 20)

Gatewarden(metres cycle) ->
  [ S(metres metres metres) Object(id(GatewardenRoot) class(Spacecraft) taxonomy(Spaceship SuperFortress) layer(Structure)) [
    AssembleKeel
    AssembleStarboardBreakwater
    AssembleStarboardAftTower
    AssembleStarboardWaistTower
    AssembleStarboardForeTower
    AssembleStarboardWall1
    AssembleStarboardWall2
    AssembleStarboardWall3
    AssembleStarboardDistrict
    AssembleStarboardRadiator1(cycle)
    AssembleStarboardRadiator2(cycle)
    AssembleStarboardArrivalBeacon
    AssemblePortBreakwater
    AssemblePortAftTower
    AssemblePortWaistTower
    AssemblePortForeTower
    AssemblePortWall1
    AssemblePortWall2
    AssemblePortWall3
    AssemblePortDistrict
    AssemblePortRadiator1(cycle)
    AssemblePortRadiator2(cycle)
    AssemblePortArrivalBeacon
    AssembleKeep
    AssembleScanner(cycle)
    AssembleHarbour
    AssembleStarboardDoor(cycle)
    AssemblePortDoor(cycle)
    AssembleFerry(cycle)
    AssembleStern
  ] ]

AssembleKeel ->
  [ Object(id(Keel) class(Citadel) taxonomy(Spaceship SuperFortress Citadel) layer(Structure)) [
    Interface(id(passage) type(ServiceConnection) origin(0 0 0) normal(0 1 0) tangent(1 0 0) region(Point) tolerance(0.001))
    Interface(id(heat) type(ServiceConnection) origin(0 0 0) normal(0 1 0) tangent(1 0 0) region(Point) tolerance(0.001))
    Connect(id(Link11) source(Keel heat) target(Stern heat) type(ConnectedTo) clearance(0) insertionDepth(0))
    CitadelHull
  ] ]

AssembleStarboardBreakwater ->
  [ Object(id(StarboardBreakwater) class(ArmouredBow) taxonomy(Spaceship SuperFortress ArmouredBow) layer(Structure)) [
    Interface(id(mount) type(Support) origin(0 0 0) normal(0 1 0) tangent(1 0 0) region(Point) tolerance(0.001))
    Interface(id(heat) type(ServiceConnection) origin(0 0 0) normal(0 1 0) tangent(1 0 0) region(Point) tolerance(0.001))
    [  BreakwaterArm ]
  ] ]

AssembleStarboardAftTower ->
  [ Object(id(StarboardAftTower) class(RingBastion) taxonomy(Spaceship SuperFortress RingBastion) layer(Structure)) [
    Interface(id(data) type(ServiceConnection) origin(0 0 0) normal(0 1 0) tangent(1 0 0) region(Point) tolerance(0.001))
    [ T(-32.9 4.64 17) S(1.05 1.05 1.05) BastionTower ]
  ] ]

AssembleStarboardWaistTower ->
  [ Object(id(StarboardWaistTower) class(RingBastion) taxonomy(Spaceship SuperFortress RingBastion) layer(Structure)) [
    Interface(id(data) type(ServiceConnection) origin(0 0 0) normal(0 1 0) tangent(1 0 0) region(Point) tolerance(0.001))
    Connect(id(Link2) source(StarboardWaistTower data) target(Scanner data) type(ConnectedTo) clearance(0) insertionDepth(0))
    [ T(-4.1 4.64 15.7) S(0.88 0.88 0.88) BastionTower ]
  ] ]

AssembleStarboardForeTower ->
  [ Object(id(StarboardForeTower) class(RingBastion) taxonomy(Spaceship SuperFortress RingBastion) layer(Structure)) [
    Interface(id(data) type(ServiceConnection) origin(0 0 0) normal(0 1 0) tangent(1 0 0) region(Point) tolerance(0.001))
    [ T(22.9 4.64 11.85) S(0.7 0.7 0.7) BastionTower ]
  ] ]

AssembleStarboardWall1 ->
  [ Object(id(StarboardWall1) class(CurtainWall) taxonomy(Spaceship SuperFortress CurtainWall) layer(Structure)) [
    [ T(-18.35 4.98 19.3) A(4 1) S(15.6 1 1.13) RampartSpan ]
  ] ]

AssembleStarboardWall2 ->
  [ Object(id(StarboardWall2) class(CurtainWall) taxonomy(Spaceship SuperFortress CurtainWall) layer(Structure)) [
    [ T(8.5 4.98 15.2) A(10 1) S(13.2 1 1.13) RampartSpan ]
  ] ]

AssembleStarboardWall3 ->
  [ Object(id(StarboardWall3) class(CurtainWall) taxonomy(Spaceship SuperFortress CurtainWall) layer(Structure)) [
    [ T(34.7 4.98 11.4) A(9 1) S(10.5 1 1.13) RampartSpan ]
  ] ]

AssembleStarboardDistrict ->
  [ Object(id(StarboardDistrict) class(CityQuarter) taxonomy(Spaceship SuperFortress CityQuarter) layer(Structure)) [
    Interface(id(passage) type(ServiceConnection) origin(0 0 0) normal(0 1 0) tangent(1 0 0) region(Point) tolerance(0.001))
    Interface(id(power) type(ServiceConnection) origin(0 0 0) normal(0 1 0) tangent(1 0 0) region(Point) tolerance(0.001))
    Connect(id(Link1) source(StarboardDistrict passage) target(Keep passage) type(ConnectedTo) clearance(0) insertionDepth(0))
    [ T(-17.8 4.5 11.2) A(3 1) S(1.13 0.97 0.96) CityQuarter ]
  ] ]

AssembleStarboardRadiator1(cycle) ->
  [ Object(id(StarboardRadiator1) class(DeployableRadiator) taxonomy(Spaceship SuperFortress DeployableRadiator) layer(Structure)) [
    Interface(id(heat) type(ServiceConnection) origin(0 0 0) normal(0 1 0) tangent(1 0 0) region(Point) tolerance(0.001))
    Connect(id(Link3) source(StarboardRadiator1 heat) target(Keel heat) type(ConnectedTo) clearance(0) insertionDepth(0))
    [ T(-32.3 -2.21 22) HeatWing(cycle) ]
  ] ]

AssembleStarboardRadiator2(cycle) ->
  [ Object(id(StarboardRadiator2) class(DeployableRadiator) taxonomy(Spaceship SuperFortress DeployableRadiator) layer(Structure)) [
    Interface(id(heat) type(ServiceConnection) origin(0 0 0) normal(0 1 0) tangent(1 0 0) region(Point) tolerance(0.001))
    Connect(id(Link4) source(StarboardRadiator2 heat) target(Keel heat) type(ConnectedTo) clearance(0) insertionDepth(0))
    [ T(-24.3 -2.21 22) HeatWing(cycle) ]
  ] ]

AssembleStarboardArrivalBeacon ->
  [ Object(id(StarboardArrivalBeacon) class(BeaconSpire) taxonomy(Spaceship SuperFortress BeaconSpire) layer(Structure)) [
    [ T(48.5 4.51 10.2) S(0.66 0.66 0.66) Spire ]
  ] ]

AssemblePortBreakwater ->
  [ Object(id(PortBreakwater) class(ArmouredBow) taxonomy(Spaceship SuperFortress ArmouredBow) layer(Structure)) [
    Interface(id(mount) type(Support) origin(0 0 0) normal(0 1 0) tangent(1 0 0) region(Point) tolerance(0.001))
    Interface(id(heat) type(ServiceConnection) origin(0 0 0) normal(0 1 0) tangent(1 0 0) region(Point) tolerance(0.001))
    [ S(1 1 -1) BreakwaterArm ]
  ] ]

AssemblePortAftTower ->
  [ Object(id(PortAftTower) class(RingBastion) taxonomy(Spaceship SuperFortress RingBastion) layer(Structure)) [
    Interface(id(data) type(ServiceConnection) origin(0 0 0) normal(0 1 0) tangent(1 0 0) region(Point) tolerance(0.001))
    [ T(-32.9 4.64 -17) S(1.05 1.05 1.05) BastionTower ]
  ] ]

AssemblePortWaistTower ->
  [ Object(id(PortWaistTower) class(RingBastion) taxonomy(Spaceship SuperFortress RingBastion) layer(Structure)) [
    Interface(id(data) type(ServiceConnection) origin(0 0 0) normal(0 1 0) tangent(1 0 0) region(Point) tolerance(0.001))
    Connect(id(Link7) source(PortWaistTower data) target(Scanner data) type(ConnectedTo) clearance(0) insertionDepth(0))
    [ T(-4.1 4.64 -15.7) S(0.88 0.88 0.88) BastionTower ]
  ] ]

AssemblePortForeTower ->
  [ Object(id(PortForeTower) class(RingBastion) taxonomy(Spaceship SuperFortress RingBastion) layer(Structure)) [
    Interface(id(data) type(ServiceConnection) origin(0 0 0) normal(0 1 0) tangent(1 0 0) region(Point) tolerance(0.001))
    [ T(22.9 4.64 -11.85) S(0.7 0.7 0.7) BastionTower ]
  ] ]

AssemblePortWall1 ->
  [ Object(id(PortWall1) class(CurtainWall) taxonomy(Spaceship SuperFortress CurtainWall) layer(Structure)) [
    [ T(-18.35 4.98 -19.3) A(-4 1) S(15.6 1 1.13) RampartSpan ]
  ] ]

AssemblePortWall2 ->
  [ Object(id(PortWall2) class(CurtainWall) taxonomy(Spaceship SuperFortress CurtainWall) layer(Structure)) [
    [ T(8.5 4.98 -15.2) A(-10 1) S(13.2 1 1.13) RampartSpan ]
  ] ]

AssemblePortWall3 ->
  [ Object(id(PortWall3) class(CurtainWall) taxonomy(Spaceship SuperFortress CurtainWall) layer(Structure)) [
    [ T(34.7 4.98 -11.4) A(-9 1) S(10.5 1 1.13) RampartSpan ]
  ] ]

AssemblePortDistrict ->
  [ Object(id(PortDistrict) class(CityQuarter) taxonomy(Spaceship SuperFortress CityQuarter) layer(Structure)) [
    Interface(id(passage) type(ServiceConnection) origin(0 0 0) normal(0 1 0) tangent(1 0 0) region(Point) tolerance(0.001))
    Interface(id(power) type(ServiceConnection) origin(0 0 0) normal(0 1 0) tangent(1 0 0) region(Point) tolerance(0.001))
    Connect(id(Link6) source(PortDistrict passage) target(Keep passage) type(ConnectedTo) clearance(0) insertionDepth(0))
    [ T(-17.8 4.5 -11.2) A(-3 1) S(1.13 0.97 0.96) CityQuarter ]
  ] ]

AssemblePortRadiator1(cycle) ->
  [ Object(id(PortRadiator1) class(DeployableRadiator) taxonomy(Spaceship SuperFortress DeployableRadiator) layer(Structure)) [
    Interface(id(heat) type(ServiceConnection) origin(0 0 0) normal(0 1 0) tangent(1 0 0) region(Point) tolerance(0.001))
    Connect(id(Link8) source(PortRadiator1 heat) target(Keel heat) type(ConnectedTo) clearance(0) insertionDepth(0))
    [ T(-32.3 -2.21 -22) S(1 1 -1) HeatWing(cycle) ]
  ] ]

AssemblePortRadiator2(cycle) ->
  [ Object(id(PortRadiator2) class(DeployableRadiator) taxonomy(Spaceship SuperFortress DeployableRadiator) layer(Structure)) [
    Interface(id(heat) type(ServiceConnection) origin(0 0 0) normal(0 1 0) tangent(1 0 0) region(Point) tolerance(0.001))
    Connect(id(Link9) source(PortRadiator2 heat) target(Keel heat) type(ConnectedTo) clearance(0) insertionDepth(0))
    [ T(-24.3 -2.21 -22) S(1 1 -1) HeatWing(cycle) ]
  ] ]

AssemblePortArrivalBeacon ->
  [ Object(id(PortArrivalBeacon) class(BeaconSpire) taxonomy(Spaceship SuperFortress BeaconSpire) layer(Structure)) [
    [ T(48.5 4.51 -10.2) S(0.66 0.66 0.66) Spire ]
  ] ]

AssembleKeep ->
  [ Object(id(Keep) class(TerracedCommandKeep) taxonomy(Spaceship SuperFortress TerracedCommandKeep) layer(Structure)) [
    Interface(id(data) type(ServiceConnection) origin(0 0 0) normal(0 1 0) tangent(1 0 0) region(Point) tolerance(0.001))
    Interface(id(passage) type(ServiceConnection) origin(0 0 0) normal(0 1 0) tangent(1 0 0) region(Point) tolerance(0.001))
    Interface(id(power) type(ServiceConnection) origin(0 0 0) normal(0 1 0) tangent(1 0 0) region(Point) tolerance(0.001))
    Connect(id(Link12) source(Keep passage) target(Harbour passage) type(ConnectedTo) clearance(0) insertionDepth(0))
    [ T(-21.7 4.43 0) CentralKeep ]
  ] ]

AssembleScanner(cycle) ->
  [ Object(id(Scanner) class(NavigationScanner) taxonomy(Spaceship SuperFortress NavigationScanner) layer(Structure)) [
    Interface(id(data) type(ServiceConnection) origin(0 0 0) normal(0 1 0) tangent(1 0 0) region(Point) tolerance(0.001))
    [ T(-20.1 19.7 0) CrownScanner(cycle) ]
  ] ]

AssembleHarbour ->
  [ Object(id(Harbour) class(ShelteredApproach) taxonomy(Spaceship SuperFortress ShelteredApproach) layer(Structure)) [
    Interface(id(cargo) type(ServiceConnection) origin(0 0 0) normal(0 1 0) tangent(1 0 0) region(Point) tolerance(0.001))
    Interface(id(passage) type(ServiceConnection) origin(0 0 0) normal(0 1 0) tangent(1 0 0) region(Point) tolerance(0.001))
    Interface(id(power) type(ServiceConnection) origin(0 0 0) normal(0 1 0) tangent(1 0 0) region(Point) tolerance(0.001))
    DockBasin
  ] ]

AssembleStarboardDoor(cycle) ->
  [ Object(id(StarboardDoor) class(DockGateLeaf) taxonomy(Spaceship SuperFortress DockGateLeaf) layer(Structure)) [
    Interface(id(power) type(ServiceConnection) origin(0 0 0) normal(0 1 0) tangent(1 0 0) region(Point) tolerance(0.001))
    Connect(id(Link5) source(StarboardDoor power) target(Harbour power) type(ConnectedTo) clearance(0) insertionDepth(0))
    StarDoorMotion(cycle)
  ] ]

AssemblePortDoor(cycle) ->
  [ Object(id(PortDoor) class(DockGateLeaf) taxonomy(Spaceship SuperFortress DockGateLeaf) layer(Structure)) [
    Interface(id(power) type(ServiceConnection) origin(0 0 0) normal(0 1 0) tangent(1 0 0) region(Point) tolerance(0.001))
    Connect(id(Link10) source(PortDoor power) target(Harbour power) type(ConnectedTo) clearance(0) insertionDepth(0))
    PortDoorMotion(cycle)
  ] ]

AssembleFerry(cycle) ->
  [ Object(id(Ferry) class(HarbourFerry) taxonomy(Spaceship SuperFortress HarbourFerry) layer(Structure)) [
    Interface(id(cargo) type(ServiceConnection) origin(0 0 0) normal(0 1 0) tangent(1 0 0) region(Point) tolerance(0.001))
    Connect(id(Link13) source(Ferry cargo) target(Harbour cargo) type(ConnectedTo) clearance(0) insertionDepth(0))
    FerryMotion(cycle)
  ] ]

AssembleStern ->
  [ Object(id(Stern) class(DriveCluster) taxonomy(Spaceship SuperFortress DriveCluster) layer(Structure)) [
    Interface(id(heat) type(ServiceConnection) origin(0 0 0) normal(0 1 0) tangent(1 0 0) region(Point) tolerance(0.001))
    Interface(id(power) type(ServiceConnection) origin(0 0 0) normal(0 1 0) tangent(1 0 0) region(Point) tolerance(0.001))
    [ T(-44.7 -2.5 0) EngineBank ]
  ] ]

# Hull, fortress, civic districts and port machinery

# The central underside narrows to a dropped keel. The U-shaped forward cutout houses the gate.
CitadelHull ->
  [ A(-90 0) !I(Loft(section(-9.3 Polygon -39.97333 2.3 -32.05333 5.06 -14.77333 5.06 -2.53333 2.3 4.66667 0 -2.53333 -2.3 -14.77333 -5.06 -32.05333 -5.06 -39.97333 -2.3) section(-7.6 Polygon -46.13333 3.8 -36.23333 8.36 -14.63333 8.36 0.66667 3.8 9.66667 0 0.66667 -3.8 -14.63333 -8.36 -36.23333 -8.36 -46.13333 -3.8) section(-3.9 Polygon -49 5 -38 11 -14 11 3 5 13 0 3 -5 -14 -11 -38 -11 -49 -5) cap(all)) material(blackmattemetal) 1 1) ]
  [ A(-90 0) !I(Loft(section(-5 Polygon -46.255 8.8 -39.885 15.2 -19.865 15.2 -0.755 9.6 2.885 6.4 -7.125 4 -7.125 -4 2.885 -6.4 -0.755 -9.6 -19.865 -15.2 -39.885 -15.2 -46.255 -8.8) section(-2.3 Polygon -49 11 -42 19 -20 19 1 12 5 8 -6 5 -6 -5 5 -8 1 -12 -20 -19 -42 -19 -49 -11) section(0.9 Polygon -49 11 -42 19 -20 19 1 12 5 8 -6 5 -6 -5 5 -8 1 -12 -20 -19 -42 -19 -49 -11) section(3.35 Polygon -47.475 10.01 -40.825 17.29 -19.925 17.29 0.025 10.92 3.825 7.28 -6.625 4.55 -6.625 -4.55 3.825 -7.28 0.025 -10.92 -19.925 -17.29 -40.825 -17.29 -47.475 -10.01) cap(all)) material(slategreymattemetal) 1 1) ]
  [ A(-90 0) !I(Loft(section(3.36 Polygon -47.475 10.01 -40.825 17.29 -19.925 17.29 0.025 10.92 3.825 7.28 -6.625 4.55 -6.625 -4.55 3.825 -7.28 0.025 -10.92 -19.925 -17.29 -40.825 -17.29 -47.475 -10.01) section(4.4 Polygon -46.56 9.625 -40.12 16.625 -19.88 16.625 -0.56 10.5 3.12 7 -7 4.375 -7 -4.375 3.12 -7 -0.56 -10.5 -19.88 -16.625 -40.12 -16.625 -46.56 -9.625) cap(all)) material(ivorymattepaint) 1 1) ]
  [ T(-29 4.1 0) [ A(-90 0) !I(Loft(section(0 Polygon -7.6 10 7.6 10 12 5.6 12 -5.6 7.6 -10 -7.6 -10 -12 -5.6 -12 5.6) section(1.8 Polygon -6.612 8.7 6.612 8.7 10.44 4.872 10.44 -4.872 6.612 -8.7 -6.612 -8.7 -10.44 -4.872 -10.44 4.872) cap(all)) material(tealmattemetal) 1 1) ] ]
  [ T(-40 2.9 0) [ A(-90 0) !I(Loft(section(0 Polygon -5.64 6.5 5.64 6.5 8.5 3.64 8.5 -3.64 5.64 -6.5 -5.64 -6.5 -8.5 -3.64 -8.5 3.64) section(1.2 Polygon -4.9632 5.72 4.9632 5.72 7.48 3.2032 7.48 -3.2032 4.9632 -5.72 -4.9632 -5.72 -7.48 -3.2032 -7.48 3.2032) cap(all)) material(slategreymattemetal) 1 1) ] ]
  [ T(-41 -5.05 0) S(1 1 0.8) BellyRib ]
  [ T(-34 -5.05 0) BellyRib ]
  [ T(-27 -5.05 0) S(1 1 1.08) BellyRib ]
  [ T(-20 -5.05 0) S(1 1 1.04) BellyRib ]
  [ T(-13 -5.05 0) S(1 1 0.94) BellyRib ]
  [ T(-6 -5.05 0) S(1 1 0.7) BellyRib ]

BellyRib ->
  [ T(0 -1.15 -5.7) A(-90 1) A(-26.56505 2) S(5.14296 0.47 0.48) !I(Cube material(silverbrushedmetal) 1 1) ]
  [ T(0 -2.3 0) A(-90 1) A(0 2) S(6.8 0.47 0.48) !I(Cube material(silverbrushedmetal) 1 1) ]
  [ T(0 -1.15 5.7) A(-90 1) A(26.56505 2) S(5.14296 0.47 0.48) !I(Cube material(silverbrushedmetal) 1 1) ]

# Bow arm in starboard coordinates. The port arm mirrors the same rule.
BreakwaterArm ->
  [ A(-90 0) !I(Loft(section(-4.6 Polygon -43.01385 -13.38 -38.31385 -11.826 -12.93385 -10.272 3.04615 -8.57 25.60615 -8.126 52.86615 -8.866 64.14615 -10.938 46.28615 -13.824 26.54615 -15.896 7.74615 -18.93 -12.93385 -20.78 -29.85385 -20.78 -40.19385 -18.412) section(-2.6 Polygon -46 -13.21385 -41 -11.15585 -14 -9.09785 3 -6.84385 27 -6.25585 56 -7.23585 68 -9.97985 49 -13.80185 28 -16.54585 8 -20.56385 -14 -23.01385 -32 -23.01385 -43 -19.87785) section(-0.25 Polygon -46 -13.2 -41 -11.1 -14 -9 3 -6.7 27 -6.1 56 -7.1 68 -9.9 49 -13.8 28 -16.6 8 -20.7 -14 -23.2 -32 -23.2 -43 -20) cap(all)) material(blackmattemetal) 1 1) ]
