  [ A(-90 0) !I(Loft(section(3.12 Polygon -45.00462 -13.23462 -40.10462 -11.23962 -13.64462 -9.24462 3.01538 -7.05962 26.53538 -6.48962 54.95538 -7.43962 66.71538 -10.09962 48.09538 -13.80462 27.51538 -16.46462 7.91538 -20.35962 -13.64462 -22.73462 -31.28462 -22.73462 -42.06462 -19.69462) section(4.45 Polygon -43.01385 -13.29692 -38.31385 -11.49092 -12.93385 -9.68492 3.04615 -7.70692 25.60615 -7.19092 52.86615 -8.05092 64.14615 -10.45892 46.28615 -13.81292 26.54615 -16.22092 7.74615 -19.74692 -12.93385 -21.89692 -29.85385 -21.89692 -40.19385 -19.14492) cap(all)) material(ivorymattepaint) 1 1) ]
  [ A(-90 0) !I(Loft(section(4.03 Polygon 25 -7.15 52 -7.9 64 -9.9 47.5 -12.5 27 -15.1 18 -14.9) section(4.94 Polygon 26.11333 -7.84558 50.95333 -8.46808 61.99333 -10.12808 46.81333 -12.28608 27.95333 -14.44408 19.67333 -14.27808) cap(all)) material(silverbrushedmetal) 1 1) ]
  [ T(-32 4.45 16.6) A(0 1) S(15 1 7) ShoulderPlate ]
  [ T(-16 4.45 15.8) A(4 1) S(13.7 1 7.5) ShoulderPlate ]
