# PERIHELION SURVEYOR | ProGen3D | reference study 907
# Model units are relative. +Y is dorsal, +Z is the flared engine end.
# The named ship opens by itself. For the cover composition change Start to Encounter.
# Surveyor takes a uniform scale and a reflector tilt in degrees. Suggested tilt range 35 to 65.
# The far side, underside and cropped tip are interpretations of the single painted view.
# @surface warmwhitemattepaint roughness 0.45 color 0.93 0.88 0.76
# @surface beigemattepaint roughness 0.48 color 0.82 0.75 0.59
# @surface blackmattemetal roughness 0.58 color 0.1 0.135 0.155
# @surface blackpolishedmetal roughness 0.17 color 0.035 0.092 0.105
# @surface goldmattepaint roughness 0.46 color 0.84 0.71 0.36
# @surface ambermattepaint roughness 0.97 color 0.97 0.69 0.23
# @surface coppermattepaint roughness 0.97 color 0.82 0.48 0.22
# @surface orangemattepaint roughness 0.97 color 0.93 0.55 0.2
# @surface redmattepaint roughness 0.96 color 0.83 0.3 0.12
# @surface sandgoldmattepaint roughness 0.98 color 0.96 0.77 0.4
# @surface beigewarmmattepaint roughness 0.97 color 0.98 0.82 0.57

Start ->
  Surveyor(1 53)

Surveyor(size tilt) ->
  [ Object(id(SurveyVessel) class(Spacecraft) taxonomy(Spacecraft Exterior Spacecraft) layer(Equipment)) [ [ S(size size size)
      [ Object(id(Drum) class(Hull) taxonomy(Spacecraft Exterior Hull) layer(Equipment)) [ Keel HullDrum ShoulderPlates CrownTiles ServiceDeck HullMarkings ] ]
      [ Object(id(ForwardShell) class(Hull) taxonomy(Spacecraft Exterior Hull) layer(Equipment)) [ Forebody ObservationPort ] ]
      [ Object(id(FlightDeck) class(Command) taxonomy(Spacecraft Exterior Command) layer(Equipment)) [ BridgeSpine ] ]
      [ Object(id(Propulsion) class(Engine) taxonomy(Spacecraft Exterior Engine) layer(Equipment)) [ AftSpine Exhaust ] ]
      [ Object(id(SignalMast) class(Mast) taxonomy(Spacecraft Exterior Mast) layer(Equipment)) [ Mast ] ]
      [ Object(id(PortReflector) class(Antenna) taxonomy(Spacecraft Exterior Antenna) layer(Equipment)) [ ReflectorBoom(tilt) ] ]
      [ Object(id(StarboardBoom) class(Instrument) taxonomy(Spacecraft Exterior Instrument) layer(Equipment)) [ InstrumentBoom ] ]
      [ Object(id(ServiceCage) class(Truss) taxonomy(Spacecraft Exterior Truss) layer(Equipment)) [ ServiceCage ] ] ] ] ]

# The dark core shows through the gaps between eight individually cambered shoulder panels.
Keel ->
  [ A(90 0) !I(Revolve(profile(Polygon 0.02 -4.7  0.54 -4.7  0.76 -4.49  1.39 -3.46  1.74 -2.45  1.94 -1.35  2 -0.63  2.18 -0.17  2.24 0.85  2.14 1.74  1.77 2.64  1.26 3.45  0.94 4.15  0.02 4.15)
      angle(0 360) segments(40) cap(all)) material(blackmattemetal) 1 1) ]

HullDrum ->
  [ A(90 0) !I(Revolve(profile(Polygon 2.05 -0.62  2.21 -0.48  2.27 -0.22  2.22 -0.11  2.13 -0.11  2.18 -0.22  2.12 -0.48  1.96 -0.62)
      angle(0 360) segments(48) cap(all)) material(greymattemetal) 1 1) ]
  [ A(90 0) !I(Revolve(profile(Polygon 2.23 -0.16  2.29 -0.06  2.29 0.05  2.25 0.11  2.16 0.11  2.2 0.05  2.2 -0.06  2.14 -0.16)
      angle(0 360) segments(48) cap(all)) material(blackmattemetal) 1 1) ]
  [ A(90 0) !I(Revolve(profile(Polygon 2.25 0.075  2.285 0.095  2.285 0.13  2.25 0.155  2.16 0.155  2.195 0.13  2.195 0.095  2.16 0.075)
      angle(0 360) segments(48) cap(all)) material(silverbrushedmetal) 1 1) ]
  [ A(90 0) !I(Revolve(profile(Polygon 2.12 1.9  2.15 2.02  2.12 2.12  2.03 2.12  2.06 2.02  2.03 1.9)
      angle(0 360) segments(40) cap(all)) material(blackmattemetal) 1 1) ]
  CollarClips(24)

CollarClips(n) n ->
  [ A(360*CollarClips_count/n 2) T(0 2.267 -0.33) S(0.115 0.06 0.25) !I(Cube material(silverbrushedmetal) 1 1) ]

ShoulderPlates ->
  ShoulderPair(4)

ShoulderPair(n) n ->
  [ A(90*ShoulderPair_count 2)
      [ A(90 0) !I(Revolve(profile(Polygon 2.24 0.22  2.34 0.53  2.31 1.35  2.07 2.22  1.78 2.81  1.69 2.81  1.98 2.22  2.22 1.35  2.25 0.53  2.15 0.22)
      angle(-85 39) segments(5) cap(all)) material(warmwhitemattepaint) 1 1) ]
      [ A(90 0) !I(Revolve(profile(Polygon 2.24 0.22  2.34 0.53  2.31 1.35  2.07 2.22  1.78 2.81  1.69 2.81  1.98 2.22  2.22 1.35  2.25 0.53  2.15 0.22)
      angle(-44 37) segments(5) cap(all)) material(beigemattepaint) 1 1) ]
      [ A(90 0) !I(Revolve(profile(Polygon 2.348 1.24  2.344 1.32  2.23 1.82  2.14 1.82  2.254 1.32  2.258 1.24)
      angle(-81 8) segments(3) cap(all)) material(goldmattepaint) 1 1) ]
      [ A(90 0) !I(Revolve(profile(Polygon 2.335 0.44  2.367 0.7  2.277 0.7  2.245 0.44)
      angle(-37 22) segments(3) cap(all)) material(greymattemetal) 1 1) ] ]

CrownTiles ->
  CrownRepeat(8)

CrownRepeat(n) n ->
  [ A(360*CrownRepeat_count/n+10 2)
      [ A(90 0) !I(Revolve(profile(Polygon 1.96 2.5  1.83 2.81  1.31 3.46  1.07 3.92  0.98 3.92  1.22 3.46  1.74 2.81  1.87 2.5)
      angle(-103 36) segments(4) cap(all)) material(beigemattepaint) 1 1) ]
      [ A(90 0) !I(Revolve(profile(Polygon 1.969 2.56  1.8 2.87  1.46 3.3  1.37 3.3  1.71 2.87  1.879 2.56)
      angle(-92 11) segments(3) cap(all)) material(goldmattepaint) 1 1) ] ]

# Forward plates wrap around the tapered body. The intervals leave thin dark expansion seams.
Forebody ->
  BowTiles(4)
  [ A(90 0) !I(Revolve(profile(Polygon 0.71 -4.58  0.83 -4.48  0.88 -4.32  0.79 -4.32  0.74 -4.48  0.62 -4.58)
      angle(0 360) segments(40) cap(all)) material(amberbrushedmetal) 1 1) ]
  [ A(90 0) !I(Revolve(profile(Polygon 1.29 -3.71  1.34 -3.65  1.37 -3.59  1.28 -3.59  1.25 -3.65  1.2 -3.71)
      angle(0 360) segments(40) cap(all)) material(blackmattemetal) 1 1) ]

BowTiles(n) n ->
  [ A(90*BowTiles_count 2)
      [ A(90 0) !I(Revolve(profile(Polygon 0.84 -4.39  1.36 -3.65  1.61 -3.02  1.78 -2.56  1.69 -2.56  1.52 -3.02  1.27 -3.65  0.75 -4.39)
      angle(-91 55) segments(6) cap(all)) material(goldmattepaint) 1 1) ]
      [ A(90 0) !I(Revolve(profile(Polygon 0.84 -4.39  1.36 -3.65  1.61 -3.02  1.78 -2.56  1.69 -2.56  1.52 -3.02  1.27 -3.65  0.75 -4.39)
      angle(-34 31) segments(4) cap(all)) material(beigemattepaint) 1 1) ]
      [ A(90 0) !I(Revolve(profile(Polygon 1.79 -2.5  1.98 -1.75  2.05 -0.73  1.96 -0.73  1.89 -1.75  1.7 -2.5)
      angle(-91 56) segments(6) cap(all)) material(beigemattepaint) 1 1) ]
      [ A(90 0) !I(Revolve(profile(Polygon 1.79 -2.5  1.98 -1.75  2.05 -0.73  1.96 -0.73  1.89 -1.75  1.7 -2.5)
      angle(-33 30) segments(4) cap(all)) material(warmwhitemattepaint) 1 1) ]
      [ A(90 0) !I(Revolve(profile(Polygon 2.05 -1.29  2.089 -0.88  1.999 -0.88  1.96 -1.29)
      angle(-68 7) segments(3) cap(all)) material(blackmattemetal) 1 1) ]
      [ A(90 0) !I(Revolve(profile(Polygon 1.85 -2.33  1.985 -1.82  1.895 -1.82  1.76 -2.33)
      angle(-27 8) segments(3) cap(all)) material(goldmattepaint) 1 1) ]
      [ A(90 0) !I(Revolve(profile(Polygon 1.49 -3.38  1.64 -3.02  1.55 -3.02  1.4 -3.38)
      angle(-27 12) segments(3) cap(all)) material(blackmattemetal) 1 1) ] ]

ObservationPort ->
  [ T(1.47 1.04 -2.18) A(-55 2) A(-7 0) Viewport ]
  [ T(-1.62 0.3 -2.1) A(80 2) AuxiliaryHatch ]

Viewport ->
  [ !I(Revolve(profile(Polygon 0.62 -0.155  0.76 -0.13  0.82 -0.02  0.79 0.08  0.7 0.2  0.59 0.2  0.555 0.115  0.555 -0.04)
      angle(0 360) segments(48) cap(all)) material(warmwhitemattepaint) 1 1) ]
  [ !I(Revolve(profile(Polygon 0.545 0.073  0.595 0.135  0.628 0.138  0.619 0.17  0.555 0.164  0.535 0.12)
      angle(0 360) segments(48) cap(all)) material(silverbrushedmetal) 1 1) ]
  [ T(0 0.083 0) S(1.13 0.125 1.13) !I(Sphere(segments(24 12)) material(blackpolishedmetal) 1 1) ]
  PortBolts(12)

PortBolts(n) n ->
  [ A(360*PortBolts_count/n 1) T(0.673 0.19 0) S(0.05 0.038 0.05) !I(Sphere(segments(8 6)) material(blackmattemetal) 1 1) ]

AuxiliaryHatch ->
  [ !I(Revolve(profile(Polygon 0.01 -0.12  0.55 -0.12  0.57 0.05  0.45 0.13  0.011 0.14)
      angle(0 360) segments(24) cap(all)) material(greymattemetal) 1 1) ]
  [ T(0 0.15 0) S(0.6 0.05 0.065) !I(Cube material(blackmattemetal) 1 1) ]

# Inset vents, small hull-side pipes, and a raised instrument housing pick out the dark central drum.
ServiceDeck ->
  [ T(-0.36 2.04 0.97) A(-9 2) DeckCabinet ]
  [ T(0.85 1.94 0.73) A(-24 2) DeckOptic ]
  [ A(-135 2) T(0 2.13 0.77) LouverBank ]
  [ A(47 2) T(0 2.23 0.9) LouverBank ]
  [ A(-15 2) T(0 1.95 -1.7) LouverBank ]
  [ A(-72 2) T(0 2.17 1.15) HullPipes ]
  [ A(-145 2) T(0 2.11 1.2) HullPipes ]

DeckCabinet ->
  [ !I(Loft(section(-0.87 Polygon 0.348 0.27  0.58 0.125  0.58 -0.1175  0.3016 -0.23  -0.3016 -0.23  -0.58 -0.1175  -0.58 0.125  -0.348 0.27)
      section(-0.56 Polygon 0.408 0.51  0.68 0.2606  0.68 -0.1565  0.3536 -0.35  -0.3536 -0.35  -0.68 -0.1565  -0.68 0.2606  -0.408 0.51)
      section(0.71 Polygon 0.366 0.43  0.61 0.2038  0.61 -0.1745  0.3172 -0.35  -0.3172 -0.35  -0.61 -0.1745  -0.61 0.2038  -0.366 0.43)
      section(0.87 Polygon 0.27 0.2  0.45 0.084  0.45 -0.11  0.234 -0.2  -0.234 -0.2  -0.45 -0.11  -0.45 0.084  -0.27 0.2) cap(all)) material(warmwhitemattepaint) 1 1) ]
  [ T(0 0.49 0) S(0.74 0.055 0.89) !I(Cube material(blackmattemetal) 1 1) ]
  [ T(0 0.523 0.24) S(0.66 0.03 0.15) !I(Cube material(greymattemetal) 1 1) ]

DeckOptic ->
  [ !I(Revolve(profile(Polygon 0.02 -0.26  0.42 -0.25  0.46 0.18  0.39 0.25  0.33 0.25  0.33 0.17  0.02 0.17)
      angle(0 360) segments(28) cap(all)) material(silverbrushedmetal) 1 1) ]
  [ T(0 0.185 0) S(0.65 0.11 0.65) !I(Sphere(segments(24 12)) material(blackpolishedmetal) 1 1) ]
  [ !I(SweepDisk(path(-0.28 0.244 0  0.28 0.244 0) radius(0.019) radialSegments(8) cap(all)) material(silverbrushedmetal) 1 1) ]

LouverBank ->
  [ T(0 0.028 0) S(0.47 0.065 0.64) !I(Cube material(blackmattemetal) 1 1) ]
  Louvers(5)

Louvers(n) n ->
  [ T(0 0.078 -.24+Louvers_count*.12) S(0.42 0.055 0.036) !I(Cube material(greymattemetal) 1 1) ]

HullPipes ->
  [ !I(SweepDisk(path(-0.12 0 -0.72  -0.12 0.115 -0.58  -0.12 0.115 0.56  -0.12 0 0.71) radius(0.033) radialSegments(8) cap(all)) material(copperbrushedmetal) 1 1) ]
  [ !I(SweepDisk(path(0 0 -0.72  0 0.115 -0.58  0 0.115 0.56  0 0 0.71) radius(0.033) radialSegments(8) cap(all)) material(silverbrushedmetal) 1 1) ]
  [ !I(SweepDisk(path(0.12 0 -0.72  0.12 0.115 -0.58  0.12 0.115 0.56  0.12 0 0.71) radius(0.033) radialSegments(8) cap(all)) material(silverbrushedmetal) 1 1) ]

# Small removable panels and stencilled bars follow the local slope of the plating. Angles run from the dorsal centreline toward starboard.
HullMarkings ->
  [ A(-27 2) T(0 1.84 -2.45) A(-14 0) StencilPair ]
  [ A(-78 2) T(0 2.052 -1.31) A(-5 0) MaintenancePlate ]
  [ A(-48 2) T(0 2.055 -1.06) A(-5 0) CautionBars ]
  [ A(-18 2) T(0 1.57 -3.12) A(-23 0) MaintenancePlate ]
  [ A(-102 2) T(0 1.54 -3.14) A(-25 0) CautionBars ]
  [ A(-17 2) T(0 2.16 2.05) A(15 0) CautionBars ]
  [ A(18 2) T(0 2 -1.6) A(-6 0) CautionBars ]
  [ A(-49 2) T(0 2.322 0.9) A(0 0) StencilPair ]
  [ A(-94 2) T(0 2.3 1.32) A(8 0) StencilPair ]
  [ A(-67 2) T(0 1.24 -3.8) A(-27 0) StencilPair ]
  [ A(145 2) T(0 1.88 -2.19) A(-9 0) MaintenancePlate ]
  [ A(-147 2) T(0 2.29 0.63) A(-3 0) CautionBars ]
  [ A(-20 2) T(0 1.86 -2.56) A(-14 0) HatchDogs(4) ]

MaintenancePlate ->
  [ T(0 0 0) S(0.33 0.048 0.48) !I(Cube material(greymattemetal) 1 1) ]
  [ T(0 0.032 0) S(0.285 0.029 0.43) !I(Cube material(beigemattepaint) 1 1) ]
  [ T(-0.069 0.055 -0.06) S(0.066 0.022 0.19) !I(Cube material(blackmattemetal) 1 1) ]
  [ T(0.083 0.054 0.108) S(0.068 0.023 0.051) !I(Cube material(copperbrushedmetal) 1 1) ]

StencilPair ->
  [ T(-0.095 0.037 0) S(0.065 0.038 0.235) !I(Cube material(blackmattemetal) 1 1) ]
  [ T(-0.025 0.038 0.076) S(0.09 0.038 0.047) !I(Cube material(blackmattemetal) 1 1) ]
  [ T(0.051 0.037 0.047) S(0.035 0.036 0.17) !I(Cube material(greymattemetal) 1 1) ]
  [ T(0.105 0.036 0.08) S(0.03 0.035 0.11) !I(Cube material(blackmattemetal) 1 1) ]

CautionBars ->
  [ T(0 0.029 0) S(0.321 0.033 0.15) !I(Cube material(blackmattemetal) 1 1) ]
  Slashes(3)

Slashes(n) n ->
  [ T(-.10+.098*Slashes_count 0.052 0) A(-23 1) S(0.045 0.018 0.128) !I(Cube material(goldmattepaint) 1 1) ]

HatchDogs(n) n ->
  [ T(-.22+.145*HatchDogs_count 0.06 0) S(0.054 0.05 0.12) !I(Cube material(silverbrushedmetal) 1 1) ]

# The far tip is cropped in the painting. A small banded flight deck closes the inferred outline.
BridgeSpine ->
  [ !I(Loft(section(-7.95 Polygon 0.222 0.4  0.37 0.2144  0.37 -0.096  0.1924 -0.24  -0.1924 -0.24  -0.37 -0.096  -0.37 0.2144  -0.222 0.4)
      section(-7.4 Polygon 0.288 0.48  0.48 0.2364  0.48 -0.171  0.2496 -0.36  -0.2496 -0.36  -0.48 -0.171  -0.48 0.2364  -0.288 0.48)
      section(-6.1 Polygon 0.258 0.37  0.43 0.167  0.43 -0.1725  0.2236 -0.33  -0.2236 -0.33  -0.43 -0.1725  -0.43 0.167  -0.258 0.37)
      section(-4.46 Polygon 0.288 0.39  0.48 0.1638  0.48 -0.2145  0.2496 -0.39  -0.2496 -0.39  -0.48 -0.2145  -0.48 0.1638  -0.288 0.39) cap(all)) material(blackmattemetal) 1 1) ]
  [ !I(Loft(section(-7.32 Polygon 0.252 0.49  0.42 0.3044  0.42 -0.006  0.2184 -0.15  -0.2184 -0.15  -0.42 -0.006  -0.42 0.3044  -0.252 0.49)
      section(-6.83 Polygon 0.354 0.56  0.59 0.3628  0.59 0.033  0.3068 -0.12  -0.3068 -0.12  -0.59 0.033  -0.59 0.3628  -0.354 0.56)
      section(-6.3 Polygon 0.3 0.51  0.5 0.3302  0.5 0.0295  0.26 -0.11  -0.26 -0.11  -0.5 0.0295  -0.5 0.3302  -0.3 0.51) cap(all)) material(beigemattepaint) 1 1) ]
  [ !I(Loft(section(-6.26 Polygon 0.282 0.47  0.47 0.2728  0.47 -0.057  0.2444 -0.21  -0.2444 -0.21  -0.47 -0.057  -0.47 0.2728  -0.282 0.47)
      section(-5.71 Polygon 0.36 0.55  0.6 0.3238  0.6 -0.0545  0.312 -0.23  -0.312 -0.23  -0.6 -0.0545  -0.6 0.3238  -0.36 0.55)
      section(-4.78 Polygon 0.306 0.44  0.51 0.2544  0.51 -0.056  0.2652 -0.2  -0.2652 -0.2  -0.51 -0.056  -0.51 0.2544  -0.306 0.44) cap(all)) material(warmwhitemattepaint) 1 1) ]
  [ !I(Loft(section(-6.8 Polygon 0.258 0.65  0.43 0.6036  0.43 0.526  0.2236 0.49  -0.2236 0.49  -0.43 0.526  -0.43 0.6036  -0.258 0.65)
      section(-6.45 Polygon 0.318 0.73  0.53 0.6778  0.53 0.5905  0.2756 0.55  -0.2756 0.55  -0.53 0.5905  -0.53 0.6778  -0.318 0.73)
      section(-5.65 Polygon 0.276 0.66  0.46 0.6136  0.46 0.536  0.2392 0.5  -0.2392 0.5  -0.46 0.536  -0.46 0.6136  -0.276 0.66) cap(all)) material(goldmattepaint) 1 1) ]
  [ T(0 0.13 -7.65) BridgeCap ]
  [ T(0 0.51 -5.43) LouverBank ]
  BridgeWindows(5)

BridgeCap ->
  [ !I(Loft(section(-0.88 Polygon 0.09 0.17  0.15 0.0772  0.15 -0.078  0.078 -0.15  -0.078 -0.15  -0.15 -0.078  -0.15 0.0772  -0.09 0.17)
      section(-0.57 Polygon 0.288 0.41  0.48 0.2186  0.48 -0.1015  0.2496 -0.25  -0.2496 -0.25  -0.48 -0.1015  -0.48 0.2186  -0.288 0.41)
      section(-0.22 Polygon 0.396 0.52  0.66 0.2764  0.66 -0.131  0.3432 -0.32  -0.3432 -0.32  -0.66 -0.131  -0.66 0.2764  -0.396 0.52)
      section(0.47 Polygon 0.348 0.43  0.58 0.2096  0.58 -0.159  0.3016 -0.33  -0.3016 -0.33  -0.58 -0.159  -0.58 0.2096  -0.348 0.43)
      section(0.74 Polygon 0.252 0.31  0.42 0.1534  0.42 -0.1085  0.2184 -0.23  -0.2184 -0.23  -0.42 -0.1085  -0.42 0.1534  -0.252 0.31) cap(all)) material(silverbrushedmetal) 1 1) ]
  [ !I(Loft(section(-0.7 Polygon 0.216 0.29  0.36 0.1508  0.36 -0.082  0.1872 -0.19  -0.1872 -0.19  -0.36 -0.082  -0.36 0.1508  -0.216 0.29)
      section(-0.4 Polygon 0.342 0.49  0.57 0.258  0.57 -0.13  0.2964 -0.31  -0.2964 -0.31  -0.57 -0.13  -0.57 0.258  -0.342 0.49)
      section(-0.07 Polygon 0.396 0.54  0.66 0.2848  0.66 -0.142  0.3432 -0.34  -0.3432 -0.34  -0.66 -0.142  -0.66 0.2848  -0.396 0.54) cap(all)) material(cyanpolishedmetal) 1 1) ]
  [ !I(Loft(section(-0.01 Polygon 0.402 0.543  0.67 0.2861  0.67 -0.1437  0.3484 -0.343  -0.3484 -0.343  -0.67 -0.1437  -0.67 0.2861  -0.402 0.543)
      section(0.17 Polygon 0.396 0.525  0.66 0.2727  0.66 -0.1493  0.3432 -0.345  -0.3432 -0.345  -0.66 -0.1493  -0.66 0.2727  -0.396 0.525) cap(all)) material(blackmattemetal) 1 1) ]
  [ T(0 0.55 -0.05) S(0.5 0.035 0.42) !I(Cube material(warmwhitemattepaint) 1 1) ]

BridgeWindows(n) n ->
  [ T(0.51 0.26 -5.99+.18*BridgeWindows_count) S(0.055 0.14 0.095) !I(Cube material(blackpolishedmetal) 1 1) ]

# A tapered, ribbed thrust bell sits beyond an open service collar. Seven outlets terminate the small end bell.
AftSpine ->
  [ !I(Loft(section(2.38 Polygon 0.408 0.81  0.68 0.5896  0.68 0.221  0.3536 0.05  -0.3536 0.05  -0.68 0.221  -0.68 0.5896  -0.408 0.81)
      section(3.7 Polygon 0.45 0.85  0.75 0.6006  0.75 0.1835  0.39 -0.01  -0.39 -0.01  -0.75 0.1835  -0.75 0.6006  -0.45 0.85)
