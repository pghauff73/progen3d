LimbCore(rx ry rz bx by bz wx wy wz bend rad) ->
    [ !I(SweepDisk(path(rx ry rz bx by bz wx by+(wy-by)*cos(radians(bend))-(wz-bz)*sin(radians(bend)) bz+(wy-by)*sin(radians(bend))+(wz-bz)*cos(radians(bend))) radius(rad) segments(16) cap(all)) material(charcoalmattemetal) 1 1) ]


# ClampRailTrial(state railWidth clearance approachTravel) exercises the pad gauge.
# state 0 = approach, 1 = contact pose, 2 = release. These are nominal geometry states.

ClampRailTrial(state railWidth clearance approachTravel) ->
    ?(min(railWidth-0.19,clearance)>=0) [
      ?(approachTravel<=0.08) [
        ?(approachTravel>=railWidth+2*clearance-0.19) [
          ?(state==1) [ RailTrialAssembly(railWidth railWidth-0.19 state) RailTrialContacts ]
          : ?(min(state,2-state)==0) [ RailTrialAssembly(railWidth approachTravel state) ]
          : [ RailTrialRejected ]
        ] : [ RailTrialRejected ]
      ] : [ RailTrialRejected ]
    ] : [ RailTrialRejected ]

RailTrialAssembly(railWidth travel state) ->
    [ Object(id(ClampTrialFixture) class(ClampContactStudy) taxonomy(Robot Test)) [
    [ RailTrialState(state) ]
    [ Object(id(RobotLeftLeg) class(ClampFixture) taxonomy(Robot Test ClampFixture)) [ LeftClampAssembly(travel) ] ]
    [ Object(id(NominalMeridianRail) class(FixtureRail) taxonomy(Robot Test Rail)) [
      Interface(id(Negative) type(Mate) origin(0 -0.23 -railWidth/2) normal(0 0 -1) tangent(1 0 0) region(Point))
      Interface(id(Positive) type(Mate) origin(0 -0.23 railWidth/2) normal(0 0 1) tangent(1 0 0) region(Point))
      T(0 -0.25 0) S(0.28 0.04 railWidth) !I(Cube material(bluegreymattepaint) 1 1)
    ] ]
    ] ]

RailTrialState(state) ->
    ?(state==0) [ Interface(id(ApproachState) type(InspectionInterface) origin(0 0 0) region(Point)) ]
    : ?(state==1) [ Interface(id(EngagementState) type(InspectionInterface) origin(0 0 0) region(Point)) ]
    : [ Interface(id(ReleaseState) type(InspectionInterface) origin(0 0 0) region(Point)) ]

RailTrialContacts ->
    Connect(id(NegativePadToRail) source(RobotLeftClampJawNegative RailContact) target(NominalMeridianRail Negative) type(ConnectedTo))
    Connect(id(PositivePadToRail) source(RobotLeftClampJawPositive RailContact) target(NominalMeridianRail Positive) type(ConnectedTo))

RailTrialRejected ->
    [ Object(id(RailTrialCommandRejected) class(RejectedClearance) taxonomy(Robot Test Status)) [ ] ]

# Installation, hatch and equipment service
InstallationConnections ->
    Connect(id(GrappleFrameMount) source(D1EmergencyGrapple FramePad) target(D1LowerCrossMember GrappleTakeoff) type(ConnectedTo))
    Connect(id(LowerMemberToHipFrame) source(D1LowerCrossMember HipFramePad) target(RobotHipFrame LowerMemberSeat) type(ConnectedTo))
    Connect(id(LowerMemberToPortLongeron) source(D1LowerCrossMember PortLongeron) target(D1LongeronPort LowerMember) type(ConnectedTo))
    Connect(id(ShoulderMemberToPortLongeron) source(D1ShoulderCrossMember PortLongeron) target(D1LongeronPort ShoulderMember) type(ConnectedTo))
    Connect(id(BulkheadToPortLongeron) source(D1AftEquipmentBulkhead PortLongeron) target(D1LongeronPort EquipmentBulkhead) type(ConnectedTo))
    Connect(id(LowerMemberToStarboardLongeron) source(D1LowerCrossMember StarboardLongeron) target(D1LongeronStarboard LowerMember) type(ConnectedTo))
    Connect(id(ShoulderMemberToStarboardLongeron) source(D1ShoulderCrossMember StarboardLongeron) target(D1LongeronStarboard ShoulderMember) type(ConnectedTo))
    Connect(id(BulkheadToStarboardLongeron) source(D1AftEquipmentBulkhead StarboardLongeron) target(D1LongeronStarboard EquipmentBulkhead) type(ConnectedTo))
    Connect(id(SeatToInertialMount) source(RobotEmptySeat SeatBase) target(D1SeatInertialMount SeatBearing) type(ConnectedTo))
    Connect(id(SeatMountToCabin) source(D1SeatInertialMount CabinMount) target(RobotPressureCapsule SeatInstall) type(ConnectedTo))
    Connect(id(VisorGasketToCabin) source(RobotVisorGasket CabinFace) target(RobotPressureCapsule VisorOpening) type(ConnectedTo))
    Connect(id(CanopyToVisorGasket) source(RobotCanopy GasketFace) target(RobotVisorGasket CanopyFace) type(ConnectedTo))
    Connect(id(SocketArmToShoulderMember) source(SocketArmShoulder Axis) target(D1ShoulderCrossMember SocketArmSeat) type(ConnectedTo))
    Connect(id(GuideArmToShoulderMember) source(GuideArmShoulder Axis) target(D1ShoulderCrossMember GuideArmSeat) type(ConnectedTo))
    Connect(id(LeftHipToChassis) source(LeftLegHip Axis) target(RobotHipFrame LeftHipSeat) type(ConnectedTo))
    Connect(id(LeftKneeToHip) source(LeftLegKnee Axis) target(LeftLegHip KneeSeat) type(ConnectedTo))
    Connect(id(LeftAnkleToKnee) source(LeftLegAnkle Axis) target(LeftLegKnee AnkleSeat) type(ConnectedTo))
    Connect(id(LeftClampToAnkle) source(RobotLeftClamp FrameMount) target(LeftLegAnkle ClampSeat) type(ConnectedTo))
    Connect(id(RightHipToChassis) source(RightLegHip Axis) target(RobotHipFrame RightHipSeat) type(ConnectedTo))
    Connect(id(RightKneeToHip) source(RightLegKnee Axis) target(RightLegHip KneeSeat) type(ConnectedTo))
    Connect(id(RightAnkleToKnee) source(RightLegAnkle Axis) target(RightLegKnee AnkleSeat) type(ConnectedTo))
    Connect(id(RightClampToAnkle) source(RobotRightClamp FrameMount) target(RightLegAnkle ClampSeat) type(ConnectedTo))

CabinServiceConfiguration ->
    [ Object(id(MeridianCabinUncrewed) class(UncrewedCabin) taxonomy(Robot Cabin Configuration)) [
      Interface(id(SeatInstalledVacant) type(InspectionInterface) origin(0 1.94 0.29) normal(0 1 0) tangent(1 0 0) region(Point))
    ] ]

HatchDogGeometry(x z) ->
    [ T(x 2.583 z) S(0.029 0.042 0.031) !I(Cube material(goldbrushedmetal) 1 1) ]
    [ T(x 2.605 z) S(0.012 0.012 0.012) !I(Sphere(segments(22 16)) material(charcoalmattemetal) 1 1) ]

DorsalHatchCommand(surfaceDetail) ->
    DorsalHatchRequest(surfaceDetail 0 0 0)

DorsalHatchRequest(surfaceDetail permit release opening) ->
    ?(permit==floor(permit)) [ ?(min(permit,1-permit)>=0) [
      ?(release==floor(release)) [ ?(min(release,1-release)>=0) [
        ?(min(opening,70-opening)>=0) [
          ?(permit==0) [
            ?(release+opening>0) [ DorsalHatchAssembly(surfaceDetail 0 0 1) ]
            : [ DorsalHatchAssembly(surfaceDetail 0 0 0) ]
          ] : [
            ?(release==0) [
              ?(opening>0) [ DorsalHatchAssembly(surfaceDetail 0 0 2) ]
              : [ DorsalHatchAssembly(surfaceDetail 0 0 0) ]
            ] : [ DorsalHatchAssembly(surfaceDetail 1 opening 0) ]
          ]
        ] : [ DorsalHatchAssembly(surfaceDetail 0 0 3) ]
      ] : [ DorsalHatchAssembly(surfaceDetail 0 0 3) ] ] : [ DorsalHatchAssembly(surfaceDetail 0 0 3) ]
    ] : [ DorsalHatchAssembly(surfaceDetail 0 0 3) ] ] : [ DorsalHatchAssembly(surfaceDetail 0 0 3) ]

DorsalHatchAssembly(surfaceDetail released opening hold) ->
    [ Object(id(MeridianDorsalHatch) class(DorsalAccessAssembly) taxonomy(Robot Cabin Hatch)) [
      [ HatchConfiguration(released opening) ]
      [ HatchCommandResult(hold) ]
      D5PartMachinedHatchCoaming D5PartHatchInnerSealWitness D5PartHatchHingeShaft D5PartHatchHingeCheekPort D5PartHatchHingeCheekStarboard
      D61PartDorsalHatchContrastBorder
      [ ?(surfaceDetail==1) [ D6DetailHatchPressureWitness D6DetailHatchFastenerArrayGroup00 D6DetailHatchFastenerArrayGroup01 D6DetailHatchFastenerArrayGroup02 D6DetailHatchFastenerArrayGroup03 D6DetailHatchFastenerArrayGroup04 D6DetailHatchAngularIndexGroup00 D6DetailHatchAngularIndexGroup01 ] : [  ] ]
      D5PartHatchDog00(released) D5PartHatchDog01(released) D5PartHatchDog02(released) D5PartHatchDog03(released) D5PartHatchDog04(released) D5PartHatchDog05(released) D5PartHatchDog06(released) D5PartHatchDog07(released) D5PartHatchDog08(released) D5PartHatchDog09(released) D5PartHatchDog10(released) D5PartHatchDog11(released)
      [ HostRotation(opening 0 0 2.634 0.405) D5PartHatchDoorLeaf(surfaceDetail) ]
    ] ]
    Connect(id(DorsalHinge) source(D5PartHatchDoorLeaf HingeAxis) target(D5PartHatchHingeShaft HingeAxis) type(ConnectedTo)) Connect(id(CoamingToCabin) source(D5PartMachinedHatchCoaming CabinInstall) target(RobotPressureCapsule DorsalHatchOpening) type(ConnectedTo))
    [ ?(released==0) [ HatchClosedConnections ] : [  ] ]

HatchClosedConnections ->
    Connect(id(DorsalSealSeated) source(D5PartHatchDoorLeaf GasketFace) target(D5PartHatchInnerSealWitness ClosureFace) type(SealedTo))
    Connect(id(HatchRetainedByDog00) source(D5PartHatchDog00 CaptureDatum) target(D5PartHatchDoorLeaf DogSeat00) type(ConnectedTo))
    Connect(id(HatchRetainedByDog01) source(D5PartHatchDog01 CaptureDatum) target(D5PartHatchDoorLeaf DogSeat01) type(ConnectedTo))
    Connect(id(HatchRetainedByDog02) source(D5PartHatchDog02 CaptureDatum) target(D5PartHatchDoorLeaf DogSeat02) type(ConnectedTo))
    Connect(id(HatchRetainedByDog03) source(D5PartHatchDog03 CaptureDatum) target(D5PartHatchDoorLeaf DogSeat03) type(ConnectedTo))
    Connect(id(HatchRetainedByDog04) source(D5PartHatchDog04 CaptureDatum) target(D5PartHatchDoorLeaf DogSeat04) type(ConnectedTo))
    Connect(id(HatchRetainedByDog05) source(D5PartHatchDog05 CaptureDatum) target(D5PartHatchDoorLeaf DogSeat05) type(ConnectedTo))
    Connect(id(HatchRetainedByDog06) source(D5PartHatchDog06 CaptureDatum) target(D5PartHatchDoorLeaf DogSeat06) type(ConnectedTo))
    Connect(id(HatchRetainedByDog07) source(D5PartHatchDog07 CaptureDatum) target(D5PartHatchDoorLeaf DogSeat07) type(ConnectedTo))
    Connect(id(HatchRetainedByDog08) source(D5PartHatchDog08 CaptureDatum) target(D5PartHatchDoorLeaf DogSeat08) type(ConnectedTo))
    Connect(id(HatchRetainedByDog09) source(D5PartHatchDog09 CaptureDatum) target(D5PartHatchDoorLeaf DogSeat09) type(ConnectedTo))
    Connect(id(HatchRetainedByDog10) source(D5PartHatchDog10 CaptureDatum) target(D5PartHatchDoorLeaf DogSeat10) type(ConnectedTo))
    Connect(id(HatchRetainedByDog11) source(D5PartHatchDog11 CaptureDatum) target(D5PartHatchDoorLeaf DogSeat11) type(ConnectedTo))

HatchConfiguration(released opening) ->
    ?(released==0) [ Interface(id(DoggedAndSeated) type(InspectionInterface) origin(0 2.634 0.405) normal(0 1 0) tangent(1 0 0) region(Point)) ]
    : ?(opening==0) [ Interface(id(ReleasedAtSeat) type(InspectionInterface) origin(0 2.634 0.405) normal(0 1 0) tangent(1 0 0) region(Point)) ]
    : [ Interface(id(OpenForService) type(InspectionInterface) origin(0 2.634 0.405) normal(0 1 0) tangent(1 0 0) region(Point)) ]

HatchCommandResult(hold) ->
    ?(hold==1) [ Interface(id(PermitRequired) type(InspectionInterface) origin(0 2.634 0.405) normal(0 1 0) tangent(1 0 0) region(Point)) ]
    : ?(hold==2) [ Interface(id(DogReleaseRequired) type(InspectionInterface) origin(0 2.634 0.405) normal(0 1 0) tangent(1 0 0) region(Point)) ]
    : ?(hold==3) [ Interface(id(InvalidServiceRequest) type(InspectionInterface) origin(0 2.634 0.405) normal(0 1 0) tangent(1 0 0) region(Point)) ] : []

PortPanelCommand(surfaceDetail) ->
    PortPanelRequest(surfaceDetail 0 0 0)

PortPanelRequest(surfaceDetail isolated released travel) ->
    ?(isolated==floor(isolated)) [ ?(min(isolated,1-isolated)>=0) [
      ?(released==floor(released)) [ ?(min(released,1-released)>=0) [
        ?(min(travel,0.35-travel)>=0) [
          ?(isolated==0) [
            ?(released+travel>0) [ PortPanelAssembly(surfaceDetail 0 0 0 1) ]
            : [ PortPanelAssembly(surfaceDetail 0 0 0 0) ]
          ] : [
            ?(released==0) [
              ?(travel>0) [ PortPanelAssembly(surfaceDetail 1 0 0 2) ]
              : [ PortPanelAssembly(surfaceDetail 1 0 0 0) ]
            ] : [ PortPanelAssembly(surfaceDetail 1 1 travel 0) ]
          ]
        ] : [ PortPanelAssembly(surfaceDetail 0 0 0 3) ]
      ] : [ PortPanelAssembly(surfaceDetail 0 0 0 3) ] ] : [ PortPanelAssembly(surfaceDetail 0 0 0 3) ]
    ] : [ PortPanelAssembly(surfaceDetail 0 0 0 3) ] ] : [ PortPanelAssembly(surfaceDetail 0 0 0 3) ]

PortPanelAssembly(surfaceDetail isolated released travel hold) ->
    [ Object(id(MeridianPortServiceBay) class(ServiceCassetteAssembly) taxonomy(Robot Service Bay)) [
      [ PanelServiceState(isolated released travel hold) ]
      D5PartD4_RearBayServiceDisconnectPort D7PartRearAccessGasketPort D7PartRearThermalBlanketLatchPort
      [ T(-1*travel 0 0) D5PartAftBayPanelPort(surfaceDetail) ]
    ] ]
    [ ?(isolated==0) [ Connect(id(PortPanelPower) source(D5PartD4_RearBayServiceDisconnectPort VehicleFeed) target(D5PartAftBayPanelPort PanelFeed) type(Powers)) ] : [  ] ]
    [ ?(released==0) [ Connect(id(PortPanelLatched) source(D7PartRearThermalBlanketLatchPort PanelKeeper) target(D5PartAftBayPanelPort Retainer) type(ConnectedTo)) Connect(id(PortPanelSeated) source(D5PartAftBayPanelPort GasketSeat) target(D7PartRearAccessGasketPort CassetteSeat) type(SealedTo)) ] : [  ] ]

StarboardPanelCommand(surfaceDetail) ->
    StarboardPanelRequest(surfaceDetail 0 0 0)

StarboardPanelRequest(surfaceDetail isolated released travel) ->
    ?(isolated==floor(isolated)) [ ?(min(isolated,1-isolated)>=0) [
      ?(released==floor(released)) [ ?(min(released,1-released)>=0) [
        ?(min(travel,0.35-travel)>=0) [
          ?(isolated==0) [
            ?(released+travel>0) [ StarboardPanelAssembly(surfaceDetail 0 0 0 1) ]
            : [ StarboardPanelAssembly(surfaceDetail 0 0 0 0) ]
          ] : [
            ?(released==0) [
              ?(travel>0) [ StarboardPanelAssembly(surfaceDetail 1 0 0 2) ]
              : [ StarboardPanelAssembly(surfaceDetail 1 0 0 0) ]
            ] : [ StarboardPanelAssembly(surfaceDetail 1 1 travel 0) ]
          ]
        ] : [ StarboardPanelAssembly(surfaceDetail 0 0 0 3) ]
      ] : [ StarboardPanelAssembly(surfaceDetail 0 0 0 3) ] ] : [ StarboardPanelAssembly(surfaceDetail 0 0 0 3) ]
    ] : [ StarboardPanelAssembly(surfaceDetail 0 0 0 3) ] ] : [ StarboardPanelAssembly(surfaceDetail 0 0 0 3) ]

StarboardPanelAssembly(surfaceDetail isolated released travel hold) ->
    [ Object(id(MeridianStarboardServiceBay) class(ServiceCassetteAssembly) taxonomy(Robot Service Bay)) [
      [ PanelServiceState(isolated released travel hold) ]
      D5PartD4_RearBayServiceDisconnectStarboard D7PartRearAccessGasketStarboard D7PartRearThermalBlanketLatchStarboard
      [ T(1*travel 0 0) D5PartAftBayPanelStarboard(surfaceDetail) ]
    ] ]
    [ ?(isolated==0) [ Connect(id(StarboardPanelPower) source(D5PartD4_RearBayServiceDisconnectStarboard VehicleFeed) target(D5PartAftBayPanelStarboard PanelFeed) type(Powers)) ] : [  ] ]
    [ ?(released==0) [ Connect(id(StarboardPanelLatched) source(D7PartRearThermalBlanketLatchStarboard PanelKeeper) target(D5PartAftBayPanelStarboard Retainer) type(ConnectedTo)) Connect(id(StarboardPanelSeated) source(D5PartAftBayPanelStarboard GasketSeat) target(D7PartRearAccessGasketStarboard CassetteSeat) type(SealedTo)) ] : [  ] ]

PanelServiceState(isolated released travel hold) ->
    [ ?(isolated==1) [ Interface(id(FeedIsolated) type(InspectionInterface) origin(0 0 0) normal(0 1 0) tangent(1 0 0) region(Point)) ] : [ Interface(id(FeedConnected) type(InspectionInterface) origin(0 0 0) normal(0 1 0) tangent(1 0 0) region(Point)) ] ]
    [ ?(released==0) [ Interface(id(LatchedAtSeat) type(InspectionInterface) origin(0 0 0) normal(0 1 0) tangent(1 0 0) region(Point)) ]
      : ?(travel==0) [ Interface(id(ReleasedAtSeat) type(InspectionInterface) origin(0 0 0) normal(0 1 0) tangent(1 0 0) region(Point)) ]
      : [ Interface(id(CassetteWithdrawn) type(InspectionInterface) origin(0 0 0) normal(0 1 0) tangent(1 0 0) region(Point)) ] ]
    [ ?(hold==1) [ Interface(id(IsolationRequired) type(InspectionInterface) origin(0 0 0) normal(0 1 0) tangent(1 0 0) region(Point)) ]
      : ?(hold==2) [ Interface(id(LatchReleaseRequired) type(InspectionInterface) origin(0 0 0) normal(0 1 0) tangent(1 0 0) region(Point)) ]
      : ?(hold==3) [ Interface(id(InvalidServiceRequest) type(InspectionInterface) origin(0 0 0) normal(0 1 0) tangent(1 0 0) region(Point)) ] : [] ]


# Topological equipment declarations have no display solids of their own.
# An inlet/collector node conveys flow from its named inlets to its named outlets.
# A bus edge conveys service availability. The Stage 3 disconnects still govern the cassette feeds.
# EquipmentHeatCollection expresses intended heat transfer to the inboard cores. External rejection needs validation.
EquipmentNetworkNodes ->
    [ Object(id(RcsDistributionManifold) class(RegulatedGasDistribution) taxonomy(Propulsion Nitrogen DesignIntent) layer(Equipment)) [
      Interface(id(Inlet) type(PipePort) origin(0 2.14 -0.71) normal(0 0 1) tangent(1 0 0) region(Point))
      Interface(id(XMinus) type(PipePort) origin(0 2.14 -0.71) normal(0 0 1) tangent(1 0 0) region(Point))
      Interface(id(XPlus) type(PipePort) origin(0 2.14 -0.71) normal(0 0 1) tangent(1 0 0) region(Point))
      Interface(id(YMinus) type(PipePort) origin(0 2.14 -0.71) normal(0 0 1) tangent(1 0 0) region(Point))
      Interface(id(YPlus) type(PipePort) origin(0 2.14 -0.71) normal(0 0 1) tangent(1 0 0) region(Point))
      Interface(id(ZMinus) type(PipePort) origin(0 2.14 -0.71) normal(0 0 1) tangent(1 0 0) region(Point))
      Interface(id(ZPlus) type(PipePort) origin(0 2.14 -0.71) normal(0 0 1) tangent(1 0 0) region(Point))
    ] ]
    [ Object(id(VehiclePowerBus) class(PowerDistribution) taxonomy(Electrical DesignIntent) layer(Equipment)) [
      Interface(id(BatteryIn) type(ElectricalPort) origin(0 1.92 -0.56) normal(0 0 1) tangent(1 0 0) region(Point))
      Interface(id(AvionicsOut) type(ElectricalPort) origin(0 1.92 -0.56) normal(0 0 1) tangent(1 0 0) region(Point))
      Interface(id(LifeSupportOut) type(ElectricalPort) origin(0 1.92 -0.56) normal(0 0 1) tangent(1 0 0) region(Point))
      Interface(id(PortBayOut) type(ElectricalPort) origin(0 1.92 -0.56) normal(0 0 1) tangent(1 0 0) region(Point))
      Interface(id(StarboardBayOut) type(ElectricalPort) origin(0 1.92 -0.56) normal(0 0 1) tangent(1 0 0) region(Point))
      Interface(id(PortOpticsOut) type(ElectricalPort) origin(0 1.92 -0.56) normal(0 0 1) tangent(1 0 0) region(Point))
      Interface(id(StarboardOpticsOut) type(ElectricalPort) origin(0 1.92 -0.56) normal(0 0 1) tangent(1 0 0) region(Point))
    ] ]
    [ Object(id(EquipmentHeatCollection) class(HeatDistribution) taxonomy(Thermal DesignIntent) layer(Equipment)) [
      Interface(id(AvionicsIn) type(ThermalInterface) origin(0 2.14 -0.56) normal(0 0 1) tangent(1 0 0) region(Point))
      Interface(id(LifeSupportIn) type(ThermalInterface) origin(0 2.14 -0.56) normal(0 0 1) tangent(1 0 0) region(Point))
      Interface(id(PortOut) type(ThermalInterface) origin(0 2.14 -0.56) normal(0 0 1) tangent(1 0 0) region(Point))
      Interface(id(StarboardOut) type(ThermalInterface) origin(0 2.14 -0.56) normal(0 0 1) tangent(1 0 0) region(Point))
    ] ]
    [ Object(id(EquipmentEvidence) class(UnverifiedEquipmentSpecifications) taxonomy(Robot Equipment DesignIntent) layer(Equipment)) [
      Interface(id(NitrogenPressureAndFlowUnknown) type(InspectionInterface) origin(0 2.14 -0.56) normal(0 0 1) tangent(1 0 0) region(Point))
      Interface(id(RcsValvesAndPhysicalRoutingUnknown) type(InspectionInterface) origin(0 2.14 -0.56) normal(0 0 1) tangent(1 0 0) region(Point))
      Interface(id(BatteryVoltageAndCapacityUnknown) type(InspectionInterface) origin(0 2.14 -0.56) normal(0 0 1) tangent(1 0 0) region(Point))
      Interface(id(HarnessRoutingAndDataProtocolUnknown) type(InspectionInterface) origin(0 2.14 -0.56) normal(0 0 1) tangent(1 0 0) region(Point))
      Interface(id(CabinAirFlowAndLifeSupportCapacityUnknown) type(InspectionInterface) origin(0 2.14 -0.56) normal(0 0 1) tangent(1 0 0) region(Point))
      Interface(id(RadiatorAttachmentHardwareUnknown) type(InspectionInterface) origin(0 2.14 -0.56) normal(0 0 1) tangent(1 0 0) region(Point))
      Interface(id(HeatTransferAndRejectionUnknown) type(InspectionInterface) origin(0 2.14 -0.56) normal(0 0 1) tangent(1 0 0) region(Point))
      Interface(id(OpticalCalibrationAndFieldOfViewUnknown) type(InspectionInterface) origin(0 2.14 -0.56) normal(0 0 1) tangent(1 0 0) region(Point))
    ] ]

EquipmentConnections ->
    NitrogenSupplyConnections
    EquipmentPowerConnections
    EquipmentDataConnections
    CabinAirConnections
    EquipmentThermalConnections
    RadiatorMountConnections

NitrogenSupplyConnections ->
    Connect(id(RcsTankPort) source(D1BayNitrogenLeft Outlet) target(D1BayManifold PortInlet) type(ConnectedTo))
    Connect(id(RcsTankStarboard) source(D1BayNitrogenRight Outlet) target(D1BayManifold StarboardInlet) type(ConnectedTo))
    Connect(id(RcsHighSide) source(D1BayManifold Outlet) target(D1BayRegulator HighSideInlet) type(ConnectedTo))
    Connect(id(RcsRegulated) source(D1BayRegulator RegulatedOutlet) target(RcsDistributionManifold Inlet) type(ConnectedTo))
    Connect(id(RcsFeedXMinus) source(RcsDistributionManifold XMinus) target(NozzleGroupXMinus Inlet) type(ConnectedTo))
    Connect(id(RcsBranchXMinus00) source(NozzleGroupXMinus Header) target(NozzleXMinus00 Inlet) type(ConnectedTo))
    Connect(id(RcsBranchXMinus01) source(NozzleGroupXMinus Header) target(NozzleXMinus01 Inlet) type(ConnectedTo))
    Connect(id(RcsBranchXMinus10) source(NozzleGroupXMinus Header) target(NozzleXMinus10 Inlet) type(ConnectedTo))
    Connect(id(RcsBranchXMinus11) source(NozzleGroupXMinus Header) target(NozzleXMinus11 Inlet) type(ConnectedTo))
    Connect(id(RcsFeedXPlus) source(RcsDistributionManifold XPlus) target(NozzleGroupXPlus Inlet) type(ConnectedTo))
    Connect(id(RcsBranchXPlus00) source(NozzleGroupXPlus Header) target(NozzleXPlus00 Inlet) type(ConnectedTo))
    Connect(id(RcsBranchXPlus01) source(NozzleGroupXPlus Header) target(NozzleXPlus01 Inlet) type(ConnectedTo))
    Connect(id(RcsBranchXPlus10) source(NozzleGroupXPlus Header) target(NozzleXPlus10 Inlet) type(ConnectedTo))
    Connect(id(RcsBranchXPlus11) source(NozzleGroupXPlus Header) target(NozzleXPlus11 Inlet) type(ConnectedTo))
    Connect(id(RcsFeedYMinus) source(RcsDistributionManifold YMinus) target(NozzleGroupYMinus Inlet) type(ConnectedTo))
    Connect(id(RcsBranchYMinus00) source(NozzleGroupYMinus Header) target(NozzleYMinus00 Inlet) type(ConnectedTo))
    Connect(id(RcsBranchYMinus01) source(NozzleGroupYMinus Header) target(NozzleYMinus01 Inlet) type(ConnectedTo))
    Connect(id(RcsBranchYMinus10) source(NozzleGroupYMinus Header) target(NozzleYMinus10 Inlet) type(ConnectedTo))
    Connect(id(RcsBranchYMinus11) source(NozzleGroupYMinus Header) target(NozzleYMinus11 Inlet) type(ConnectedTo))
    Connect(id(RcsFeedYPlus) source(RcsDistributionManifold YPlus) target(NozzleGroupYPlus Inlet) type(ConnectedTo))
    Connect(id(RcsBranchYPlus00) source(NozzleGroupYPlus Header) target(NozzleYPlus00 Inlet) type(ConnectedTo))
    Connect(id(RcsBranchYPlus01) source(NozzleGroupYPlus Header) target(NozzleYPlus01 Inlet) type(ConnectedTo))
    Connect(id(RcsBranchYPlus10) source(NozzleGroupYPlus Header) target(NozzleYPlus10 Inlet) type(ConnectedTo))
    Connect(id(RcsBranchYPlus11) source(NozzleGroupYPlus Header) target(NozzleYPlus11 Inlet) type(ConnectedTo))
    Connect(id(RcsFeedZMinus) source(RcsDistributionManifold ZMinus) target(NozzleGroupZMinus Inlet) type(ConnectedTo))
    Connect(id(RcsBranchZMinus00) source(NozzleGroupZMinus Header) target(NozzleZMinus00 Inlet) type(ConnectedTo))
    Connect(id(RcsBranchZMinus01) source(NozzleGroupZMinus Header) target(NozzleZMinus01 Inlet) type(ConnectedTo))
    Connect(id(RcsBranchZMinus10) source(NozzleGroupZMinus Header) target(NozzleZMinus10 Inlet) type(ConnectedTo))
    Connect(id(RcsBranchZMinus11) source(NozzleGroupZMinus Header) target(NozzleZMinus11 Inlet) type(ConnectedTo))
    Connect(id(RcsFeedZPlus) source(RcsDistributionManifold ZPlus) target(NozzleGroupZPlus Inlet) type(ConnectedTo))
    Connect(id(RcsBranchZPlus00) source(NozzleGroupZPlus Header) target(NozzleZPlus00 Inlet) type(ConnectedTo))
    Connect(id(RcsBranchZPlus01) source(NozzleGroupZPlus Header) target(NozzleZPlus01 Inlet) type(ConnectedTo))
    Connect(id(RcsBranchZPlus10) source(NozzleGroupZPlus Header) target(NozzleZPlus10 Inlet) type(ConnectedTo))
    Connect(id(RcsBranchZPlus11) source(NozzleGroupZPlus Header) target(NozzleZPlus11 Inlet) type(ConnectedTo))

EquipmentPowerConnections ->
    Connect(id(BatteryToVehicleBus) source(D1BayBattery Output) target(VehiclePowerBus BatteryIn) type(Powers))
    Connect(id(VehicleBusToAvionics) source(VehiclePowerBus AvionicsOut) target(D1BayAvionics PowerIn) type(Powers))
    Connect(id(VehicleBusToLifeSupport) source(VehiclePowerBus LifeSupportOut) target(RobotLifeSupport PowerIn) type(Powers))
    Connect(id(VehicleBusToPortBay) source(VehiclePowerBus PortBayOut) target(D5PartD4_RearBayServiceDisconnectPort VehicleFeed) type(Powers))
    Connect(id(VehicleBusToStarboardBay) source(VehiclePowerBus StarboardBayOut) target(D5PartD4_RearBayServiceDisconnectStarboard VehicleFeed) type(Powers))
    Connect(id(VehicleBusToOpticsPort) source(VehiclePowerBus PortOpticsOut) target(RendezvousOpticalHeadPort PowerIn) type(Powers))
    Connect(id(VehicleBusToOpticsStarboard) source(VehiclePowerBus StarboardOpticsOut) target(RendezvousOpticalHeadStarboard PowerIn) type(Powers))

EquipmentDataConnections ->
    Connect(id(LifeSupportStatusToAvionics) source(RobotLifeSupport StatusOut) target(D1BayAvionics LifeSupportStatusIn) type(ConnectedTo))
    Connect(id(OpticalImagesPort) source(RendezvousOpticalHeadPort ImagesOut) target(D1BayAvionics PortImagesIn) type(ConnectedTo))
    Connect(id(OpticalImagesStarboard) source(RendezvousOpticalHeadStarboard ImagesOut) target(D1BayAvionics StarboardImagesIn) type(ConnectedTo))

CabinAirConnections ->
    Connect(id(CabinAirSupply) source(RobotLifeSupport SupplyOut) target(RobotPressureCapsule AirSupplyIn) type(ConnectedTo))
    Connect(id(CabinAirReturn) source(RobotPressureCapsule AirReturnOut) target(RobotLifeSupport ReturnIn) type(ConnectedTo))

EquipmentThermalConnections ->
    Connect(id(HeatFromAvionics) source(D1BayAvionics HeatOut) target(EquipmentHeatCollection AvionicsIn) type(ConnectedTo))
    Connect(id(HeatFromLifeSupport) source(RobotLifeSupport HeatOut) target(EquipmentHeatCollection LifeSupportIn) type(ConnectedTo))
    Connect(id(HeatToRadiatorPort) source(EquipmentHeatCollection PortOut) target(D1BayRadiatorLeft HeatIn) type(ConnectedTo))
    Connect(id(HeatToRadiatorStarboard) source(EquipmentHeatCollection StarboardOut) target(D1BayRadiatorRight HeatIn) type(ConnectedTo))

RadiatorMountConnections ->
    Connect(id(MountRadiatorPort) source(D1AftEquipmentBulkhead PortRadiatorMount) target(D1BayRadiatorLeft Mount) type(FixedTo))
    Connect(id(MountRadiatorStarboard) source(D1AftEquipmentBulkhead StarboardRadiatorMount) target(D1BayRadiatorRight Mount) type(FixedTo))
