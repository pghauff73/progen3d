# Meridian U11 orbital service robot. Distances in metres, roll in degrees.
# Start -> MeridianRobot(surfaceDetail socketRoll)
# surfaceDetail 1 uses the archived U11 appearance. 0 focuses the view on major assemblies.
# socketRoll turns the driver about its own +Z axis. The wrist housing stays fixed.
# The original folded stance, mount centres and scene placement are retained.
# Guide jaw and foot clamp interfaces are inspection datums, not validated mates.

# Stage 2. Each limb command takes three joint deltas in degrees about local +X
# in the frozen-pose reference. The model accepts a provisional +/-30 deg per joint.
# Guide jaw and leg clamp travel are total increases in pad gap, in model metres.
# Travel range is 0..0.08. Invalid commands hold that limb at its reference values.
# The inherited socketRoll input remains independent of the socket wrist delta.
# MeridianRobotLocal(surfaceDetail socketRoll) uses the same assembly in its authoring frame.
# Try the nominal clamp gauge by setting Start -> ClampRailTrial(0 0.20 0.005 0.04).

# Stage 3 service commands. The normal entry keeps the uncrewed U11 closed.
# DorsalHatchCommand: permit (0/1), release (0/1), requested swing (0..70 degrees).
# PortPanelCommand and StarboardPanelCommand: isolated (0/1), released (0/1),
# and outward cassette travel (0..0.35 m in authoring coordinates).
# Installation and closure links use nominal model datums. They do not establish fit or sealing.
# Stage 4 hidden equipment. Typed links declare direction and functional intent.
# Nozzle origins and exhaust axes follow rendered hardware. Optical axes use the lens centres.
# Network nodes carry nominal interface datums. Pipe, cable and duct paths still require routing.
# Missing performance and mounting specifications are listed in EquipmentEvidence.
Start -> MeridianRobot(1 0)

MeridianRobot(surfaceDetail socketRoll) ->
 [ Object(id(MeridianRobot) class(OrbitalServiceRobot) taxonomy(Robot Meridian ServiceRobot) layer(Equipment))
   [ T(114.23759 13.45253 -475.9835) A(-0.000000000 2) A(-28.586139691 1) A(6.839241492 0) S(1.813772000 1.813772000 1.813772000) T(0 -1.88748 0.00027) RobotAssembly(surfaceDetail socketRoll) ] ]

# Stage 1 ownership. The full mode emits documented detail under its native host.
# The pose deltas below use robot-authoring metres and degrees.
# The pivot on each line is an explicit reference for edits, not a physical joint.

HostPlacement(x y z angle axisIndex pivotX pivotY pivotZ) ->
    T(x y z) HostRotation(angle axisIndex pivotX pivotY pivotZ)

HostRotation(angle axisIndex pivotX pivotY pivotZ) ->
    ?(angle==0) T(0 0 0) : RotateHostAbout(angle axisIndex pivotX pivotY pivotZ)

RotateHostAbout(angle axisIndex pivotX pivotY pivotZ) ->
    T(pivotX pivotY pivotZ) A(angle axisIndex) T(0-pivotX 0-pivotY 0-pivotZ)

PlacementD1BayAvionics -> HostPlacement(0 0 0 0 0 0 2.55 -0.55)

PlacementD1BayBattery -> HostPlacement(0 0 0 0 0 0 1.78 -0.55)

PlacementD2MovingGuideGripper -> HostPlacement(0 0 0 0 0 0.76 2.35 -0.45)

PlacementD5PartAftBayPanelPort -> HostPlacement(0 0 0 0 0 -0.505 2.165 -0.592)

PlacementD5PartAftBayPanelStarboard -> HostPlacement(0 0 0 0 0 0.505 2.165 -0.592)

PlacementD5PartGuideArmCableCarrierCover0 -> HostPlacement(0 0 0 0 0 0.8157512 2.1110845 -0.0289246)

PlacementD5PartGuideArmCableCarrierCover1 -> HostPlacement(0 0 0 0 0 0.8495853 1.9984741 -0.0682077)

PlacementD5PartGuideArmCableCarrierCover2 -> HostPlacement(0 0 0 0 0 0.8834195 1.8858638 -0.1074908)

PlacementD5PartSocketArmCableCarrierCover0 -> HostPlacement(0 0 0 0 0 -0.824681 2.1183659 -0.0682997)

PlacementD5PartSocketArmCableCarrierCover1 -> HostPlacement(0 0 0 0 0 -0.8644683 2.0106098 -0.1338329)

PlacementD5PartSocketArmCableCarrierCover2 -> HostPlacement(0 0 0 0 0 -0.9042556 1.9028537 -0.1993661)

PlacementD61GuideArmProtectiveCover0 -> HostPlacement(0 0 0 0 0 0.7582849 2.0660403 -0.0146379)

PlacementD61GuideArmProtectiveCover1 -> HostPlacement(0 0 0 0 0 0.8482858 1.9575079 -0.2688776)

PlacementD61LeftLegProtectiveCover0 -> HostPlacement(0 0 0 0 0 -0.5441876 1.3987226 0.1913653)

PlacementD61LeftLegProtectiveCover1 -> HostPlacement(0 0 0 0 0 -0.6236496 1.5411313 0.5996331)

PlacementD61RightLegProtectiveCover0 -> HostPlacement(0 0 0 0 0 0.5462064 1.4002094 0.2082349)

PlacementD61RightLegProtectiveCover1 -> HostPlacement(0 0 0 0 0 0.6264375 1.5725844 0.6229292)

PlacementD61ServiceBayPortStripe -> HostPlacement(0 0 0 0 0 -0.554 2.175 -0.588)

PlacementD61ServiceBayStarboardStripe -> HostPlacement(0 0 0 0 0 0.554 2.175 -0.588)

PlacementD61SocketArmProtectiveCover0 -> HostPlacement(0 0 0 0 0 -0.7695959 2.0752634 -0.064513)

PlacementD61SocketArmProtectiveCover1 -> HostPlacement(0 0 0 0 0 -0.8667407 1.9725561 -0.3502528)

PlacementD7PartGuideArmEtchedDataPlate -> HostPlacement(0 0 0 0 0 0.7779687 1.9872131 -0.034136)

PlacementD7PartLeftLegEtchedDataPlate -> HostPlacement(0 0 0 0 0 -0.5398514 1.372228 0.2615952)

PlacementD7PartRightLegEtchedDataPlate -> HostPlacement(0 0 0 0 0 0.5423508 1.3740688 0.2824813)

PlacementD7PartSocketArmEtchedDataPlate -> HostPlacement(0 0 0 0 0 -0.793447 1.9998342 -0.1023862)

PlacementRobotGuideArm -> HostPlacement(0 0 0 0 0 0.63 2.28 0.095)

PlacementRobotHipFrame -> HostPlacement(0 0 0 0 0 0 1.48 -0.02)

PlacementRobotLeftLeg -> HostPlacement(0 0 0 0 0 -0.44 1.51 -0.035)

PlacementRobotLifeSupport -> HostPlacement(0 0 0 0 0 0 0 0)

PlacementRobotRightLeg -> HostPlacement(0 0 0 0 0 0.44 1.51 -0.035)

PlacementRobotSocketArm -> HostPlacement(0 0 0 0 0 -0.63 2.28 0.095)

RobotAssembly(surfaceDetail socketRoll) ->
    [ D1Architecture(surfaceDetail) ]
    [ ?(surfaceDetail==1) [ D6PhotorealDetail ] : [] ]
    [ D61IndustrialExterior(surfaceDetail) ]

    [ ?(surfaceDetail==1) [ D9NativeSurfaceRelief U10UniversalSurfaceRelief ] : [] ]

    [ D5ExteriorAssembly(surfaceDetail) ]
    [ Object(id(RobotPressureCapsule) class(RobotPart) taxonomy(Robot PressureCapsule) layer(Equipment)) [
      Interface(id(AirSupplyIn) type(DuctPort) origin(0.20 2.17 -0.30) normal(0 0 -1) tangent(1 0 0) region(Point))
      Interface(id(AirReturnOut) type(DuctPort) origin(-0.20 2.17 -0.30) normal(0 0 -1) tangent(1 0 0) region(Point))
      Interface(id(DorsalHatchOpening) type(Mate) origin(0 2.589 0.14) normal(0 1 0) tangent(1 0 0) region(Point))

      Interface(id(VisorOpening) type(Seal) origin(0 2.13 0.645) normal(0 0 1) tangent(1 0 0) region(Point))

      Interface(id(SeatInstall) type(Mate) origin(0 1.88 -0.05) normal(0 1 0) tangent(1 0 0) region(Point))
       T(0 0 0) PressureCapsule ] ]
    [ Object(id(RobotVisorGasket) class(RobotPart) taxonomy(Robot VisorGasket) layer(Equipment)) [
      Interface(id(CanopyFace) type(Seal) origin(0 2.13 0.645) normal(0 0 1) tangent(1 0 0) region(Point))

      Interface(id(CabinFace) type(Seal) origin(0 2.13 0.645) normal(0 0 1) tangent(1 0 0) region(Point))
       T(0 0 0) VisorGasket ] ]
    [ Object(id(RobotEmptySeat) class(RobotPart) taxonomy(Robot EmptySeat) layer(Equipment)) [
      Interface(id(SeatBase) type(Mate) origin(0 1.88 -0.05) normal(0 1 0) tangent(1 0 0) region(Point))
       T(0 0 0) EmptySeat ] ]
    [ PlacementRobotLifeSupport Object(id(RobotLifeSupport) class(CabinLifeSupport) taxonomy(Habitation AirHandling) layer(Equipment)) [
      Interface(id(PowerIn) type(ElectricalPort) origin(0 2.17 -0.76) normal(0 0 -1) tangent(1 0 0) region(Point))
      Interface(id(StatusOut) type(DataPort) origin(0.08 2.17 -0.76) normal(0 0 -1) tangent(1 0 0) region(Point))
      Interface(id(ReturnIn) type(DuctPort) origin(-0.20 2.17 -0.34) normal(0 0 1) tangent(1 0 0) region(Point))
      Interface(id(SupplyOut) type(DuctPort) origin(0.20 2.17 -0.34) normal(0 0 1) tangent(1 0 0) region(Point))
      Interface(id(HeatOut) type(ThermalInterface) origin(0 2.17 -0.76) normal(0 0 -1) tangent(1 0 0) region(Point)) T(0 0 0) LifeSupport
      ?(surfaceDetail==1) [ U10RobotLifeSupport ] : []
    ] ]
    [ PlacementRobotHipFrame Object(id(RobotHipFrame) class(RobotPart) taxonomy(Robot HipFrame) layer(Equipment)) [
      Interface(id(RightHipSeat) type(Hinge) origin(0.44 1.51 -0.035) normal(1 0 0) tangent(0 1 0) region(Point))

      Interface(id(LeftHipSeat) type(Hinge) origin(-0.44 1.51 -0.035) normal(1 0 0) tangent(0 1 0) region(Point))

      Interface(id(LowerMemberSeat) type(Mate) origin(0 1.48 -0.20) normal(0 1 0) tangent(1 0 0) region(Point))
       T(0 0 0) HipFrame
      ?(surfaceDetail==1) [ U10RobotHipFrame U11Macro_RobotHipFrame_000 U11Macro_RobotHipFrame_001 U11Macro_RobotHipFrame_002 U11Macro_RobotHipFrame_003 U11Macro_RobotHipFrame_004 ] : []
    ] ]
    [ Object(id(RobotCanopy) class(RobotPart) taxonomy(Robot Canopy) layer(Equipment)) [
      Interface(id(GasketFace) type(Seal) origin(0 2.13 0.645) normal(0 0 1) tangent(1 0 0) region(Point))
       T(0 0 0) Canopy ] ]
    [ Object(id(RobotPropulsion) class(ReactionControlAssembly) taxonomy(Robot Propulsion) layer(Equipment)) [ T(0 0 0) Propulsion ] ]
    [ PlacementRobotLeftLeg Object(id(RobotLeftLeg) class(RobotPart) taxonomy(Robot LeftLeg) layer(Equipment)) [
      LeftLegCommand(surfaceDetail)
    ] ]
    [ PlacementRobotRightLeg Object(id(RobotRightLeg) class(RobotPart) taxonomy(Robot RightLeg) layer(Equipment)) [
      RightLegCommand(surfaceDetail)
    ] ]
    [ PlacementRobotSocketArm Object(id(RobotSocketArm) class(SocketManipulator) taxonomy(Robot SocketArm) layer(Equipment)) [
      SocketArmCommand(surfaceDetail socketRoll)
    ] ]
    [ PlacementRobotGuideArm Object(id(RobotGuideArm) class(GuideManipulator) taxonomy(Robot GuideArm) layer(Equipment)) [
      GuideArmCommand(surfaceDetail)
    ] ]

    Connect(id(SocketDriveAlignment) source(RobotSocketDriver Spindle) target(RobotSocketWrist DriveSocket) type(AlignedWith))

    CabinServiceConfiguration
    DorsalHatchCommand(surfaceDetail)
    PortPanelCommand(surfaceDetail)
    StarboardPanelCommand(surfaceDetail)
    InstallationConnections
    EquipmentNetworkNodes
    EquipmentConnections

# Six four-station groups share three placement rules and one nozzle geometry.
# Station suffixes identify row and column. The ports are in the nozzle's local frame.
Propulsion ->
    NozzleGroupXMinus(-0.58 -1)
    NozzleGroupXPlus(0.58 1)
    NozzleGroupYMinus(1.62 -1)
    NozzleGroupYPlus(2.48 1)
    NozzleGroupZMinus(-0.54 -1)
    NozzleGroupZPlus(0.34 1)

NozzleGroupXMinus(x sign) ->
    [ Object(id(NozzleGroupXMinus) class(NozzleSupplyGroup) taxonomy(Propulsion Nitrogen FaceGroup) layer(Equipment)) [
      Interface(id(Inlet) type(PipePort) origin(x 2.05 -0.10) normal(0-sign 0 0) tangent(0 0 1) region(Point))
      Interface(id(Header) type(PipePort) origin(x 2.05 -0.10) normal(sign 0 0) tangent(0 0 1) region(Point))
      [ NozzleXPlacement(x 0 0 90*sign)
        Object(id(NozzleXMinus00) class(ReactionNozzle) taxonomy(Propulsion Nitrogen Nozzle) layer(Equipment)) [ NozzleStation ] ]
      [ NozzleXPlacement(x 0 1 90*sign)
        Object(id(NozzleXMinus01) class(ReactionNozzle) taxonomy(Propulsion Nitrogen Nozzle) layer(Equipment)) [ NozzleStation ] ]
      [ NozzleXPlacement(x 1 0 90*sign)
        Object(id(NozzleXMinus10) class(ReactionNozzle) taxonomy(Propulsion Nitrogen Nozzle) layer(Equipment)) [ NozzleStation ] ]
      [ NozzleXPlacement(x 1 1 90*sign)
        Object(id(NozzleXMinus11) class(ReactionNozzle) taxonomy(Propulsion Nitrogen Nozzle) layer(Equipment)) [ NozzleStation ] ]
    ] ]

NozzleGroupXPlus(x sign) ->
    [ Object(id(NozzleGroupXPlus) class(NozzleSupplyGroup) taxonomy(Propulsion Nitrogen FaceGroup) layer(Equipment)) [
      Interface(id(Inlet) type(PipePort) origin(x 2.05 -0.10) normal(0-sign 0 0) tangent(0 0 1) region(Point))
      Interface(id(Header) type(PipePort) origin(x 2.05 -0.10) normal(sign 0 0) tangent(0 0 1) region(Point))
      [ NozzleXPlacement(x 0 0 90*sign)
        Object(id(NozzleXPlus00) class(ReactionNozzle) taxonomy(Propulsion Nitrogen Nozzle) layer(Equipment)) [ NozzleStation ] ]
      [ NozzleXPlacement(x 0 1 90*sign)
        Object(id(NozzleXPlus01) class(ReactionNozzle) taxonomy(Propulsion Nitrogen Nozzle) layer(Equipment)) [ NozzleStation ] ]
      [ NozzleXPlacement(x 1 0 90*sign)
        Object(id(NozzleXPlus10) class(ReactionNozzle) taxonomy(Propulsion Nitrogen Nozzle) layer(Equipment)) [ NozzleStation ] ]
      [ NozzleXPlacement(x 1 1 90*sign)
        Object(id(NozzleXPlus11) class(ReactionNozzle) taxonomy(Propulsion Nitrogen Nozzle) layer(Equipment)) [ NozzleStation ] ]
    ] ]

NozzleGroupYMinus(y sign) ->
    [ Object(id(NozzleGroupYMinus) class(NozzleSupplyGroup) taxonomy(Propulsion Nitrogen FaceGroup) layer(Equipment)) [
      Interface(id(Inlet) type(PipePort) origin(0 y -0.10) normal(0 0-sign 0) tangent(1 0 0) region(Point))
      Interface(id(Header) type(PipePort) origin(0 y -0.10) normal(0 sign 0) tangent(1 0 0) region(Point))
      [ NozzleYPlacement(y 0 0 90+90*sign)
        Object(id(NozzleYMinus00) class(ReactionNozzle) taxonomy(Propulsion Nitrogen Nozzle) layer(Equipment)) [ NozzleStation ] ]
      [ NozzleYPlacement(y 0 1 90+90*sign)
        Object(id(NozzleYMinus01) class(ReactionNozzle) taxonomy(Propulsion Nitrogen Nozzle) layer(Equipment)) [ NozzleStation ] ]
      [ NozzleYPlacement(y 1 0 90+90*sign)
        Object(id(NozzleYMinus10) class(ReactionNozzle) taxonomy(Propulsion Nitrogen Nozzle) layer(Equipment)) [ NozzleStation ] ]
      [ NozzleYPlacement(y 1 1 90+90*sign)
        Object(id(NozzleYMinus11) class(ReactionNozzle) taxonomy(Propulsion Nitrogen Nozzle) layer(Equipment)) [ NozzleStation ] ]
    ] ]

NozzleGroupYPlus(y sign) ->
    [ Object(id(NozzleGroupYPlus) class(NozzleSupplyGroup) taxonomy(Propulsion Nitrogen FaceGroup) layer(Equipment)) [
      Interface(id(Inlet) type(PipePort) origin(0 y -0.10) normal(0 0-sign 0) tangent(1 0 0) region(Point))
      Interface(id(Header) type(PipePort) origin(0 y -0.10) normal(0 sign 0) tangent(1 0 0) region(Point))
      [ NozzleYPlacement(y 0 0 90+90*sign)
        Object(id(NozzleYPlus00) class(ReactionNozzle) taxonomy(Propulsion Nitrogen Nozzle) layer(Equipment)) [ NozzleStation ] ]
      [ NozzleYPlacement(y 0 1 90+90*sign)
        Object(id(NozzleYPlus01) class(ReactionNozzle) taxonomy(Propulsion Nitrogen Nozzle) layer(Equipment)) [ NozzleStation ] ]
      [ NozzleYPlacement(y 1 0 90+90*sign)
        Object(id(NozzleYPlus10) class(ReactionNozzle) taxonomy(Propulsion Nitrogen Nozzle) layer(Equipment)) [ NozzleStation ] ]
      [ NozzleYPlacement(y 1 1 90+90*sign)
        Object(id(NozzleYPlus11) class(ReactionNozzle) taxonomy(Propulsion Nitrogen Nozzle) layer(Equipment)) [ NozzleStation ] ]
    ] ]

NozzleGroupZMinus(z sign) ->
    [ Object(id(NozzleGroupZMinus) class(NozzleSupplyGroup) taxonomy(Propulsion Nitrogen FaceGroup) layer(Equipment)) [
      Interface(id(Inlet) type(PipePort) origin(0 2.05 z) normal(0 0 0-sign) tangent(1 0 0) region(Point))
      Interface(id(Header) type(PipePort) origin(0 2.05 z) normal(0 0 sign) tangent(1 0 0) region(Point))
      [ NozzleZPlacement(z 0 0 90-90*sign 90*sign-90)
        Object(id(NozzleZMinus00) class(ReactionNozzle) taxonomy(Propulsion Nitrogen Nozzle) layer(Equipment)) [ NozzleStation ] ]
      [ NozzleZPlacement(z 0 1 90-90*sign 90*sign-90)
        Object(id(NozzleZMinus01) class(ReactionNozzle) taxonomy(Propulsion Nitrogen Nozzle) layer(Equipment)) [ NozzleStation ] ]
      [ NozzleZPlacement(z 1 0 90-90*sign 90*sign-90)
        Object(id(NozzleZMinus10) class(ReactionNozzle) taxonomy(Propulsion Nitrogen Nozzle) layer(Equipment)) [ NozzleStation ] ]
      [ NozzleZPlacement(z 1 1 90-90*sign 90*sign-90)
        Object(id(NozzleZMinus11) class(ReactionNozzle) taxonomy(Propulsion Nitrogen Nozzle) layer(Equipment)) [ NozzleStation ] ]
    ] ]

NozzleGroupZPlus(z sign) ->
    [ Object(id(NozzleGroupZPlus) class(NozzleSupplyGroup) taxonomy(Propulsion Nitrogen FaceGroup) layer(Equipment)) [
      Interface(id(Inlet) type(PipePort) origin(0 2.05 z) normal(0 0 0-sign) tangent(1 0 0) region(Point))
      Interface(id(Header) type(PipePort) origin(0 2.05 z) normal(0 0 sign) tangent(1 0 0) region(Point))
      [ NozzleZPlacement(z 0 0 90-90*sign 90*sign-90)
        Object(id(NozzleZPlus00) class(ReactionNozzle) taxonomy(Propulsion Nitrogen Nozzle) layer(Equipment)) [ NozzleStation ] ]
      [ NozzleZPlacement(z 0 1 90-90*sign 90*sign-90)
        Object(id(NozzleZPlus01) class(ReactionNozzle) taxonomy(Propulsion Nitrogen Nozzle) layer(Equipment)) [ NozzleStation ] ]
      [ NozzleZPlacement(z 1 0 90-90*sign 90*sign-90)
        Object(id(NozzleZPlus10) class(ReactionNozzle) taxonomy(Propulsion Nitrogen Nozzle) layer(Equipment)) [ NozzleStation ] ]
      [ NozzleZPlacement(z 1 1 90-90*sign 90*sign-90)
        Object(id(NozzleZPlus11) class(ReactionNozzle) taxonomy(Propulsion Nitrogen Nozzle) layer(Equipment)) [ NozzleStation ] ]
    ] ]

NozzleXPlacement(x row column yaw) ->
    T(x 1.62+0.86*row -0.54+0.88*column) A(0 2) A(yaw 1) A(0 0)

NozzleYPlacement(y row column roll) ->
    T(-0.58+1.16*row y -0.54+0.88*column) A(roll 2) A(0 1) A(90 0)

NozzleZPlacement(z row column roll pitch) ->
    T(-0.58+1.16*row 1.62+0.86*column z) A(roll 2) A(0 1) A(pitch 0)

NozzleStation ->
    Interface(id(Inlet) type(PipePort) origin(0 0 -0.01) normal(0 0 -1) tangent(1 0 0) region(Point))
    Interface(id(ExhaustAxis) type(InspectionInterface) origin(0 0 0.09) normal(0 0 1) tangent(1 0 0) region(Point))
    ReactionNozzle

ReactionNozzle ->
    [ !I(SweepDisk(path(0 0 -0.01 0 0 0.09) radius(0.045) segments(12) cap(all)) material(charcoalmattemetal) 1 1) ]
    [ !I(SweepDisk(path(0 0 0.055 0 0 0.09) radius(0.049) segments(12) cap(all)) material(silverbrushedmetal) 1 1) ]

SocketWrist(socketRoll) ->
    [ Object(id(RobotSocketWrist) class(SocketWrist) taxonomy(Robot Arm Wrist)) [
      Interface(id(DriveSocket) type(Socket) origin(0 -0.07 0.12) normal(0 0 1) tangent(1 0 0) region(AxisSegment 0.33))
      SocketArmHand(socketRoll)
    ] ]

SocketDriver ->
    [ Object(id(RobotSocketDriver) class(RotaryTool) taxonomy(Robot Tool SocketDriver) container(RobotSocketWrist)) [
      Interface(id(Spindle) type(Shaft) origin(0 0 0.12) normal(0 0 1) tangent(1 0 0) region(AxisSegment 0.33))
      Interface(id(SocketTip) type(InspectionInterface) origin(0 0 0.55) normal(0 0 1) tangent(1 0 0) region(Point))
      SocketToolLocal
    ] ]

GuideWrist ->
    [ Object(id(RobotGuideWrist) class(GuideGripper) taxonomy(Robot Arm Guide)) [
      Interface(id(GuideDatum) type(InspectionInterface) origin(0 0 0.205) normal(0 0 1) tangent(1 0 0) region(Point))
      GuideArmHand
    ] ]

LeftClampAssembly(travel) ->
    [ Object(id(RobotLeftClamp) class(TrussClamp) taxonomy(Robot Leg Clamp)) [
      Interface(id(FrameMount) type(Mate) origin(0 0 0) normal(0 0 1) tangent(1 0 0) region(Point))

      Interface(id(ClampRoot) type(InspectionInterface) origin(0 0 0) normal(0 0 1) tangent(1 0 0) region(Point))
      LeftLegClamp(travel)
    ] ]

RightClampAssembly(travel) ->
    [ Object(id(RobotRightClamp) class(TrussClamp) taxonomy(Robot Leg Clamp)) [
      Interface(id(FrameMount) type(Mate) origin(0 0 0) normal(0 0 1) tangent(1 0 0) region(Point))

      Interface(id(ClampRoot) type(InspectionInterface) origin(0 0 0) normal(0 0 1) tangent(1 0 0) region(Point))
      RightLegClamp(travel)
    ] ]

PressureCapsule ->
    # D3: original continuous uncut body loft replaced by analytically apertured panel shell
    [ T(0 2.12 -0.3) !I(Loft(
        section(-0.07 Polygon 0.25818 0.10318 0.24993 0.16923 0.23302 0.20951 0.20629 0.23666 0.16663 0.25383 0.10159 0.26221 -0.10159 0.26221 -0.16663 0.25383 -0.20629 0.23666 -0.23302 0.20951 -0.24993 0.16923 -0.25818 0.10318 -0.25818 -0.10318 -0.24993 -0.16923 -0.23302 -0.20951 -0.20629 -0.23666 -0.16663 -0.25383 -0.10159 -0.26221 0.10159 -0.26221 0.16663 -0.25383 0.20629 -0.23666 0.23302 -0.20951 0.24993 -0.16923 0.25818 -0.10318)
        section(-0.0532 Polygon 0.30918 0.12356 0.2993 0.20266 0.27905 0.2509 0.24704 0.28341 0.19954 0.30398 0.12166 0.31401 -0.12166 0.31401 -0.19954 0.30398 -0.24704 0.28341 -0.27905 0.2509 -0.2993 0.20266 -0.30918 0.12356 -0.30918 -0.12356 -0.2993 -0.20266 -0.27905 -0.2509 -0.24704 -0.28341 -0.19954 -0.30398 -0.12166 -0.31401 0.12166 -0.31401 0.19954 -0.30398 0.24704 -0.28341 0.27905 -0.2509 0.2993 -0.20266 0.30918 -0.12356)
        section(-0.035 Polygon 0.31874 0.12738 0.30856 0.20892 0.28768 0.25866 0.25468 0.29217 0.20571 0.31338 0.12542 0.32372 -0.12542 0.32372 -0.20571 0.31338 -0.25468 0.29217 -0.28768 0.25866 -0.30856 0.20892 -0.31874 0.12738 -0.31874 -0.12738 -0.30856 -0.20892 -0.28768 -0.25866 -0.25468 -0.29217 -0.20571 -0.31338 -0.12542 -0.32372 0.12542 -0.32372 0.20571 -0.31338 0.25468 -0.29217 0.28768 -0.25866 0.30856 -0.20892 0.31874 -0.12738)
