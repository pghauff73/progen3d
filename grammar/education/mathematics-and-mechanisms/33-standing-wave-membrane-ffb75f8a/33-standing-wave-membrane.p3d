# Rectangular membrane eigenmode. Membrane(m n amplitude waveSpeed cellsPerLobe).
# The clear span is 4.60 by 3.20. Use an even cellsPerLobe (try 4, 6 or 8).
# The time phase starts at a displacement maximum. Swap m and n to compare.
Start -> Membrane(2 3 0.38 1.4 6)

Membrane(m n h c d) ->
 [ Exhibit(m n d h*cos(3.14159265359*c*t*sqrt(m*m/4.60/4.60+n*n/3.20/3.20))) ]
Exhibit(m n d height) ->
 [ Object(id(Exhibit) class(MembraneModeExhibit) taxonomy(Study Acoustics Membrane) layer(Equipment)) [
   [ Object(id(Stand) class(MembraneFrame) taxonomy(Study Acoustics Frame) layer(Structure)) [ Base ] ]
   [ T(-2.30 1.05 -1.60)
     [ Object(id(Cloth) class(DisplacedMembrane) taxonomy(Study Acoustics Surface) layer(Equipment)) [
       Rows(m n d height) ] ]
     [ Object(id(Nodes) class(InteriorNodalLines) taxonomy(Study Acoustics Reference) layer(Equipment)) [
       NodeX(m-1 4.60/m) NodeZ(n-1 3.20/n) ] ]
     [ Object(id(Peaks) class(AntinodeMarkers) taxonomy(Study Acoustics Reference) layer(Equipment)) [
       MarkX(m n height) ] ] ] ] ]

Rows(m n d h) m*d ->
 [ Row(n d h 4.60*Rows_count/m/d 4.60/m/d
        sin(3.14159265359*Rows_count/d) sin(3.14159265359*(Rows_count+1)/d) floor(Rows_count/d)) ]
Row(n d h x dx p q i) n*d ->
 [ Cell(x dx 3.20*Row_count/n/d 3.20/n/d h*p h*q
          sin(3.14159265359*Row_count/d) sin(3.14159265359*(Row_count+1)/d) wrap(i+floor(Row_count/d),0,2)) ]
Cell(x dx z dz p q s t0 parity) ->
 [ T(x 0 z) Panel(dx dz p*s q*s p*t0 q*t0 parity) ]
Panel(w d a b c e parity) -> ?(parity<0.5)
 [ !I(Loft(section(0 Polygon 0 a-0.027 w b-0.027 w b 0 a)
           section(d Polygon 0 c-0.027 w e-0.027 w e 0 c) cap(all)) material(tealmatteceramic) 1 0.25) ]
 : [ !I(Loft(section(0 Polygon 0 a-0.027 w b-0.027 w b 0 a)
             section(d Polygon 0 c-0.027 w e-0.027 w e 0 c) cap(all)) material(offwhiteceramic) 1 0.24) ]

NodeX(n dx) n ->
 [ T((NodeX_count+1)*dx 0.005 0)
   !I(TaperedSweep(samples(0 0 0 0.006 0 0 3.20 0.006) up(0 1 0) segments(8) cap(all))
     material(goldbrushedmetal) 1 0.24) ]
NodeZ(n dz) n ->
 [ T(0 0.005 (NodeZ_count+1)*dz)
   !I(TaperedSweep(samples(0 0 0 0.006 4.60 0 0 0.006) up(0 1 0) segments(8) cap(all))
     material(goldbrushedmetal) 1 0.24) ]

MarkX(m n h) m ->
 [ T(4.60*(MarkX_count+0.5)/m 0 0) MarkZ(n h MarkX_count) ]
MarkZ(n h i) n ->
 [ T(0 0.028+h*(1-2*wrap(i+MarkZ_count,0,2)) 3.20*(MarkZ_count+0.5)/n)
   S(0.068 0.068 0.068) !I(Sphere(segments(16 8)) material(goldbrushedmetal) 1 0.25) ]

Base ->
 [ T(0 0.096 0) S(5.53 0.192 4.19) !I(Cube material(amberwarmwood) 1 0.31) ]
 [ T(0 0.204 0) S(5.40 0.044 4.07) !I(Cube material(charcoalmattemetal) 1 0.26) ]
 [ T(0 0.226 1.99) S(5.18 0.014 0.024) !I(Cube material(goldbrushedmetal) 1 0.25) ]
 [ T(-2.40 0.226 -1.71) Tower ] [ T(2.40 0.226 -1.71) Tower ]
 [ T(-2.40 0.226 1.71) Tower ] [ T(2.40 0.226 1.71) Tower ]
 [ LongRail(-1.70) ] [ LongRail(1.70) ] [ ShortRail(-2.40) ] [ ShortRail(2.40) ]
 [ T(0 0.241 1.79) S(0.58 0.023 0.122) !I(Cube material(goldbrushedmetal) 1 0.25) ]
Tower ->
 [ T(0 0.041 0) S(0.347 0.082 0.347) !I(Cube material(goldbrushedmetal) 1 0.25) ]
 [ T(0 0.082 0) S(0.151 0.621 0.151) !I(Cylinder(segments(16 1)) material(silverbrushedmetal) 1 0.25) ]
 [ T(0 0.690 0) S(0.260 0.081 0.260) !I(Cube material(bluegreymattepaint) 1 0.26) ]
 [ T(0 0.885 0) S(0.096 0.022 0.096) !I(Cylinder(segments(8 1)) material(goldbrushedmetal) 1 0.24) ]
LongRail(z) ->
 [ T(0 1.012 z) S(5.02 0.157 0.20) !I(Cube material(bluegreymattepaint) 1 0.25) ]
 [ T(0 1.092 z) S(4.96 0.016 0.128) !I(Cube material(goldbrushedmetal) 1 0.25) ]
 [ T(0 1.105 z) A(90 1) Rivets(13 0.383) ]
ShortRail(x) ->
 [ T(x 1.012 0) S(0.20 0.157 3.20) !I(Cube material(bluegreymattepaint) 1 0.25) ]
 [ T(x 1.092 0) S(0.128 0.016 3.19) !I(Cube material(goldbrushedmetal) 1 0.25) ]
 [ T(x 1.105 0) Rivets(9 0.353) ]
Rivets(n step) n ->
 [ T(0 0 (Rivets_count-(n-1)/2)*step) S(0.037 0.009 0.037)
   !I(Cylinder(segments(8 1)) material(charcoalmattemetal) 1 0.25) ]
