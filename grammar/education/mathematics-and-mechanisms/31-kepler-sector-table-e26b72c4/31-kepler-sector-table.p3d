# Kepler sector table. Kepler(eccentricity sectors chordsPerSector period mode).
# Mode 0 gives equal time. Mode 1 gives equal increments of eccentric anomaly.
# Try e=0.68 or e=0.28. The moving planet keeps equal-area timing in both modes.
Start -> Kepler(0.68 8 24 8 0)

Kepler(e n m period mode) ->
 [ Table(e n m period mode 2.18 2.18*sqrt(1-e*e)) ]

Table(e n m period mode a b) ->
 [ Object(id(Exhibit) class(OrbitalAreaTable) taxonomy(Study Astronomy Orbit) layer(Equipment)) [
   [ Object(id(Bench) class(DisplayCase) taxonomy(Study Astronomy Mount) layer(Structure)) [ Bed ] ]
   [ Object(id(Sectors) class(AreaSectors) taxonomy(Study Astronomy Orbit) layer(Equipment))
     [ T(0 0.245 0) A(90 0) Zones(n m a b a*e e*(1-mode)) ] ]
   [ Object(id(Track) class(OrbitRim) taxonomy(Study Astronomy Rail) layer(Equipment))
     [ T(0 0.259 0) A(90 0) Rim(120 a b) ] ]
   [ Object(id(Graduations) class(SectorBoundaries) taxonomy(Study Astronomy Orbit) layer(Equipment))
     [ Spokes(n a b a*e e*(1-mode)) ] ]
   [ Object(id(Focus) class(FocusMarkers) taxonomy(Study Astronomy Focus) layer(Equipment))
     [ [ T(a*e 0.245 0) Sun ] [ T(-a*e 0.247 0) OtherFocus ] ] ]
   [ Object(id(Planet) class(OrbitingBead) taxonomy(Study Astronomy Orbit) layer(Equipment))
     [ FindPoint(a b a*e e 6.28318530718*wrap(t/period,0,1) 6.28318530718*wrap(t/period,0,1) 6 1) ] ] ] ]

Zones(n m a b f q) n ->
 [ Panels(m a b f q Zones_count n wrap(Zones_count,0,4)) ]
Panels(m a b f q j n color) m ->
 [ Pair(a b f q 6.28318530718*(j+Panels_count/m)/n
          6.28318530718*(j+(Panels_count+1)/m)/n color) ]
Pair(a b f q u v color) ->
 [ SolvePair(a b f q u v u+q*sin(u) v+q*sin(v) 6 color) ]
SolvePair(a b f q u v U V i color) -> ?(i>0)
 [ SolvePair(a b f q u v U-(U-q*sin(U)-u)/(1-q*cos(U)) V-(V-q*sin(V)-v)/(1-q*cos(V)) i-1 color) ]
 : [ Shade(f a*cos(U) b*sin(U) a*cos(V) b*sin(V) color) ]
Shade(f x z X Z color) -> ?(color<0.5)
 [ !I(Extrude(Polygon(f 0 x z X Z) 0.016 cap(all)) material(bluegreymattepaint) 1 0.25) ]
 : [ ShadeMid(f x z X Z color) ]
ShadeMid(f x z X Z color) -> ?(color<1.5)
 [ !I(Extrude(Polygon(f 0 x z X Z) 0.016 cap(all)) material(tealmatteceramic) 1 0.25) ]
 : [ ShadeWarm(f x z X Z color) ]
ShadeWarm(f x z X Z color) -> ?(color<2.5)
 [ !I(Extrude(Polygon(f 0 x z X Z) 0.016 cap(all)) material(offwhiteceramic) 1 0.25) ]
 : [ !I(Extrude(Polygon(f 0 x z X Z) 0.016 cap(all)) material(sagegreenmattepaint) 1 0.25) ]

Spokes(n a b f q) n ->
 [ FindPoint(a b f q 6.28318530718*Spokes_count/n 6.28318530718*Spokes_count/n 6 0) ]
FindPoint(a b f q u U i moving) -> ?(i>0)
 [ FindPoint(a b f q u U-(U-q*sin(U)-u)/(1-q*cos(U)) i-1 moving) ]
 : [ Point(a*cos(U) b*sin(U) f moving) ]
Point(x z f moving) -> ?(moving<0.5)
 [ !I(TaperedSweep(samples(f 0.248 0 0.006 x 0.248 z 0.006) up(0 1 0) segments(8) cap(all))
   material(charcoalmattemetal) 1 0.23) ]
 [ T(x 0.257 z) S(0.046 0.018 0.046) !I(Cylinder(segments(10 1)) material(goldbrushedmetal) 1 0.23) ]
 : [ !I(TaperedSweep(samples(f 0.321 0 0.0145 x 0.321 z 0.0145) up(0 1 0) segments(10) cap(all))
     material(goldbrushedmetal) 1 0.24) ]
   [ T(x 0.321 z)
     [ S(0.162 0.162 0.162) !I(Sphere material(silverbrushedmetal) 1 0.23) ]
     [ !I(Revolve(profile(Polygon 0.080 -0.011 0.089 -0.008 0.089 0.008 0.080 0.011)
       angle(0 360) segments(36)) material(copperpolishedmetal) 1 0.24) ] ]

Rim(n a b) n ->
 [ RimSegment(a b 6.28318530718*Rim_count/n 6.28318530718*(Rim_count+1)/n) ]
RimSegment(a b u v) ->
 [ !I(Extrude(Polygon(a*cos(u) b*sin(u) 1.021*a*cos(u) 1.021*b*sin(u)
   1.021*a*cos(v) 1.021*b*sin(v) a*cos(v) b*sin(v)) 0.038 cap(all))
   material(charcoalmattemetal) 1 0.23) ]

Sun ->
 [ S(0.297 0.066 0.297) !I(Cylinder(segments(48 1)) material(copperpolishedmetal) 1 0.25) ]
 [ T(0 0.111 0) S(0.278 0.225 0.278) !I(Sphere material(goldbrushedmetal) 1 0.23) ]
OtherFocus ->
 [ S(0.116 0.023 0.116) !I(Cylinder(segments(24 1)) material(silverbrushedmetal) 1 0.25) ]
 [ T(0 0.023 0) S(0.035 0.009 0.035) !I(Cylinder(segments(12 1)) material(charcoalmattemetal) 1 0.26) ]
Bed ->
 [ T(0 0.09 0) S(5.07 0.18 4.36) !I(Cube material(amberwarmwood) 1 0.30) ]
 [ T(0 0.200 0) S(5.00 0.058 4.29) !I(Cube material(charcoalmattemetal) 1 0.26) ]
 [ T(0 0.217 1.99) S(4.83 0.014 0.022) !I(Cube material(goldbrushedmetal) 1 0.25) ]
 [ T(0 0.217 -1.99) S(4.83 0.014 0.022) !I(Cube material(goldbrushedmetal) 1 0.25) ]
 [ T(-2.36 0.216 1.80) Screw ] [ T(2.36 0.216 1.80) Screw ]
 [ T(-2.36 0.216 -1.80) Screw ] [ T(2.36 0.216 -1.80) Screw ]
Screw ->
 [ S(0.105 0.030 0.105) !I(Cylinder(segments(16 1)) material(goldbrushedmetal) 1 0.26) ]
 [ T(0 0.030 0) S(0.063 0.006 0.012) !I(Cube material(charcoalmattemetal) 1 0.25) ]
