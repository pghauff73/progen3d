# Meridian orrery | native ProGen3D | Y up | studio model units
# Start takes the length in seconds of an Earth year. Try 12, then time 0..12.
# Display radii and ball sizes are compressed independently of orbital periods.
Start -> Instrument(24)

Instrument(year) ->
 [ Object(id(Orrery) class(AstronomicalInstrument) taxonomy(Instrument Astronomy Planetarium Orrery) layer(Equipment))
   [ Interface(id(footprint) type(Support) origin(0 0 0) normal(0 -1 0) tangent(1 0 0) region(Point) tolerance(0.001))
     [ Object(id(Pedestal) class(Stand) taxonomy(Instrument Assembly Stand) layer(Structure)) [ Stand Feet(3) ] ]
     [ Object(id(CalendarDial) class(Dial) taxonomy(Instrument Assembly Dial) layer(Equipment)) [ Dial Graduation(360) Pillars(8) ] ]
     [ Object(id(Drive) class(Clockwork) taxonomy(Instrument Assembly Clockwork) layer(Equipment)) [ Clockwork ] ]
     [ Object(id(SolarSpindle) class(Bearing) taxonomy(Instrument Assembly Bearing) layer(Equipment)) [ Spindle ] ]
     [ Object(id(Mercury) class(OrbitCarrier) taxonomy(Instrument Assembly OrbitCarrier) layer(Equipment)) [ A(30+360*t/(year*0.24085) 1) Carrier(0.87 1.99 0.41) T(0.87 2.40 0) S(0.14 0.14 0.14) !I(Sphere material(silverbluepolishedmetal) 1 0.3) ] ]
     [ Object(id(Venus) class(OrbitCarrier) taxonomy(Instrument Assembly OrbitCarrier) layer(Equipment)) [ A(119+360*t/(year*0.61520) 1) Carrier(1.25 1.86 0.43) T(1.25 2.29 0) S(0.23 0.23 0.23) !I(Sphere material(amberwarmwood) 1 0.3) ] ]
     [ Object(id(EarthMoon) class(OrbitCarrier) taxonomy(Instrument Assembly OrbitCarrier) layer(Equipment)) [ A(213+360*t/year 1) Carrier(1.72 1.73 0.47) T(1.72 2.20 0) EarthSystem(year) ] ]
     [ Object(id(Mars) class(OrbitCarrier) taxonomy(Instrument Assembly OrbitCarrier) layer(Equipment)) [ A(295+360*t/(year*1.88085) 1) Carrier(2.15 1.60 0.45) T(2.15 2.05 0) S(0.20 0.20 0.20) !I(Sphere material(redglossymetal) 1 0.3) ] ]
     [ Object(id(Jupiter) class(OrbitCarrier) taxonomy(Instrument Assembly OrbitCarrier) layer(Equipment)) [ A(61+360*t/(year*11.8626) 1) Carrier(2.66 1.47 0.53) T(2.66 2.00 0) JupiterGlobe ] ]
     [ Object(id(Saturn) class(OrbitCarrier) taxonomy(Instrument Assembly OrbitCarrier) layer(Equipment)) [ A(170+360*t/(year*29.4475) 1) Carrier(3.18 1.34 0.55) T(3.18 1.89 0) SaturnGlobe ] ]
   ] ]

# Turned pedestal, moulded foot and stepped lip, as a single radial section.
Stand ->
 [ !I(Revolve(profile(Polygon 0.035 0.12 1.13 0.12 1.20 0.16 1.22 0.23 1.19 0.28 1.02 0.30 0.93 0.34 0.52 0.37 0.41 0.44 0.39 0.57 0.46 0.62 0.68 0.65 0.69 0.70 0.035 0.70) angle(0 360) segments(80)) material(amberwarmwood) 1 0.35) ]
 [ T(0 0.19 0) Ring(2.44 0.025 0.975) ]
 [ T(0 0.54 0) Ring(0.83 0.034 0.84) ]

Feet(n) n -> [ A(Feet_count*360/n 1) T(0.92 0 0) Foot ]
Foot ->
 [ S(0.39 0.11 0.39) !I(Cylinder(segments(24 1)) material(charcoalroughmetal) 1 0.3) ]
 [ T(0 0.13 0) S(0.34 0.20 0.34) !I(Sphere(segments(24 12)) material(amberwarmwood) 1 0.3) ]

Dial ->
 [ T(0 0.70 0) S(3.88 0.10 3.88) !I(Cylinder(segments(96 1)) material(amberwarmwood) 1 0.28) ]
 [ T(0 1.04 0) S(3.93 0.085 3.93) !I(Cylinder(radial(0.77 1) topology(shell) close(all) segments(96 1)) material(warmwhitematteplaster) 1 0.28) ]
 [ T(0 1.036 0) Ring(3.97 0.092 0.982) ]
 [ T(0 1.05 0) Ring(3.05 0.080 0.979) ]

Ring(d h bore) -> [ S(d h d) !I(Cylinder(radial(bore 1) topology(shell) close(all) segments(72 1)) material(goldbrushedmetal) 1 0.35) ]
# One engraved division per degree; the 5-degree and 30-degree divisions have their own lengths.
Graduation(n) n -> [ A(Graduation_count*360/n 1) Tick(wrap(Graduation_count*360/n,0,30) wrap(Graduation_count*360/n,0,5)) ]
Tick(month sector) -> ?(month<0.01)
 [ T(1.72 1.133 0) S(0.29 0.012 0.027) !I(Cube material(redglossymetal) 1 0.3) ]
 :
 [ MinorTick(sector) ]
MinorTick(sector) -> ?(sector<0.01)
 [ T(1.781 1.133 0) S(0.184 0.012 0.019) !I(Cube material(charcoalroughmetal) 1 0.3) ]
 :
 [ T(1.824 1.133 0) S(0.098 0.012 0.012) !I(Cube material(charcoalroughmetal) 1 0.3) ]
Pillars(n) n -> [ A(Pillars_count*360/n 1) T(1.82 0.79 0) Column ]
Column ->
 [ S(0.095 0.25 0.095) !I(Cylinder(segments(14 1)) material(goldbrushedmetal) 1 0.3) ]
 [ T(0 0.015 0) Ring(0.16 0.025 0.48) ]
 [ T(0 0.22 0) Ring(0.16 0.025 0.48) ]

# Exposed illustration pair: common pitch; 32:16 teeth; equal and opposite pitch-line speeds.
Clockwork ->
 [ T(0 0.89 0) A(5*t 1) Wheel(32 0.80) ]
 [ T(1.20 0.89 0) A(11.25-10*t 1) Wheel(16 0.40) ]
 [ T(1.20 0.79 0) S(0.105 0.29 0.105) !I(Cylinder material(charcoalroughmetal) 1 0.3) ]
 [ T(1.2 0.86 0) A(11.25-10*t 1) T(0.23 0 0) S(0.50 0.035 0.07) !I(Cube material(copperpolishedmetal) 1 0.4) ]
Wheel(n r) -> [ Ring(2*r-0.06 0.071 0.77) Spokes(5 r) Teeth(n r) ]
Spokes(n r) n -> [ A(Spokes_count*360/n 1) T(0.43*r 0.034 0) S(0.86*r 0.052 0.076) !I(Cube material(goldbrushedmetal) 1 0.22) ]
Teeth(n r) n -> [ A(Teeth_count*360/n 1) T(r-0.005 0.036 0) S(0.107 0.071 0.075) !I(Cube material(goldbrushedmetal) 1 0.22) ]

Spindle ->
 [ T(0 0.78 0) S(0.19 1.76 0.19) !I(Cylinder material(charcoalroughmetal) 1 0.35) ]
 [ T(0 2.63 0) S(0.54 0.54 0.54) !I(Sphere(segments(48 24)) material(goldbrushedmetal) 1 0.35) ]
 [ T(0 2.89 0) S(0.07 0.095 0.07) !I(Sphere material(copperpolishedmetal) 1 0.4) ]

Carrier(r y rise) ->
 [ T(0 y 0) Ring(0.32 0.075 0.60) ]
 [ T(0 y+0.035 0) !I(TaperedSweep(samples(0 0 0 0.040 r*0.18 0 0 0.043 r*0.76 0 0 0.028 r 0 0 0.022 r rise-0.035 0 0.018) up(0 0 1) segments(12) cap(all)) material(goldbrushedmetal) 1 0.4) ]

EarthSystem(year) ->
 [ S(0.27 0.27 0.27) !I(Sphere(segments(32 16)) material(bluepaintmatte) 1 0.28) ]
 [ A(18 2) Ring(0.275 0.020 0.97) ]
 [ A(360*t*12/year 1) T(0 -0.06 0)
   [ T(0.14 0 0) S(0.28 0.014 0.024) !I(Cube material(copperpolishedmetal) 1 0.4) ]
   [ T(0.28 0 0) S(0.082 0.082 0.082) !I(Sphere material(warmwhitematteplaster) 1 0.3) ] ]

JupiterGlobe ->
 [ S(0.43 0.41 0.43) !I(Sphere(segments(36 18)) material(amberwarmwood) 1 0.35) ]
 [ S(0.436 0.416 0.436) !I(Sphere(polar(75 86) topology(surface) close(none) segments(40 6)) material(copperpolishedmetal) 1 0.35) ]
 [ S(0.436 0.416 0.436) !I(Sphere(polar(102 112) topology(surface) close(none) segments(40 6)) material(warmwhitematteplaster) 1 0.35) ]
SaturnGlobe ->
 [ S(0.35 0.32 0.35) !I(Sphere(segments(36 18)) material(amberwarmwood) 1 0.31) ]
 [ A(26 2) Ring(0.70 0.016 0.72) Ring(0.75 0.012 0.96) ]
