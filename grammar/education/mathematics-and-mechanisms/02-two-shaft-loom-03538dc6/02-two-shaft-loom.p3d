# Two-shaft study loom | two shafts, plain-weave swatch | Y up, front +Z
# Set the beat period in seconds in Start. Try t=0, 1, 2, 3 with period 4.
# Front cloth is shown as individual yarns at a deliberately enlarged gauge.
Start -> Loom(4)

Loom(period) ->
 [ Object(id(Loom) class(TextileMachine) taxonomy(Equipment Textile Weaving FloorLoom) layer(Equipment))
   [ Interface(id(floor) type(Support) origin(0 0 0) normal(0 -1 0) tangent(1 0 0) region(Point) tolerance(0.001))
     [ Object(id(OakFrame) class(LoomFrame) taxonomy(Textile Frame Timber) layer(Structure)) [ SideFrame(-1) SideFrame(1) Crossrails ] ]
     [ Object(id(BeamSet) class(WarpStorage) taxonomy(Textile Beam Roller) layer(Equipment)) [ Beams Flanges(2) ] ]
     [ Object(id(FrontReed) class(Beater) taxonomy(Textile Picking Reed) layer(Equipment)) [ Reed ] ]
     [ Object(id(HarnessA) class(HeddleFrame) taxonomy(Textile Shedding OddEnds) layer(Equipment)) [ Shaft(-0.60 0.29*sin(t*6.283185307/period) -1.64) ] ]
     [ Object(id(HarnessB) class(HeddleFrame) taxonomy(Textile Shedding EvenEnds) layer(Equipment)) [ Shaft(-0.38 -0.29*sin(t*6.283185307/period) -1.56) ] ]
     [ Object(id(WarpEnds) class(LongitudinalYarn) taxonomy(Textile Fabric Warp) layer(Equipment)) [ Ends(21 sin(t*6.283185307/period)) ] ]
     [ Object(id(WeftPicks) class(TransverseYarn) taxonomy(Textile Fabric Weft) layer(Equipment)) [ Picks(17) BoundEdges(16) ] ]
     [ Object(id(BoatShuttle) class(Shuttle) taxonomy(Textile Picking Shuttle) layer(Equipment)) [ T(2.24*cos(t*6.283185307/period) 1.68 -0.19) Shuttle ] ]
     [ Object(id(Treadles) class(FootControl) taxonomy(Textile Shedding Treadle) layer(Equipment)) [ Treadle(-0.34 sin(t*6.283185307/period)) Treadle(0.34 -sin(t*6.283185307/period)) ] ]
   ] ]

Oak(x y z dx dy dz) -> [ T(x y z) S(dx dy dz) !I(Cube material(amberwarmwood) 1 0.36) ]
Iron(x y z dx dy dz) -> [ T(x y z) S(dx dy dz) !I(Cube material(charcoalroughmetal) 1 0.30) ]
Pin(x y z) -> [ T(x y z) A(-90 2) S(0.115 0.07 0.115) !I(Cylinder(segments(8 1)) material(goldpolishedmetal) 1 0.22) ]
SideFrame(side) ->
 [ T(side*2.13 0 0)
   Oak(0 0.090 0 0.35 0.18 3.38)
   Oak(0 0.91 -1.33 0.22 1.64 0.22) Oak(0 0.91 1.37 0.22 1.64 0.22)
   Oak(0 1.41 -0.55 0.20 2.64 0.21) Oak(0 1.45 0 0.19 0.22 2.84)
   Oak(0 2.64 -0.39 0.32 0.14 0.72)
   [ T(0 0.79 -0.04) A(38 0) S(0.13 1.51 0.15) !I(Cube material(amberwarmwood) 1 0.36) ]
   Pin(0.10*side-0.035 1.46 1.37) Pin(0.10*side-0.035 1.46 -1.33)
   Pin(0.10*side-0.035 1.46 -0.55) Pin(0.10*side-0.035 0.31 -0.55) ]
Crossrails ->
 Oak(0 0.33 1.37 4.40 0.17 0.18) Oak(0 0.34 -1.33 4.40 0.17 0.18)
 Oak(0 2.65 -0.55 4.42 0.19 0.22)
 [ T(0 2.55 -0.54) HarnessLinks(4) ]
HarnessLinks(n) n -> [ T(-1.53+HarnessLinks_count*1.02 0 0) S(0.10 0.10 0.10) !I(Sphere material(goldpolishedmetal) 1 0.31) ]

# Cylinder is based at local y=0. Rotate to run beam axes along X.
Beams ->
 [ T(-2.22 1.48 1.37) A(-90 2) S(0.40 4.44 0.40) !I(Cylinder(segments(40 1)) material(beigebrownpinewood) 1 0.24) ]
 [ T(-2.22 1.44 -1.32) A(-90 2) S(0.48 4.44 0.48) !I(Cylinder(segments(40 1)) material(beigebrownpinewood) 1 0.24) ]
 [ T(-1.76 1.44 -1.32) A(-90 2) S(0.50 3.52 0.50) !I(Cylinder(segments(40 1)) material(beigegreywhitemattepolyester) 1 0.21) ]
Flanges(n) n ->
 [ T(-1.83+Flanges_count*3.58 1.44 -1.32) A(-90 2) S(0.68 0.075 0.68) !I(Cylinder(segments(32 1)) material(amberwarmwood) 1 0.28) ]
 [ T(-1.83+Flanges_count*3.58 1.48 1.37) A(-90 2) S(0.56 0.075 0.56) !I(Cylinder(segments(32 1)) material(amberwarmwood) 1 0.28) ]
Reed ->
 Oak(0 2.10 0.055 3.85 0.075 0.065) Oak(0 1.30 0.055 3.85 0.075 0.065)
 Iron(-1.91 1.70 0.055 0.055 0.86 0.055) Iron(1.91 1.70 0.055 0.055 0.86 0.055)
 Dents(43)
Dents(n) n -> Iron(-1.68+Dents_count*0.08 1.70 0.055 0.015 0.80 0.025)

# Each heddle has separate upper and lower straight lengths and a closed eye.
Shaft(z lift startX) ->
 [ T(0 lift z)
   Oak(0 2.19 0 3.79 0.075 0.07) Oak(0 1.16 0 3.79 0.075 0.07)
   Iron(-1.88 1.675 0 0.05 1.03 0.045) Iron(1.88 1.675 0 0.05 1.03 0.045)
   Heddles(21 startX) ]
Heddles(n startX) n ->
 [ T(startX+0.16*Heddles_count 1.68 0)
   Iron(0 0.297 0 0.011 0.438 0.014) Iron(0 -0.30 0 0.011 0.444 0.014)
   [ A(90 0) S(0.093 0.014 0.185) !I(Cylinder(radial(0.76 1) topology(shell) close(all) segments(16 1)) material(silverbluepolishedmetal) 1 0.26) ] ]

# Each pair enters opposite sheds. cos(pi*i) yields exact alternating parity.
Ends(n phase) n ->
 [ T(-1.64+Ends_count*0.16 0 0) WarpYarn(1 -0.60 phase) ]
 [ T(-1.56+Ends_count*0.16 0 0) WarpYarn(-1 -0.38 phase) ]
WarpYarn(sign zEye phase) ->
 !I(TaperedSweep(samples(
   0 1.68 -1.32 0.021
   0 1.68+sign*0.29*phase zEye 0.021
   0 1.68+sign*0.25*phase -0.19 0.021
   0 1.68 0.11 0.021
   0 1.68+sign*0.026 0.2 0.021    0 1.68-sign*0.026 0.27 0.021    0 1.68+sign*0.026 0.34 0.021
   0 1.68-sign*0.026 0.41 0.021    0 1.68+sign*0.026 0.48 0.021    0 1.68-sign*0.026 0.55 0.021
   0 1.68+sign*0.026 0.62 0.021    0 1.68-sign*0.026 0.69 0.021    0 1.68+sign*0.026 0.76 0.021
   0 1.68-sign*0.026 0.83 0.021    0 1.68+sign*0.026 0.9 0.021    0 1.68-sign*0.026 0.97 0.021
   0 1.68+sign*0.026 1.04 0.021    0 1.68-sign*0.026 1.11 0.021    0 1.68+sign*0.026 1.18 0.021
   0 1.68-sign*0.026 1.25 0.021    0 1.68+sign*0.026 1.32 0.021
   0 1.68 1.37 0.021
   0 1.633 1.499 0.021
   0 1.548 1.558 0.021
   0 1.48 1.57 0.021
 ) up(1 0 0) segments(8) cap(all)) material(beigegreywhitemattepolyester) 1 0.25)

Picks(n) n ->
 [ T(0 1.68 0.20+Picks_count*0.07) Pick(cos(Picks_count*3.141592654) wrap(Picks_count,0,3)) ]
Pick(sign band) -> ?(band<1)
 [ BluePick(sign) ]
 :
 [ RustPick(sign) ]

# Half-turn at each selvedge joins adjacent picks; colour transitions represent joined yarns.
BoundEdges(n) n ->
 [ T(0 1.68 0.20+BoundEdges_count*0.07) EdgeTurn(cos(BoundEdges_count*3.141592654)) ]
EdgeTurn(side) ->
 [ !I(TaperedSweep(samples(side*1.697 0 0 0.021
      side*1.722 0 0.010 0.021 side*1.732 0 0.035 0.021
      side*1.722 0 0.060 0.021 side*1.697 0 0.070 0.021)
      up(0 1 0) segments(8) cap(all)) material(redmattepaint) 1 0.25) ]

BluePick(sign) ->
 !I(TaperedSweep(samples(
   -1.697 0 0 0.021
   -1.64 -sign*0.026 0 0.021    -1.56 sign*0.026 0 0.021    -1.48 -sign*0.026 0 0.021
   -1.4 sign*0.026 0 0.021    -1.32 -sign*0.026 0 0.021    -1.24 sign*0.026 0 0.021
   -1.16 -sign*0.026 0 0.021    -1.08 sign*0.026 0 0.021    -1 -sign*0.026 0 0.021
   -0.92 sign*0.026 0 0.021    -0.84 -sign*0.026 0 0.021    -0.76 sign*0.026 0 0.021
   -0.68 -sign*0.026 0 0.021    -0.6 sign*0.026 0 0.021    -0.52 -sign*0.026 0 0.021
   -0.44 sign*0.026 0 0.021    -0.36 -sign*0.026 0 0.021    -0.28 sign*0.026 0 0.021
   -0.2 -sign*0.026 0 0.021    -0.12 sign*0.026 0 0.021    -0.04 -sign*0.026 0 0.021
   0.04 sign*0.026 0 0.021    0.12 -sign*0.026 0 0.021    0.2 sign*0.026 0 0.021
   0.28 -sign*0.026 0 0.021    0.36 sign*0.026 0 0.021    0.44 -sign*0.026 0 0.021
   0.52 sign*0.026 0 0.021    0.6 -sign*0.026 0 0.021    0.68 sign*0.026 0 0.021
   0.76 -sign*0.026 0 0.021    0.84 sign*0.026 0 0.021    0.92 -sign*0.026 0 0.021
   1 sign*0.026 0 0.021    1.08 -sign*0.026 0 0.021    1.16 sign*0.026 0 0.021
   1.24 -sign*0.026 0 0.021    1.32 sign*0.026 0 0.021    1.4 -sign*0.026 0 0.021
   1.48 sign*0.026 0 0.021    1.56 -sign*0.026 0 0.021    1.64 sign*0.026 0 0.021
   1.697 0 0 0.021
 ) up(0 0 1) segments(8) cap(all)) material(bluepaintmatte) 1 0.25)
RustPick(sign) ->
 !I(TaperedSweep(samples(
   -1.697 0 0 0.021
   -1.64 -sign*0.026 0 0.021    -1.56 sign*0.026 0 0.021    -1.48 -sign*0.026 0 0.021
   -1.4 sign*0.026 0 0.021    -1.32 -sign*0.026 0 0.021    -1.24 sign*0.026 0 0.021
   -1.16 -sign*0.026 0 0.021    -1.08 sign*0.026 0 0.021    -1 -sign*0.026 0 0.021
   -0.92 sign*0.026 0 0.021    -0.84 -sign*0.026 0 0.021    -0.76 sign*0.026 0 0.021
   -0.68 -sign*0.026 0 0.021    -0.6 sign*0.026 0 0.021    -0.52 -sign*0.026 0 0.021
   -0.44 sign*0.026 0 0.021    -0.36 -sign*0.026 0 0.021    -0.28 sign*0.026 0 0.021
   -0.2 -sign*0.026 0 0.021    -0.12 sign*0.026 0 0.021    -0.04 -sign*0.026 0 0.021
   0.04 sign*0.026 0 0.021    0.12 -sign*0.026 0 0.021    0.2 sign*0.026 0 0.021
   0.28 -sign*0.026 0 0.021    0.36 sign*0.026 0 0.021    0.44 -sign*0.026 0 0.021
   0.52 sign*0.026 0 0.021    0.6 -sign*0.026 0 0.021    0.68 sign*0.026 0 0.021
   0.76 -sign*0.026 0 0.021    0.84 sign*0.026 0 0.021    0.92 -sign*0.026 0 0.021
   1 sign*0.026 0 0.021    1.08 -sign*0.026 0 0.021    1.16 sign*0.026 0 0.021
   1.24 -sign*0.026 0 0.021    1.32 sign*0.026 0 0.021    1.4 -sign*0.026 0 0.021
   1.48 sign*0.026 0 0.021    1.56 -sign*0.026 0 0.021    1.64 sign*0.026 0 0.021
   1.697 0 0 0.021
 ) up(0 0 1) segments(8) cap(all)) material(redmattepaint) 1 0.25)

# Loft the boat from five hexagonal transverse sections. The bobbin is visible above the hull.
Shuttle ->
 [ A(-90 2) !I(AxialProfile(axis(y)
   profile(Tip polygon(-0.016 -0.02 0.016 -0.02 0.020 0 0.014 0.02 -0.014 0.02 -0.020 0))
   profile(Body polygon(-0.07 -0.075 0.04 -0.075 0.055 0 0.04 0.075 -0.07 0.075 -0.08 0))
   at(-0.47 Tip) linear(-0.26 Body) linear(0.17 Body) linear(0.31 Body) linear(0.47 Tip) cap(all))
   material(amberwarmwood) 1 0.25) ]
 [ T(-0.19 0.084 0) A(-90 2) S(0.084 0.38 0.084) !I(Cylinder(segments(20 1)) material(redmattepaint) 1 0.30) ]
 [ T(-0.23 0.083 0) A(-90 2) S(0.035 0.46 0.035) !I(Cylinder(segments(10 1)) material(silverbluepolishedmetal) 1 0.30) ]
Treadle(x phase) ->
 [ T(x 0.40 -0.95) A(8*phase 0) T(0 0 0.87) Oak(0 0 0 0.25 0.095 1.82)
   Iron(0 0.052 0.64 0.215 0.016 0.29) ]
