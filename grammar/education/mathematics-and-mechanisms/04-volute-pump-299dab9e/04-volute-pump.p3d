# Scroll and runner | single-stage radial pump | sectioned teaching model
# Parameters in Start: number of vanes, seconds per display revolution, exploded pose (0..1).
# Coordinates are illustrative model units. The shaft points toward +Z and the outlet toward +Y.
Start -> Pump(7 8 1)

Pump(vanes period opened) ->
 [ Object(id(Pump) class(CentrifugalPump) taxonomy(Machine FluidHandling Pump Radial) layer(Equipment))
   [ [ Object(id(Bed) class(MountingBed) taxonomy(Machine Structure Bed) layer(Structure)) [ Bed ] ]
     [ T(0 1.82 0)
       [ Object(id(Scroll) class(VoluteCasing) taxonomy(Machine Stationary Collector) layer(Equipment)) [ ScrollWall TongueWall BackPlate Discharge CaseLugs(12) ] ]
       [ Object(id(Bearings) class(BearingHousing) taxonomy(Machine Transmission Bearing) layer(Equipment)) [ BearingHousing SealStack ] ]
       [ Object(id(Impeller) class(RadialRunner) taxonomy(Machine Rotating Impeller) layer(Equipment))
         [ A(360*t/period 2) RearShroud Hub Vanes(vanes) ] ]
       [ T(-3.30*opened 0 0.36+0.64*opened)
         Object(id(Cover) class(SuctionCover) taxonomy(Machine Stationary SuctionCover) layer(Equipment))
         [ FacePlate InletNeck InletFlange CoverRibs(7) CoverLugs(12) ] ]
     ]
   ] ]

