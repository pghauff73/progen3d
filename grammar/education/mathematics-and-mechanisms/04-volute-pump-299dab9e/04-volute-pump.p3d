 [ T(-0.316 0.280 0.422) S(0.035 0.035 0.016) !I(Sphere material(silverbrushedmetal) 1 0.25) ]
 [ T(0.316 0.280 0.422) S(0.035 0.035 0.016) !I(Sphere material(silverbrushedmetal) 1 0.25) ]
PlateLine(n) n -> [ T(-0.21 0.26+PlateLine_count*0.024 0.424) S(0.34-PlateLine_count*0.04 0.007 0.008) !I(Cube material(charcoalmattemetal) 1 0.25) ]
CasingFoot(side) ->
 [ T(side*0.68 0.26 -0.56) !I(Extrude(Polygon(-0.16 0 0.16 0 0.15 0.19 0.09 0.50 -0.09 0.50 -0.15 0.19) 0.37 cap(all)) material(bluepaintmatte) 1 0.30) ]
Anchors(side) ->
 [ T(side*1.068 0.182 -1.48) Anchor ]
 [ T(side*1.068 0.182 0.318) Anchor ]
Anchor ->
 [ S(0.209 0.024 0.209) !I(Cylinder(segments(20 1)) material(silverbrushedmetal) 1 0.25) ]
 [ T(0 0.024 0) HexNut(0.158 0.072) ]
 [ T(0 0.095 0) S(0.079 0.033 0.079) !I(Cylinder(segments(16 1)) material(charcoalroughmetal) 1 0.25) ]
HexNut(d h) -> [ S(d h d) !I(Cylinder(segments(6 1)) material(silverbrushedmetal) 1 0.26) ]

# Twelve matching lug centres follow the scroll. Casing seats and cover hardware share the same radius law.
CaseLugs(n) n -> [ CaseLugAt(42+CaseLugs_count*288/(n-1)) ]
CaseLugAt(a) ->
 [ A(a 2) T(1.245+0.55*(a/360-sin(radians(a))/6.283185307) 0 -0.12)
   A(90 0) S(0.235 0.48 0.235)
   !I(Cylinder(radial(0.37 1) topology(shell) close(all) segments(24 1)) material(bluepaintmatte) 1 0.27) ]
CoverLugs(n) n -> [ CoverLugAt(42+CoverLugs_count*288/(n-1)) ]
CoverLugAt(a) ->
 [ A(a 2) T(1.245+0.55*(a/360-sin(radians(a))/6.283185307) 0 0) A(90 0)
   [ S(0.235 0.076 0.235) !I(Cylinder(radial(0.37 1) topology(shell) close(all) segments(24 1)) material(bluepaintmatte) 1 0.27) ]
   [ T(0 0.076 0) S(0.160 0.017 0.160) !I(Cylinder(radial(0.52 1) topology(shell) close(all) segments(20 1)) material(silverbrushedmetal) 1 0.27) ]
   [ T(0 0.093 0) HexNut(0.141 0.058) ]
   [ T(0 -0.120 0) S(0.078 0.220 0.078) !I(Cylinder(segments(16 1)) material(charcoalroughmetal) 1 0.25) ]
 ]
SealStack ->
 [ T(0 0 -0.295) A(90 0) S(0.57 0.095 0.57)
   !I(Cylinder(radial(0.53 1) topology(shell) close(all) segments(48 1)) material(charcoalroughmetal) 1 0.24) ]
 [ T(0 0 -0.205) A(90 0) S(0.51 0.03 0.51)
   !I(Cylinder(radial(0.59 1) topology(shell) close(all) segments(48 1)) material(silverbrushedmetal) 1 0.24) ]
