# Motion simulator rig | platform pitch, roll and yaw | ProGen3D desktop
# Four five-second studies: pitch, roll, yaw, then all three together.
# Period is the duration of ONE study. Nominal maximum angles are in degrees.
# The final study uses its own smaller angles to stay within the linkage workspace.
# Pitch and roll follow the upper frame's neutral local X and Z. Yaw turns about
# world Y. The base is fixed and the deck centre stays at the neutral lift height.
# Dimensions, joint limits and pose ranges are illustrative; the source is one photograph.
Start -> Demo(5 11 11 23)

Demo(period pitchMax rollMax yawMax) ->
    Motion(4*cycle(t,4*period) sin(radians(360*cycle(t,period))) pitchMax rollMax yawMax)
Motion(ch wave pitchMax rollMax yawMax) ->
    Select(ch wave*abs(wave) pitchMax rollMax yawMax)
Select(ch w p r y) -> ?(ch<1) Attitude(p*w 0 0) : Later(ch w r y)
Later(ch w r y) -> ?(ch<2) Attitude(0 r*w 0) : Last(ch w y)
Last(ch w y) -> ?(ch<3) Attitude(0 0 y*w) : Attitude(6*w -6*w 15*w)

Attitude(p r y) ->
    Bench
    Platform(p r y 0.9+sqrt(4.65*4.65-1.66*1.66-0.02*0.02))
Platform(p r y h) ->
    [ T(0 h 0) A(42+y 1) A(p 0) A(r 2) UpperFrame ]
    [ A(120 1) FieldBox ]
    Bays(p r y h)
Bays(p r y h) 3 ->
    [ A(Bays_count*120 1) Bay(Bays_count*120 p r y h) ]
Bay(bay p r y h) ->
    BaseSide Harness
    [ T(0 h 0) A(42+y-bay 1) A(p 0) A(r 2) A(bay-42 1)
      [ T(0 0.15 1.92) S(1.04 0.095 0.33) BlackBox ]
      [ T(-0.34 0 1.92) UpperJoint ]
      [ T(0.34 0 1.92) UpperJoint ] ]
    Basis(bay h cos(radians(42+y-bay)) sin(radians(42+y-bay)) cos(radians(bay-42)) sin(radians(bay-42)) cos(radians(p)) sin(radians(p)) cos(radians(r)) sin(radians(r)))
# The matrix maps a neutral deck lug to its new position in the drive's bay coordinates.
Basis(bay h cu su cv sv cp sp cr sr) ->
    Coeffs(bay h cv*cu*cr+cv*sr*sp*su-sv*cp*su -cu*sr+sp*cr*su cv*cp*su+sv*(cu*cr+sr*sp*su) cv*sr*cp+sv*sp cp*cr -cv*sp+sv*sr*cp -cu*sv*cp+cv*(cu*sr*sp-cr*su) cu*sp*cr+sr*su cu*cv*cp+sv*(cu*sr*sp-cr*su))
Coeffs(bay h xx xy xz yx yy yz zx zy zz) ->
    Leg(-1 -0.34*xx+1.92*xz h-0.34*yx+1.92*yz -0.34*zx+1.92*zz)
    Leg(1 0.34*xx+1.92*xz h+0.34*yx+1.92*yz 0.34*zx+1.92*zz)
    ?(bay==120) ServiceCable(h xx xy xz yx yy yz zx zy zz) : NoCable
NoCable -> T(0 0 0)

# With v the upper lug relative to its output shaft, the rod constraint is
# vy*sin(theta)-vz*cos(theta) = (dot(v,v)+arm^2-rod^2)/(2*arm).
# Solve on the continuous branch through the horizontal neutral crank.
Leg(side ux uy uz) ->
    [ T(side*2.38 0 0) DriveMount Gearmotor ]
    [ T(side*2.38 0.90 2.57) A(side*90 2) Shaft ]
    Offset(side ux uy uz ux-side*2 uy-0.9 uz-2.57)
Offset(side ux uy uz vx vy vz) ->
    Newton(5 0 side ux uy uz vy vz 1*(vx*vx+vy*vy+vz*vz+0.63*0.63-4.65*4.65)/1.26)
Newton(n a side ux uy uz vy vz k) ->
    ?(n>0) Newton(n-1 a-(vy*sin(a)-vz*cos(a)-k)/(vy*cos(a)+vz*sin(a)) side ux uy uz vy vz k)
    : AssembleLeg(side ux uy uz a 0.9+0.63*sin(a) 2.57-0.63*cos(a))
AssembleLeg(side ux uy uz a py pz) ->
    [ T(side*2 0.9 2.57) A(degrees(a) 0) Crank(0.63) ]
    Tie(side*2 py pz ux uy uz)
    [ T(side*2 py pz) LowerJoint ]

Bench ->
    [ T(0 -0.19 -0.14) S(11.52 0.19 10.72) I(Cube material(lightoakwood) 1 0.35) ]

# A truncated triangle made from three long outer rails, three corner returns
# and inner runners. Crossmembers bridge the two rails under each drive.
BaseSide ->
    [ T(0 0 2.85) S(7.18 0.22 0.19) BlackBox ]
    [ T(0 0 2.27) S(6.36 0.22 0.16) BlackBox ]
    [ T(3.89545 0 2.25171) A(60 1) S(1.45 0.22 0.19) BlackBox ]
    [ T(3.3687 0 1.9449) A(60 1) S(0.86 0.22 0.16) BlackBox ]
    [ T(0 0 2.56) S(0.16 0.20 0.55) BlackBox ]
    [ T(3.28 0.20 2.62) A(90 0) I(Extrude(Polygon(-0.35 -0.15 0.35 -0.15 0.35 0.42) 0.035 cap(all)) material(charcoalroughmetal) 1 0.5) ]

DriveMount ->
    [ T(0 0 2.57) S(0.92 0.18 0.76) BlackBox ]
    [ T(0 0.20 2.72) S(0.93 0.085 1.12) BlackBox ]
    [ T(-0.335 0.285 2.77) S(0.14 0.09 0.84) CastBox ]
    [ T(0.335 0.285 2.77) S(0.14 0.09 0.84) CastBox ]
    FootFasteners
FootFasteners 4 ->
    [ T(0.362*cos(radians(45+FootFasteners_count*90))/0.707107 0.369 2.75+0.35*sin(radians(45+FootFasteners_count*90))/0.707107)
      S(0.09 0.035 0.09) Hex ]

# Cast reducer, ribbed motor barrel, end bell, cooling grille and terminal box.
Gearmotor ->
    [ T(0 0.37 2.60) S(0.67 0.81 0.79) CastBox ]
    [ T(0 0.55 2.60) S(0.72 0.48 0.68) CastBox ]
    [ T(0 1.16 2.61) S(0.62 0.065 0.72) CastBox ]
    [ T(0 0.43 2.19) S(0.58 0.65 0.10) SteelBox ]
    [ T(-0.26 0.52 2.124) CoverBolt ]
    [ T(0.26 0.52 2.124) CoverBolt ]
    [ T(-0.26 1.00 2.124) CoverBolt ]
    [ T(0.26 1.00 2.124) CoverBolt ]
    [ T(0 0.77 2.95) A(90 0) MotorBarrel ]
    [ T(0 1.005 3.41) S(0.44 0.245 0.53) CastBox ]
    [ T(0 1.24 3.41) S(0.48 0.052 0.57) CastBox ]
    [ T(0.14 1.135 3.16) A(-90 0) S(0.11 0.14 0.11) DarkCylinder ]
CoverBolt -> [ A(-90 0) S(0.085 0.037 0.085) Hex ]
Shaft -> [ S(0.25 0.43 0.25) BrightCylinder ]

# Local +Y is the motor shaft. The air passages are actual gaps between fins.
MotorBarrel ->
    [ S(0.70 0.11 0.70) SteelCylinder ]
    [ T(0 0.10 0) S(0.60 0.77 0.60) CastCylinder ]
    CoolingFins
    [ T(0.333 0.25 0) S(0.019 0.40 0.19) BlackBox ]
    NameplateLines
    [ T(0 0.82 0) S(0.68 0.045 0.68) DarkCylinder ]
    [ T(0 0.86 0) S(0.70 0.30 0.70) CastCylinder ]
    [ T(0 1.15 0) S(0.63 0.07 0.63) CastCylinder ]
    [ T(0 1.214 0) S(0.43 0.012 0.43) DarkCylinder ]
    GrilleSlats
    [ T(0 1.235 0) S(0.13 0.02 0.13) SteelCylinder ]
CoolingFins 16 ->
    [ A(CoolingFins_count*22.5 1) T(0 0.135 0.300) S(0.027 0.66 0.077) SteelBox ]
NameplateLines 3 ->
    [ T(0.345 0.30 0.047*(NameplateLines_count-1)) S(0.006 0.28 0.009) CastBox ]
GrilleSlats 7 ->
    [ T(0 1.228 (GrilleSlats_count-3)*0.051)
      S(2*sqrt(0.22*0.22-((GrilleSlats_count-3)*0.051)*((GrilleSlats_count-3)*0.051)) 0.012 0.019) CastBox ]

# The crank rotates about X. Its free end and Tie's first endpoint coincide.
Crank(arm) ->
    [ T(0 -0.078 -arm/2) S(0.126 0.156 arm) BlackBox ]
    [ A(90 2) T(0 -0.09 0) S(0.28 0.18 0.28) DarkCylinder ]
    [ T(0 0 -arm) A(90 2) T(0 -0.09 0) S(0.21 0.18 0.21) SteelCylinder ]
UpperJoint ->
    [ T(0 0.035 0) S(0.30 0.135 0.32) BlackBox ]
    [ T(-0.107 -0.08 0) S(0.054 0.22 0.18) SteelBox ]
    [ T(0.107 -0.08 0) S(0.054 0.22 0.18) SteelBox ]
    [ T(-0.165 0 0) A(-90 2) S(0.115 0.33 0.115) BrightCylinder ]
    Bearing
LowerJoint -> Bearing
Bearing -> [ S(0.19 0.176 0.19) I(Sphere(segments(16 10)) material(ambermetalpolished) 1 0.5) ]

# Fractions measure distance along the same endpoint line, keeping the rod and
# its exposed silver shanks and brass locknuts collinear at every time sample.
Tie(ax ay az bx by bz) -> RodParts(ax ay az bx by bz bx-ax by-ay bz-az)
RodParts(ax ay az bx by bz dx dy dz) ->
    I(SweepDisk(path(ax ay az bx by bz) radius(0.038) segments(12) cap(all)) material(silverbluepolishedmetal) 1 0.5)
    I(SweepDisk(path(ax+0.05*dx ay+0.05*dy az+0.05*dz bx-0.05*dx by-0.05*dy bz-0.05*dz) radius(0.065) segments(16) cap(all)) material(charcoalroughmetal) 1 0.5)
    I(SweepDisk(path(ax+0.038*dx ay+0.038*dy az+0.038*dz ax+0.058*dx ay+0.058*dy az+0.058*dz) radius(0.074) segments(6) cap(all)) material(ambermetalpolished) 1 0.5)
    I(SweepDisk(path(bx-0.038*dx by-0.038*dy bz-0.038*dz bx-0.058*dx by-0.058*dy bz-0.058*dz) radius(0.074) segments(6) cap(all)) material(ambermetalpolished) 1 0.5)

# The rectangular deck is clocked 42 degrees relative to the front pair of drives.
# Short crossmembers pick up the lug plates between the outer and inner rails.
UpperFrame ->
    [ T(0 0.17 1.92) S(5.04 0.25 0.20) BlackBox ]
    [ T(0 0.17 -1.92) S(5.04 0.25 0.20) BlackBox ]
    [ T(-2.42 0.17 0) S(0.20 0.25 3.66) BlackBox ]
    [ T(2.42 0.17 0) S(0.20 0.25 3.66) BlackBox ]
    [ T(-0.71 0.19 0) S(0.15 0.18 3.70) BlackBox ]
    [ T(0.71 0.19 0) S(0.15 0.18 3.70) BlackBox ]
    [ T(-1.55 0.17 0.64) A(-37 1) S(0.15 0.18 2.86) BlackBox ]
    [ T(1.55 0.17 0.64) A(37 1) S(0.15 0.18 2.86) BlackBox ]
    [ T(-1.56 0.20 1.43) S(1.74 0.15 0.19) BlackBox ]
    [ T(1.56 0.20 0.40) S(1.74 0.15 0.19) BlackBox ]
    [ T(0 0.22 2.027) FrontPlate ]
    RingTable
    [ S(1.19 1.17 1.19) SuspendedDrive ]

RingTable ->
    [ T(0 0.366 0) S(2.27 0.07 2.12) BlackBox ]
    [ T(0 0.433 0) S(2.02 0.07 2.02) SteelCylinder ]
    [ T(0 0.498 0) S(1.91 0.07 1.91) DarkCylinder ]
    [ T(0 0.56 0) S(1.97 0.143 1.97)
      I(Cylinder(segments(96) radial(0.65 1) topology(shell) close(all)) material(steelshinyroughmetal) 1 0.5) ]
    RingTeeth(64)
    [ T(0 0.695 0) S(1.98 0.028 1.98)
      I(Cylinder(segments(96) radial(0.66 1) topology(shell) close(all)) material(silverbluepolishedmetal) 1 0.5) ]
    RingScrews
    [ T(0 0.57 0) S(0.71 0.085 0.71) SteelCylinder ]
    [ T(0 0.65 0) S(0.43 0.045 0.40) CastBox ]
    [ T(0 0.69 0) A(-15 1) Vane ]
RingTeeth(n) n ->
    [ A(360*RingTeeth_count/n 1) T(0 0.566 0.986) S(0.051 0.131 0.065) SteelBox ]
RingScrews 8 ->
    [ A(45*RingScrews_count 1) T(0 0.721 0.81) S(0.055 0.013 0.055) Hex ]
Vane ->
    [ I(Extrude(Polygon(-0.20 0 0.18 0 0.035 0.63 -0.20 0.86) 0.014 cap(all)) material(warmwhitematteplaster) 1 0.5) ]
    [ T(0.16 0 0) A(58 1) I(Extrude(Polygon(0 0 0.16 0.49 -0.035 0.74) 0.013 cap(all)) material(offwhiteceramic) 1 0.5) ]

SuspendedDrive ->
    [ T(0 -0.07 0.02) S(1.39 0.28 0.96) CastBox ]
    [ T(0 -0.59 0.04) S(1.13 0.54 0.83) CastBox ]
    [ T(0 -0.57 0.49) S(1.04 0.45 0.045) SteelBox ]
    FaceBolts
    I(SweepDisk(path(-0.48 -0.37 0.24 -0.54 -0.50 0.31 -0.50 -0.74 0.32 -0.38 -0.82 0.36 -0.08 -0.83 0.36 0.18 -0.78 0.34 0.34 -0.69 0.27 0.39 -0.54 0.25) radius(0.023) segments(8) cap(all)) material(softyellowglossyplastic) 1 0.5)
    [ T(0 -0.585 0.04) A(180 0) MotorBarrel ]
    [ T(-0.44 -0.47 0) S(0.32 0.37 0.47) CastBox ]
    [ T(-0.61 -0.34 0.04) A(90 2) S(0.22 0.11 0.22) I(Cylinder(segments(24)) material(terracottaroughceramic) 1 0.5) ]
FaceBolts 4 ->
    [ T(0.435*cos(radians(45+90*FaceBolts_count))/0.707107 -0.35+0.15*sin(radians(45+90*FaceBolts_count))/0.707107 0.535)
      A(90 0) S(0.068 0.027 0.068) Hex ]

FieldBox ->
    [ T(0.66 0.20 2.53) S(0.86 0.49 0.58) IvoryBox ]
    [ T(0.66 0.68 2.53) S(0.90 0.057 0.62) IvoryBox ]
    [ T(0.44 0.73 2.53) S(0.15 0.10 0.15) DarkCylinder ]
    [ T(0.87 0.73 2.53) S(0.15 0.10 0.15) DarkCylinder ]

# Two sheaths in the foreground loop, plus one black hanging service cable.
Harness ->
    [ T(0.14 0 0) I(SweepDisk(path(-2.38 1.14 3.07 -2.23 1.19 3.00 -2.00 1.15 3.07 -1.63 0.95 3.27 -1.15 0.69 3.48 -0.55 0.52 3.62 0 0.48 3.66 0.55 0.53 3.62 1.10 0.65 3.47 1.64 0.89 3.26 2.03 1.13 3.05 2.26 1.20 3.01 2.38 1.14 3.07) radius(0.036) segments(8) cap(all)) material(charcoalroughrubber) 1 0.5) ]
    [ T(0.14 0.023 0.038) I(SweepDisk(path(-2.38 1.14 3.07 -2.23 1.19 3.00 -2.00 1.15 3.07 -1.63 0.95 3.27 -1.15 0.69 3.48 -0.55 0.52 3.62 0 0.48 3.66 0.55 0.53 3.62 1.10 0.65 3.47 1.64 0.89 3.26 2.03 1.13 3.05 2.26 1.20 3.01 2.38 1.14 3.07) radius(0.017) segments(8) cap(all)) material(softyellowglossyplastic) 1 0.5) ]
# The flexible hanging cable follows three control points. At the fixed end the
# deck influence is zero. The uppermost control point is fully deck-attached.
ServiceCable(h xx xy xz yx yy yz zx zy zz) ->
    CablePath(-0.4897-0.1003*xx-0.0986*h*xy+0.1088*xz 0.5186*h-0.1003*yx-0.0986*h*yy+0.1088*yz 0.5312-0.1003*zx-0.0986*h*zy+0.1088*zz -0.0972-0.4428*xx-0.738*xy+0.2952*xz h-0.162-0.4428*yx-0.738*yy+0.2952*yz 0.0648-0.4428*zx-0.738*zy+0.2952*zz -0.5*xx-0.39*xy+0.15*xz h-0.5*yx-0.39*yy+0.15*yz -0.5*zx-0.39*zy+0.15*zz)
CablePath(xa ya za xb yb zb xc yc zc) ->
    I(SweepDisk(path(0.44 0.83 2.53 0.44 0.99 2.55 0.29 1.10 2.54 0.02 1.04 2.44 -0.33 0.74 2.17 -0.59 0.41 1.77 -0.68 0.26 1.40 -0.70 0.33 1.05 -0.66 0.86 0.86 xa ya za xb yb zb xc yc zc) radius(0.031) segments(10) cap(all)) material(charcoalroughrubber) 1 0.5)

# Enamel orientation plate. Letters are strokes so they travel with the deck.
FrontPlate ->
    [ S(0.68 0.145 0.014) IvoryBox ]
    [ T(-0.228 0.030 0.009) GlyphF ]
    [ T(-0.128 0.030 0.009) GlyphR ]
    [ T(-0.019 0.030 0.009) GlyphO ]
    [ T(0.093 0.030 0.009) GlyphN ]
    [ T(0.189 0.030 0.009) GlyphT ]
GlyphF ->
    Stroke(0 0 0 0.090) Stroke(0 0.090 0.063 0.090) Stroke(0 0.049 0.051 0.049)
GlyphR ->
    Stroke(0 0 0 0.09) Stroke(0 0.09 0.055 0.09) Stroke(0.055 0.09 0.055 0.048) Stroke(0 0.048 0.055 0.048) Stroke(0.029 0.048 0.070 0)
GlyphO ->
    Stroke(0 0 0 0.09) Stroke(0 0.09 0.063 0.09) Stroke(0.063 0.09 0.063 0) Stroke(0.063 0 0 0)
GlyphN ->
    Stroke(0 0 0 0.09) Stroke(0 0.09 0.064 0) Stroke(0.064 0 0.064 0.09)
GlyphT -> Stroke(0 0.09 0.073 0.09) Stroke(0.036 0.09 0.036 0)
Stroke(x y u v) -> I(SweepDisk(path(x y 0 u v 0) radius(0.0065) segments(6) cap(all)) material(charcoalroughmetal) 1 0.5)

BlackBox -> I(Cube material(charcoalroughmetal) 1 0.5)
SteelBox -> I(Cube material(steelshinyroughmetal) 1 0.5)
CastBox -> I(Cube material(lightgreyroughmetal) 1 0.5)
IvoryBox -> I(Cube material(warmwhitematteplaster) 1 0.5)
Hex -> I(Cylinder(segments(6)) material(silverbluepolishedmetal) 1 0.5)
DarkCylinder -> I(Cylinder(segments(32)) material(charcoalroughmetal) 1 0.5)
SteelCylinder -> I(Cylinder(segments(48)) material(steelshinyroughmetal) 1 0.5)
BrightCylinder -> I(Cylinder(segments(32)) material(silverbluepolishedmetal) 1 0.5)
CastCylinder -> I(Cylinder(segments(48)) material(lightgreyroughmetal) 1 0.5)
