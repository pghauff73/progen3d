# Each shoot forks into two shorter shoots. Each leaf attaches at its own shoot station.
# The spine bends down quadratically, and a small out-of-plane bend gives it depth.
Spray(d l) ->
 [ Shoot(l) Leaves(6 l) ]
 [ NextFork(d l) ]
NextFork(d l) -> ?(d>0.5)
 [ T(l*0.69 0-l*0.164634 l*0.06684) R TurnA(27 68) A(TurnA 1) Spray(d-1 l*0.67) ]
 [ T(l 0-l*0.43 0) R TurnB(-65 -25) A(TurnB 1) Spray(d-1 l*0.76) ]
 : [ ]
Shoot(l) ->
 [ !I(TaperedSweep(samples(0 0 0 l*0.034
      l*0.24 l*0.0110 l*0.0548 l*0.026
      l*0.48 0-l*0.0516 l*0.0798 l*0.021
      l*0.69 0-l*0.164634 l*0.06684 l*0.016
      l*0.84 0-l*0.2771 l*0.0385 l*0.011
      l 0-l*0.43 0 l*0.0065) up(0 0 1) segments(7) cap(all)) material(amberbrowncedarwood) 1 0.3) ]
Leaves(n l) n ->
 [ LeafStation((Leaves_count+0.65)/(n+0.2) Leaves_count l) ]
LeafStation(u i l) ->
 [ T(l*u l*(0.2*u-0.63*u*u) l*0.08*sin(3.141593*u))
   R Yaw(-46 46) R Tilt(-16 16) R Len(0.62 1.15) R Tw(-26 26)
   A(i*158+Yaw 1) A(147+Tilt 2) LeafTone(i l*Len Tw) ]
LeafTone(i h twist) -> ?(wrap(i,0,3)<0.5)
 [ !I(LeafBlade(profile(Lanceolate) length(h) width(0.184*h) curvature(h*0.105) camber(h*0.017) twist(twist) widthPower(0.58) segments(8 3)) material(sagegreenmattepaint) 1 0.18) ]
 : [ !I(LeafBlade(profile(Lanceolate) length(h) width(0.156*h) curvature(h*0.144) camber(h*0.019) twist(twist) widthPower(0.62) segments(8 3)) material(olivegreenmattepaint) 1 0.18) ]


