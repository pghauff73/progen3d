    [ A(-speed*driveTeeth/followerTeeth*t+180/followerTeeth 2)
    R15914dc5ab4f202a1a85_LavenderWheel(followerTeeth followerTeeth*module/2) ] ]
  [ T(-followerTeeth*module/2 2.35-driveTeeth*module 0)
    Object(id(R15914dc5ab4f202a1a85_LowerDrive) class(Gear) taxonomy(Mechanical Transmission SpurGear))
    [ A(-speed*t+180/driveTeeth 2) R15914dc5ab4f202a1a85_MintWheel(driveTeeth driveTeeth*module/2) ] ]
  [ T(driveTeeth*module/2 2.35-driveTeeth*module 0)
