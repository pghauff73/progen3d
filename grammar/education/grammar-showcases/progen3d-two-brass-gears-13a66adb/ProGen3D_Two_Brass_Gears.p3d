# Run It Again / Two Brass Gears. Native ProGen3D. Y up; front is +Z. Approximate metres.
# Workshop(inputRPM setting). setting=1 includes the veranda, chair, oil can and hand tools.
# setting=0 isolates the gearbox and plinth. Set RPM to 0 to freeze, or negative to reverse.
# At 10 RPM one input turn takes 6 s. Hold time t at 0 for the pictured starting pose.
# This is a prescribed no-load animation. No torque, friction, or contact solver is used.
# 40T and 20T are chosen from the song. Dimensions and hidden parts are inferred.
# Preview camera (0.13, 0.318, 0.96); target (0.019, 0.193, 0); horizontal FOV 50 degrees.
Start -> Workshop(10 1)

Workshop(rpm setting) ->
 [ Object(id(WorkshopJig) class(HandCrankedGearStudy) taxonomy(Workshop HandDrive Demonstrator) layer(Equipment)) [
 [ Object(id(Base) class(LaminatedPlinth) taxonomy(Workshop HandDrive LaminatedPlinth) layer(Structure)) [ BaseAssembly ] ]
 [ Object(id(Backboard) class(PlywoodBearingPanel) taxonomy(Workshop HandDrive PlywoodBearingPanel) layer(Structure)) [ Backer ] ]
 [ Object(id(Bearings) class(FlangedPlainBearings) taxonomy(Workshop HandDrive FlangedPlainBearings) layer(Equipment)) [ FixedHardware ] ]
 [ Object(id(PanelScrews) class(SlottedFasteners) taxonomy(Workshop HandDrive SlottedFasteners) layer(Equipment)) [ PanelScrews ] ]
 DriveTrain(6*rpm*t)
 [ Object(id(WorkshopSetting) class(VerandaWorkbench) taxonomy(Workshop HandDrive VerandaWorkbench) layer(Furniture)) [ Setting(setting) ] ]
 ] ]

DriveTrain(phi) ->
 [ Object(id(Driver) class(FortyToothGear) taxonomy(Workshop HandDrive FortyToothGear) layer(Equipment)) [ T(-0.078 0.238 0) A(phi-7 2) DriverSectors(40) DriverFace ] ]
 [ Object(id(InputShaft) class(SteelInputShaft) taxonomy(Workshop HandDrive SteelInputShaft) layer(Equipment)) [ T(-0.078 0.238 0) A(phi-7 2) ShaftA ] ]
 [ Object(id(Crank) class(HandCrank) taxonomy(Workshop HandDrive HandCrank) layer(Equipment)) [ T(-0.078 0.238 0) A(phi-7-128 2) CrankArm ] ]
 [ Object(id(Grip) class(TurnedWoodGrip) taxonomy(Workshop HandDrive TurnedWoodGrip) layer(Equipment)) [ T(-0.078 0.238 0) A(phi-7-128 2) T(0.144 0 0) A(135-phi 2) HandGrip ] ]
 [ Object(id(Pinion) class(TwentyToothGear) taxonomy(Workshop HandDrive TwentyToothGear) layer(Equipment)) [ T(0.18998746 0.20509528 0) A(2-2*phi 2) PinionSectors(20) PinionFace ] ]
 [ Object(id(OutputShaft) class(SteelOutputShaft) taxonomy(Workshop HandDrive SteelOutputShaft) layer(Equipment)) [ T(0.18998746 0.20509528 0) A(2-2*phi 2) ShaftB ] ]

# Axles lie along Z. Their centre line falls 7 degrees. Pitch radii are 0.180 and 0.090.
# The extra 9 degrees on the pinion put a space opposite the driver tooth at the pitch point.
# Involute flanks, 20 degree pressure angle, 9 mm module. Addendum m, dedendum 1.25m.
# Each closed sector runs from the shaft bore to a single tooth tip. Identical sectors
# rotate around the bore at 360/N. Tooth thickness has 0.30 mm total circular backlash.
# Flanks below the base circle use a short radial root relief.
DriverSectors(n) n -> [ A(DriverSectors_count*360/n 2) DriverSector ]
PinionSectors(n) n -> [ A(PinionSectors_count*360/n 2) PinionSector ]

